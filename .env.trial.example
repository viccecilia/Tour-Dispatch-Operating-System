WX_DISPATCH_ENV=trial
WX_DISPATCH_HOST=0.0.0.0
WX_DISPATCH_PORT=18765
WX_DISPATCH_API_HOST=0.0.0.0
WX_DISPATCH_API_PORT=18765
WX_DISPATCH_BASE_URL=https://api.example.com
WX_DISPATCH_DB=runtime/trial/wx_dispatch_trial.sqlite3
WX_DISPATCH_DEMO_MODE=false
WX_DISPATCH_TRIAL_MODE=true
WX_DISPATCH_RESET_DEMO_ON_START=false
WX_DISPATCH_LOG_LEVEL=INFO
WX_DISPATCH_LOG_DIR=runtime/logs/trial
WX_DISPATCH_BACKUP_DIR=runtime/backups/trial
WX_DISPATCH_JWT_SECRET=replace-with-at-least-32-random-characters
WX_DISPATCH_ADMIN_USERNAME=admin
WX_DISPATCH_ADMIN_PASSWORD=replace-with-a-strong-unique-password
WX_DISPATCH_ADMIN_DISPLAY_NAME=系统管理员
WX_DISPATCH_SUPER_WECHAT_IDS=zongzou
WX_DISPATCH_FLIGHT_PROVIDER=official_web
WX_DISPATCH_FLIGHT_API_KEY=
VITE_API_BASE_URL=https://api.example.com
AUTH_MODE=supabase_dual
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PROJECT_ID=your-project-ref
SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-key
# Backend only. Set this directly on the Trial server; never commit the real value.
SUPABASE_SERVICE_ROLE_KEY=replace-on-trial-server-only
# Keeps the visible platform login as "admin" while Supabase uses an internal identity.
SUPABASE_PLATFORM_ADMIN_EMAIL=admin@trial.tourflow.invalid
SUPABASE_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json
