.custom-tabbar {
  position: fixed;
  left: 28rpx;
  right: 28rpx;
  bottom: 16rpx;
  z-index: 999;
  height: 96rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx;
  border: 1rpx solid #d8e5f2;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.98);
  box-shadow: 0 18rpx 40rpx rgba(30, 54, 92, 0.12);
}

.tab-item {
  min-width: 0;
  height: 70rpx;
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 18rpx;
  color: #61748b;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 1;
}

.tab-item.active {
  color: #0f766e;
  background: #e9fbf8;
  box-shadow: none;
}

.custom-tabbar.driver-theme .tab-item.active {
  color: #0f766e;
  background: #e9fbf8;
  box-shadow: none;
}

.tab-label {
  font-size: 22rpx;
  font-weight: 850;
  line-height: 1;
}
