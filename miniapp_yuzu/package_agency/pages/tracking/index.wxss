@import "../../../app.wxss";

.guide-hero {
  color: #fff;
  background: linear-gradient(135deg, #12384f 0%, #0f7f73 100%);
  box-shadow: 0 20rpx 42rpx rgba(16, 35, 63, 0.13);
}

.guide-hero .hero-meta {
  color: #fff;
  opacity: 1;
}

.map-wrap {
  position: relative;
  margin-top: 18rpx;
  border-radius: 18rpx;
  overflow: hidden;
  background: #f0efec;
}

.map {
  width: 100%;
  height: 420rpx;
}

.map-empty {
  position: absolute;
  left: 20rpx;
  right: 20rpx;
  bottom: 20rpx;
  border-radius: 16rpx;
  padding: 14rpx 16rpx;
  background: rgba(255, 255, 255, 0.92);
  color: var(--c-muted);
  font-size: 22rpx;
  font-weight: 850;
}

.tracking-search {
  height: 72rpx;
  min-height: 72rpx;
  padding: 0 20rpx;
  line-height: 72rpx;
  font-size: 25rpx;
}

.track-detail {
  display: grid;
  gap: 8rpx;
  margin-top: 18rpx;
  border-radius: 16rpx;
  padding: 18rpx;
  background: var(--c-primary-soft);
  color: var(--c-primary-dark);
  font-size: 23rpx;
  font-weight: 850;
}

.detail-line {
  line-height: 1.45;
}

.report-row {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 10rpx;
  margin-top: 10rpx;
}

.report-button {
  height: 60rpx;
  border: 0;
  border-radius: 14rpx;
  margin: 0;
  padding: 0;
  background: var(--c-primary);
  color: #fff;
  font-size: 22rpx;
  font-weight: 900;
}

.tracking-search {
  background: #f7fbff;
}

.report-button::after {
  border: 0;
}
