@import "../../../app.wxss";

.page .input {
  height: 76rpx;
  min-height: 76rpx;
  padding: 0 22rpx;
  border-radius: 16rpx;
  background: #f7fbff;
  line-height: 76rpx;
  font-size: 26rpx;
}

.compact-textarea {
  height: 148rpx;
  min-height: 148rpx;
  padding: 20rpx 22rpx;
  border-radius: 16rpx;
  background: #f7fbff;
  font-size: 26rpx;
  line-height: 1.5;
}

.file-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  padding: 18rpx;
  border: 1rpx solid var(--c-border);
  border-radius: 16rpx;
  background: #f7fbff;
}

.file-name {
  margin-bottom: 8rpx;
  font-size: 27rpx;
  font-weight: 900;
  color: var(--c-text);
  word-break: break-all;
}

.bottom-action {
  width: 100%;
  height: 78rpx;
  margin: 22rpx 0 8rpx;
  border-radius: 16rpx;
  font-size: 26rpx;
  font-weight: 950;
  line-height: 78rpx;
}

.bottom-action::after {
  border: 0;
}
