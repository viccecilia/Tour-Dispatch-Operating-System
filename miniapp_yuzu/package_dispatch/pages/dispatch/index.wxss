}

.daily-summary-card text {
  display: block;
  color: #64748b;
  font-size: 20rpx;
  font-weight: 850;
}

.daily-summary-card strong {
  display: block;
  margin-top: 6rpx;
  color: #0f172a;
  font-size: 32rpx;
  font-weight: 950;
}

.daily-summary-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 4rpx;
  margin-top: 5rpx;
  color: #64748b;
  font-size: 16rpx;
  line-height: 1.1;
  white-space: nowrap;
}

.daily-summary-ratio {
  color: #0f172a;
  font-weight: 950;
}

.daily-preview-head {
  margin-top: 18rpx;
}

.panel-title.mini {
  font-size: 27rpx;
}

.daily-driver-group {
  margin-top: 16rpx;
  padding: 16rpx;
  border-radius: 24rpx;
  border: 1rpx solid #ccfbf1;
  background: #f8fffe;
}

.daily-group-head {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 148rpx 92rpx;
  gap: 10rpx;
}

.daily-group-input {
  min-width: 0;
}

.daily-group-input.vehicle {
  text-align: center;
}

.danger-mini {
  color: #dc2626;
  border: 1rpx solid #fecaca;
  background: #fff7f7;
}

.daily-order-editor {
  margin-top: 14rpx;
  padding: 14rpx;
  border-radius: 20rpx;
  border: 1rpx solid #dbe3ee;
  background: #ffffff;
}

.daily-order-title {
  color: #0f172a;
  font-size: 24rpx;
  font-weight: 950;
}

.daily-form-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
  margin-top: 12rpx;
}

.daily-add-order {
  width: 100%;
  margin-top: 14rpx;
}

/* Daily assignment controls: fixed dimensions for the miniapp viewport. */
.toolbar {
  overflow: hidden;
}

.tool-button {
  min-width: 0;
  max-height: 66rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 8rpx;
  line-height: 1;
  overflow: hidden;
  white-space: nowrap;
}

.daily-intro {
  overflow: hidden;
}

.daily-tool,
.danger-mini {
  height: 54rpx;
  min-height: 54rpx;
  max-height: 54rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 12rpx;
  line-height: 1;
  overflow: hidden;
  white-space: nowrap;
}

.daily-action,
.daily-submit,
.daily-add-order {
  height: 72rpx;
  min-height: 72rpx;
  max-height: 72rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 14rpx;
  line-height: 1;
  overflow: hidden;
  white-space: nowrap;
}

.daily-overview-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 10rpx;
  margin-top: 16rpx;
}

.daily-summary-card.success {
  border-color: #bbf7d0;
  background: #f0fdf4;
}

.daily-issue-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
  margin-top: 12rpx;
}

.daily-issue-card {
  min-width: 0;
  min-height: 104rpx;
  box-sizing: border-box;
  padding: 14rpx;
  border-radius: 20rpx;
  border: 1rpx solid #bbf7d0;
  background: #f0fdf4;
}

.daily-issue-card.warning {
  border-color: #fed7aa;
  background: #fff7ed;
}

.daily-issue-title {
  color: #0f172a;
  font-size: 22rpx;
  font-weight: 950;
}

.daily-issue-empty,
.daily-issue-line {
  margin-top: 8rpx;
  color: #64748b;
  font-size: 21rpx;
  line-height: 1.35;
}

.daily-issue-line {
  color: #b45309;
  font-weight: 900;
}

.daily-driver-nav {
  margin-top: 14rpx;
  padding: 14rpx;
  border-radius: 20rpx;
  border: 1rpx solid #dbeafe;
  background: #f8fbff;
}

.daily-driver-nav-title {
  color: #0f172a;
  font-size: 22rpx;
  font-weight: 950;
}

.daily-driver-chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 10rpx;
}

.daily-driver-chip {
  max-width: 100%;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 10rpx 12rpx;
  border-radius: 999rpx;
  color: #0f766e;
  border: 1rpx solid #99f6e4;
  background: #ecfdf5;
  font-size: 21rpx;
  font-weight: 900;
}

.daily-driver-chip text,
.daily-driver-chip strong,
.daily-driver-chip em {
  min-width: 0;
  font-style: normal;
  white-space: nowrap;
}

.daily-driver-chip strong {
  color: #0f172a;
}

.daily-driver-chip em {
  color: #64748b;
}

.tap-control,
.tool-button {
  appearance: none;
  -webkit-appearance: none;
  box-sizing: border-box;
  margin: 0;
  border: 0;
  text-align: center;
}

.tap-control::after,
.tool-button::after {
  border: 0;
}

.toolbar .tool-button {
  width: 100%;
  height: 58rpx;
  min-height: 58rpx;
  max-height: 58rpx;
  padding: 0 6rpx;
  border-radius: 16rpx;
  font-size: 21rpx;
  font-weight: 950;
}

.daily-tools {
  flex: 0 0 148rpx;
  grid-template-columns: repeat(2, 1fr);
  gap: 8rpx;
}

.daily-tool {
  width: 100%;
  height: 48rpx;
  min-height: 48rpx;
  max-height: 48rpx;
  padding: 0 8rpx;
  border-radius: 14rpx;
  font-size: 20rpx;
}

.daily-tool.add-driver {
  flex: 0 0 132rpx;
}

.daily-action,
.daily-submit {
  height: 64rpx;
  min-height: 64rpx;
  max-height: 64rpx;
  border-radius: 16rpx;
  font-size: 23rpx;
}

.daily-add-order {
  height: 58rpx;
  min-height: 58rpx;
  max-height: 58rpx;
  border-radius: 16rpx;
  font-size: 22rpx;
}

.danger-mini {
  width: 84rpx;
  height: 50rpx;
  min-height: 50rpx;
  max-height: 50rpx;
  padding: 0;
  border-radius: 14rpx;
  font-size: 20rpx;
}

.daily-group-head {
  grid-template-columns: minmax(0, 1fr) 132rpx 84rpx;
}

/* Compact daily allocation table. */
.daily-driver-group {
  padding: 12rpx;
  border-radius: 20rpx;
  background: #f8fffe;
}

.daily-group-head {
  align-items: center;
  grid-template-columns: minmax(0, 1fr) 56rpx;
  gap: 8rpx;
}

.daily-driver-meta {
  min-width: 0;
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  align-items: center;
  gap: 8rpx;
}

.daily-group-input.driver-name,
.daily-group-input.vehicle,
.daily-group-input.driver-line {
  height: 52rpx;
  min-height: 52rpx;
  border-radius: 14rpx;
  font-size: 22rpx;
  font-weight: 900;
  background: #ffffff;
}

.daily-group-input.driver-line {
  padding-left: 4rpx;
  color: #0f172a;
  background: transparent;
  border-color: transparent;
}

.daily-order-count {
  flex: 0 0 auto;
  padding: 7rpx 9rpx;
  border-radius: 999rpx;
  color: #0f766e;
  background: #ccfbf1;
  font-size: 18rpx;
  font-weight: 950;
  white-space: nowrap;
}

.daily-date-badge {
  min-width: 0;
  padding: 7rpx 9rpx;
  border-radius: 999rpx;
  color: #475569;
  background: #eef2f7;
  font-size: 18rpx;
  font-weight: 900;
  white-space: nowrap;
}

.daily-order-table {
  margin-top: 8rpx;
  overflow: hidden;
  border-radius: 14rpx;
  border: 1rpx solid #dbeafe;
  background: #ffffff;
}

.daily-table-head {
  display: none;
}

.daily-table-head text {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.daily-swipe-shell {
  position: relative;
  overflow: hidden;
  border-top: 1rpx solid #e8f3ef;
  background: #ef4444;
}

.daily-swipe-shell:first-child {
  border-top: 0;
}

.daily-order-line {
  position: relative;
  display: grid;
  z-index: 1;
  grid-template-columns: 22rpx 62rpx 56rpx 62rpx minmax(0, 1fr) 54rpx 62rpx;
  gap: 4rpx;
  align-items: stretch;
  padding: 6rpx;
  background: #ffffff;
  transform: translateX(0);
  transition: transform 180ms ease-out;
}

.daily-order-line.swipe-open {
  transform: translateX(-104rpx);
}

.daily-order-line.voided {
  background: #fff7f7;
}

.daily-order-index {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #0f766e;
  font-size: 17rpx;
  font-weight: 950;
}

.daily-date-time,
.daily-route-cell {
  min-width: 0;
  display: grid;
  gap: 5rpx;
}

.daily-date-time {
  grid-template-columns: 1fr;
}

.daily-cell-input {
  box-sizing: border-box;
  width: 100%;
  min-width: 0;
  height: 40rpx;
  min-height: 40rpx;
  padding: 0 6rpx;
  border-radius: 9rpx;
  border: 1rpx solid #dbe3ee;
  color: #0f172a;
  background: #f8fafc;
  font-size: 18rpx;
  font-weight: 800;
  line-height: 1;
  overflow: hidden;
}

.daily-cell-input.date {
  color: #64748b;
  font-size: 17rpx;
}

.daily-cell-input.time {
  color: #0f766e;
  font-size: 19rpx;
}

.daily-cell-input.route {
  font-size: 19rpx;
  font-weight: 900;
  background: #ffffff;
}

.daily-cell-input.remark {
  color: #64748b;
  font-size: 17rpx;
  background: #f8fafc;
}

.daily-cell-input.price,
.daily-cell-input.status {
  text-align: center;
}

.daily-line-delete {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  width: 104rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  background: #ef4444;
  font-size: 19rpx;
  font-weight: 950;
}

.daily-add-order {
  height: 50rpx;
  min-height: 50rpx;
  max-height: 50rpx;
  margin-top: 10rpx;
}

.daily-group-head .danger-mini {
  width: 56rpx;
  height: 40rpx;
  min-height: 40rpx;
  max-height: 40rpx;
  font-size: 17rpx;
}

/* Text-like daily preview: fields stay editable without looking like form boxes. */
.daily-group-input.driver-name,
.daily-group-input.vehicle,
.daily-group-input.driver-line,
.daily-cell-input {
  border-color: transparent;
  background: transparent;
  box-shadow: none;
}

.daily-group-input.driver-name {
  padding-left: 4rpx;
  color: #0f172a;
}

.daily-group-input.vehicle {
  color: #475569;
  background: #f8fafc;
}

.daily-order-table {
  border-color: #d5f3eb;
  background: #fbfffd;
}

.daily-order-line {
  padding: 4rpx 6rpx;
  background: #fbfffd;
}

.daily-cell-input {
  height: 36rpx;
  min-height: 36rpx;
  padding: 0 4rpx;
  border-radius: 0;
}

.daily-cell-input.time {
  font-weight: 950;
}

.daily-cell-input.route {
  background: transparent;
}

.daily-cell-input.price {
  color: #0f172a;
  font-weight: 950;
}

.daily-cell-input.status {
  border-radius: 8rpx;
  background: #f8fafc;
  color: #0f172a;
}

.daily-line-delete {
  height: auto;
  color: #ffffff;
  background: #ef4444;
}

.published-panel {
  margin-top: 16rpx;
}

.published-scroll {
  max-height: 360rpx;
  margin-top: 12rpx;
}

.published-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12rpx;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #e8f3ef;
}

.published-row.selected {
  padding-left: 12rpx;
  padding-right: 12rpx;
  border-radius: 16rpx;
  border-bottom-color: transparent;
  background: #ecfdf5;
}

.published-main {
  min-width: 0;
  flex: 1;
}

.published-time {
  color: #0f172a;
  font-size: 25rpx;
  font-weight: 950;
  line-height: 1.35;
}

.published-route {
  margin-top: 4rpx;
  color: #0f172a;
  font-size: 24rpx;
  font-weight: 900;
  line-height: 1.35;
  word-break: break-all;
}

.published-meta {
  margin-top: 5rpx;
  color: #64748b;
  font-size: 20rpx;
  font-weight: 750;
  line-height: 1.35;
}

.published-side {
  flex: 0 0 128rpx;
  display: grid;
  justify-items: end;
  gap: 8rpx;
}

.published-order-no,
.published-status {
  max-width: 128rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  border-radius: 999rpx;
  padding: 4rpx 10rpx;
  font-size: 18rpx;
  font-weight: 850;
}

.published-order-no {
  background: #eef6ff;
  color: #64748b;
}

.published-status {
  background: #ccfbf1;
  color: #0f766e;
}

.published-editor {
  margin-top: 16rpx;
  padding: 16rpx;
  border-radius: 20rpx;
  border: 1rpx solid #bfdbfe;
  background: #f8fbff;
}

.published-editor-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 14rpx;
}

.published-editor-title {
  color: #0f172a;
  font-size: 28rpx;
  font-weight: 950;
}

.published-editor-sub {
  margin-top: 6rpx;
  color: #64748b;
  font-size: 21rpx;
  font-weight: 750;
  line-height: 1.4;
}

.published-form-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 10rpx;
  margin-top: 14rpx;
}

.published-input {
  min-height: 66rpx;
  height: 66rpx;
  font-size: 22rpx;
}

.published-input.wide {
  grid-column: 1 / -1;
}

.published-actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 10rpx;
  margin-top: 14rpx;
}

.history-title {
  margin-top: 18rpx;
  color: #0f172a;
  font-size: 25rpx;
  font-weight: 950;
}

.history-row {
  position: relative;
  display: flex;
  gap: 12rpx;
  margin-top: 14rpx;
}

.history-dot {
  flex: 0 0 16rpx;
  width: 16rpx;
  height: 16rpx;
  margin-top: 12rpx;
  border-radius: 999rpx;
  background: #14b8a6;
  box-shadow: 0 0 0 6rpx #ccfbf1;
}

.history-content {
  min-width: 0;
  flex: 1;
  padding: 12rpx;
  border-radius: 16rpx;
  background: #ffffff;
  border: 1rpx solid #e2e8f0;
}

.history-top {
  display: flex;
  justify-content: space-between;
  gap: 10rpx;
  color: #64748b;
  font-size: 19rpx;
  font-weight: 800;
}

.history-summary {
  margin-top: 6rpx;
  color: #0f172a;
  font-size: 22rpx;
  font-weight: 900;
  line-height: 1.35;
}

.history-diff {
  display: grid;
  grid-template-columns: 96rpx 1fr;
  gap: 8rpx;
  margin-top: 8rpx;
  color: #334155;
  font-size: 20rpx;
  font-weight: 750;
  line-height: 1.35;
  word-break: break-all;
}

.history-diff text {
  color: #0f766e;
  font-weight: 900;
}

.history-empty {
  margin-top: 8rpx;
  color: #94a3b8;
  font-size: 20rpx;
  font-weight: 750;
}
