@import "../../../app.wxss";

.dispatch-page {
  padding-bottom: 390rpx;
}

.quick-hero {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.title-with-help {
  display: flex;
  align-items: center;
  gap: 10rpx;
  min-width: 0;
}

.import-title-row {
  justify-content: space-between;
  gap: 16rpx;
}

.title-left {
  display: flex;
  align-items: center;
  gap: 8rpx;
  min-width: 0;
}

.import-title-row .panel-title {
  margin-bottom: 0;
}

.daily-clear-mini {
  flex: 0 0 auto;
  min-width: 60rpx;
  height: 36rpx;
  padding: 0 16rpx;
  border: 1rpx solid rgba(13, 148, 136, 0.28);
  border-radius: 999rpx;
  background: #ecfdf5;
  color: #0f766e;
  font-size: 21rpx;
  font-weight: 800;
  line-height: 36rpx;
  text-align: center;
}

.daily-clear-mini:active {
  transform: scale(0.96);
  opacity: 0.84;
}

.help-dot {
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  width: 30rpx;
  height: 30rpx;
  border-radius: 999rpx;
  color: #64748b;
  background: #eef2f7;
  border: 1rpx solid #dbe3ee;
  font-size: 21rpx;
  font-weight: 950;
  line-height: 1;
}

.hero-help {
  color: #dbeafe;
  background: rgba(255, 255, 255, 0.18);
  border-color: rgba(255, 255, 255, 0.35);
}

.hero-count {
  flex: 0 0 auto;
  min-width: 96rpx;
  height: 96rpx;
  border-radius: 30rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.18);
  color: #dbeafe;
  font-size: 20rpx;
  font-weight: 800;
}

.hero-count strong {
  color: #ffffff;
  font-size: 38rpx;
  line-height: 1;
}

.toolbar {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 10rpx;
  margin: 14rpx 0;
}

.tool-button {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 0;
  height: 66rpx;
  min-height: 66rpx;
  box-sizing: border-box;
  margin: 0;
  padding: 0 10rpx;
  border-radius: 18rpx;
  border: 1rpx solid var(--c-border);
  color: var(--c-text);
  background: #ffffff;
  font-size: 22rpx;
  font-weight: 900;
  line-height: 1;
  box-shadow: var(--shadow-card);
  white-space: nowrap;
}

.tool-button.secondary {
  color: #1d4ed8;
  border-color: #bfdbfe;
  background: #eff6ff;
  box-shadow: none;
}

.tool-button.primary {
  color: #ffffff;
  border-color: #1d4ed8;
  background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%);
  box-shadow: 0 14rpx 30rpx rgba(37, 99, 235, 0.24);
}

.tool-button.flow-demo {
  color: #075d54;
  border-color: #82d9cd;
  background: #e6fbf6;
}

.tool-button.primary.active,
.tool-button.secondary.active {
  color: #1d4ed8;
  border-color: #bfdbfe;
  background: #dbeafe;
  box-shadow: none;
}

.tool-button.dispatch-top,
.tool-button.reassign-top,
.tool-button.auction-top {
  color: #64748b;
  border-color: #dbeafe;
  background: #eff6ff;
  box-shadow: none;
}

.tool-button.dispatch-top.ready,
.tool-button.reassign-top.ready {
  border-color: #16a34a;
  background: #16a34a;
}

.tool-button.auction-top.ready {
  border-color: #f59e0b;
  color: #ffffff;
  background: #f59e0b;
}

.tool-button::after,
.button-primary::after,
.mini-btn::after,
.small-button::after,
.dispatch-button::after {
  border: 0;
}

.help-mask {
  position: fixed;
  inset: 0;
  z-index: 80;
  background: rgba(15, 23, 42, 0.08);
}

.help-popover {
  position: fixed;
  top: 152rpx;
  left: 28rpx;
  right: 28rpx;
  z-index: 81;
  padding: 22rpx;
  border-radius: 24rpx;
  border: 1rpx solid #dbe3ee;
  background: #ffffff;
  box-shadow: 0 22rpx 52rpx rgba(15, 23, 42, 0.16);
}

.help-popover-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.help-popover-title {
  color: #0f172a;
  font-size: 27rpx;
  font-weight: 950;
}

.help-close {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44rpx;
  height: 44rpx;
  border-radius: 999rpx;
  color: #64748b;
  background: #f1f5f9;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1;
}

.help-popover-body {
  margin-top: 12rpx;
  color: #475569;
  font-size: 23rpx;
  line-height: 1.5;
}

.import-panel,
.charter-panel,
.resource-box {
  margin-top: 14rpx;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
}

.section-head.small {
  align-items: flex-start;
}

.count-pill {
  flex: 0 0 auto;
  padding: 7rpx 13rpx;
  border-radius: 999rpx;
  color: var(--c-primary);
  background: var(--c-primary-soft);
  font-size: 20rpx;
  font-weight: 900;
}

.textarea {
  box-sizing: border-box;
  width: 100%;
  min-height: 180rpx;
  margin-top: 12rpx;
  padding: 16rpx;
  border-radius: 20rpx;
  border: 1rpx solid var(--c-border);
  color: var(--c-text);
  background: #f8fafc;
  font-size: 24rpx;
  line-height: 1.45;
}

.single-textarea {
  min-height: 122rpx;
}

.button-primary {
  height: 78rpx;
  margin-top: 14rpx;
  border-radius: 24rpx;
  color: #ffffff;
  background: var(--c-primary);
  font-size: 28rpx;
  font-weight: 900;
}

.charter-scroll {
  height: 276rpx;
  margin-top: 12rpx;
}

.airport-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
  margin-top: 14rpx;
}

.list-panel {
  min-width: 0;
  padding: 18rpx;
}

.airport-scroll {
  height: 478rpx;
  margin-top: 10rpx;
}

.compact-row {
  min-height: 86rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 8rpx;
  padding: 10rpx;
  border-radius: 18rpx;
  border: 1rpx solid var(--c-border);
  background: #ffffff;
}

.row-shell {
  margin-bottom: 8rpx;
}

.charter-row {
  min-height: 76rpx;
}

.airport-row {
  min-height: 74rpx;
  padding: 9rpx;
}

.compact-row.selected {
  border-color: var(--c-primary);
  background: #f5f9ff;
}

.compact-row.risk {
  border-color: #fed7aa;
}

.status-dot {
  flex: 0 0 auto;
  width: 16rpx;
  height: 16rpx;
  border-radius: 999rpx;
  background: #16a34a;
  box-shadow: 0 0 0 6rpx rgba(22, 163, 74, 0.12);
}

.status-dot.ok {
  background: #16a34a;
  box-shadow: 0 0 0 6rpx rgba(22, 163, 74, 0.12);
}

.status-dot.busy,
.status-dot.warn {
  background: #f59e0b;
  box-shadow: 0 0 0 6rpx rgba(245, 158, 11, 0.14);
}

.status-dot.danger {
  background: #ef4444;
  box-shadow: 0 0 0 6rpx rgba(239, 68, 68, 0.12);
}

.compact-main {
  min-width: 0;
  flex: 1;
}

.compact-top {
  display: flex;
  align-items: center;
  gap: 8rpx;
  min-width: 0;
}

.type-chip {
  flex: 0 0 auto;
  padding: 4rpx 8rpx;
  border-radius: 999rpx;
  color: #b45309;
  background: #fef3c7;
  font-size: 18rpx;
  font-weight: 900;
}

.compact-no {
  min-width: 0;
  color: var(--c-primary-dark);
  font-size: 21rpx;
  font-weight: 950;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.compact-price {
  flex: 0 0 auto;
  color: var(--c-text);
  font-size: 20rpx;
  font-weight: 900;
}

.compact-line {
  margin-top: 5rpx;
  color: var(--c-text);
  font-size: 22rpx;
  line-height: 1.25;
  font-weight: 850;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.compact-meta {
  margin-top: 4rpx;
  color: var(--c-muted);
  font-size: 19rpx;
  font-weight: 750;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.mini-actions {
  flex: 0 0 auto;
  display: grid;
  gap: 6rpx;
}

.mini-btn {
  width: 60rpx;
  height: 36rpx;
  margin: 0;
  padding: 0;
  border-radius: 12rpx;
  color: var(--c-primary-dark);
  background: var(--c-primary-soft);
  font-size: 18rpx;
  font-weight: 900;
  line-height: 36rpx;
}

.compact-confirm {
  width: 64rpx;
}

.empty-line {
  padding: 24rpx 0;
  color: var(--c-muted);
  font-size: 23rpx;
  text-align: center;
}

.edit-panel,
.inline-edit {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 10rpx;
  margin-top: 14rpx;
}

.inline-edit {
  margin: -2rpx 4rpx 10rpx 28rpx;
  padding: 12rpx;
  border-radius: 18rpx;
  border: 1rpx solid #dbeafe;
  background: #f8fbff;
}

.compact-edit {
  grid-template-columns: 1fr;
  margin-left: 20rpx;
}

.input.full {
  grid-column: 1 / -1;
}

.input {
  box-sizing: border-box;
  height: 64rpx;
  padding: 0 14rpx;
  border-radius: 17rpx;
  border: 1rpx solid var(--c-border);
  color: var(--c-text);
  background: #f8fafc;
  font-size: 23rpx;
}

.edit-actions {
  grid-column: 1 / -1;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 10rpx;
}

.small-button {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 58rpx;
  min-width: 0;
  margin: 0;
  padding: 0 18rpx;
  border-radius: 18rpx;
  color: #334155;
  background: #f1f5f9;
  font-size: 23rpx;
  font-weight: 850;
  line-height: 1;
  text-align: center;
  white-space: nowrap;
  box-sizing: border-box;
}

.small-button.primary {
  color: #ffffff;
  background: var(--c-primary);
}

.single-action-row,
.single-submit-row {
  display: flex;
  gap: 10rpx;
  margin-top: 12rpx;
  align-items: stretch;
}

.single-tool-button,
.single-submit-button {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1 1 0;
  width: auto;
  min-width: 0;
  height: 56rpx;
  min-height: 56rpx;
  padding: 0 14rpx;
  border-radius: 16rpx;
  font-size: 22rpx;
  font-weight: 900;
  line-height: 1;
  box-sizing: border-box;
  text-align: center;
  white-space: nowrap;
  overflow: hidden;
}

.single-tool-button.primary {
  color: #ffffff;
  background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%);
}

.single-submit-button.primary {
  color: #ffffff;
  background: #0f766e;
}

.single-form-wrap {
  margin-top: 12rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid #e2e8f0;
}

.single-form-tip {
  margin-bottom: 10rpx;
  padding: 12rpx 14rpx;
  border-radius: 14rpx;
  color: #475569;
  background: #f8fafc;
  font-size: 20rpx;
  line-height: 1.4;
}

.single-placeholder {
  margin-top: 12rpx;
  padding: 14rpx 16rpx;
  border-radius: 16rpx;
  color: #64748b;
  background: #f8fafc;
  font-size: 21rpx;
  line-height: 1.45;
}

.single-form-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 10rpx;
}

.field {
  min-width: 0;
}

.field-wide {
  grid-column: 1 / -1;
}

.field-label {
  margin-bottom: 6rpx;
  color: #64748b;
  font-size: 20rpx;
  font-weight: 850;
  line-height: 1.2;
}

.single-form-grid .input {
  height: 56rpx;
  padding: 0 12rpx;
  border-radius: 14rpx;
  font-size: 22rpx;
}

.mini-textarea {
  box-sizing: border-box;
  width: 100%;
  min-height: 92rpx;
  padding: 12rpx;
  border-radius: 14rpx;
  border: 1rpx solid var(--c-border);
  color: var(--c-text);
  background: #f8fafc;
  font-size: 22rpx;
  line-height: 1.4;
}

.resource-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
  margin-top: 14rpx;
}

.resource-scroll {
  height: 328rpx;
  margin-top: 10rpx;
}

.resource-row {
  min-height: 56rpx;
  box-sizing: border-box;
  display: grid;
  grid-template-columns: 18rpx minmax(0, 1fr) auto;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 7rpx;
  padding: 8rpx 10rpx;
  border-radius: 16rpx;
  border: 1rpx solid var(--c-border);
  background: #ffffff;
}

.resource-row.driver-row {
  grid-template-columns: 18rpx minmax(0, 1fr);
}

.resource-row.selected {
  border-color: var(--c-primary);
  background: var(--c-primary-soft);
}

.resource-row.disabled {
  opacity: 0.58;
}

.resource-name {
  min-width: 0;
  color: var(--c-text);
  font-size: 23rpx;
  font-weight: 900;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.resource-sub {
  max-width: 112rpx;
  color: var(--c-muted);
  font-size: 18rpx;
  font-weight: 750;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.dispatch-preview {
  position: fixed;
  left: 32rpx;
  right: 32rpx;
  bottom: calc(132rpx + env(safe-area-inset-bottom));
  z-index: 1200;
  box-sizing: border-box;
  border-radius: 20rpx;
  display: grid;
  grid-template-columns: minmax(0, 1fr) 252rpx;
  align-items: center;
  gap: 14rpx;
  padding: 12rpx 14rpx;
  background: #ffffff;
  color: var(--c-text);
  border: 1rpx solid var(--c-border);
  box-shadow: 0 14rpx 30rpx rgba(30, 54, 92, 0.12);
}

.preview-copy,
.preview-info {
  min-width: 0;
}

.preview-title {
  font-size: 23rpx;
  font-weight: 950;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.preview-sub {
  margin-top: 3rpx;
  font-size: 18rpx;
  line-height: 1.3;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.preview-sub.is-pending {
  color: #64748b;
  font-weight: 800;
}

.preview-sub.is-ready {
  color: #166534;
  font-weight: 850;
}

.dispatch-button {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1 1 0;
  width: auto;
  min-width: 0;
  height: 58rpx;
  box-sizing: border-box;
  margin: 0;
  padding: 0 8rpx;
  border-radius: 16rpx;
  color: #ffffff;
  font-size: 21rpx;
  font-weight: 900;
  border: 0;
  line-height: 1;
  text-align: center;
  white-space: nowrap;
}

.preview-actions {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 10rpx;
  width: 252rpx;
  min-width: 252rpx;
}

.dispatch-button.ready {
  background: #0f766e;
}

.dispatch-button.hall-button {
  color: #b45309;
  background: #fff7ed;
  border: 1rpx solid #fdba74;
}

.dispatch-button.disabled {
  background: #eef2f7;
  color: #94a3b8;
  border: 1rpx solid #dbe3ee;
  box-sizing: border-box;
}

.conflict,
.success-text {
  margin-top: 14rpx;
  border-radius: 20rpx;
  padding: 14rpx;
  font-size: 22rpx;
  line-height: 1.4;
}

.conflict {
  color: #991b1b;
  background: #fee2e2;
}

.success-text {
  color: #166534;
  background: #dcfce7;
}

/* Visual parity pass: stronger dispatch workbench hierarchy. */
.dispatch-page {
  padding-left: 22rpx;
  padding-right: 22rpx;
}

.quick-hero {
  min-height: 168rpx;
  padding: 32rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #153b92 0%, #2563eb 100%);
}

.quick-hero .hero-eyebrow {
  font-size: 22rpx;
  font-weight: 900;
}

.quick-hero .hero-title {
  margin-top: 8rpx;
  font-size: 42rpx;
  font-weight: 900;
  line-height: 1.08;
}

.hero-count {
  min-width: 86rpx;
  min-height: 86rpx;
  padding: 14rpx;
  border-radius: 24rpx;
}

.toolbar {
  gap: 12rpx;
  margin-top: 18rpx;
}

.tool-button {
  height: 66rpx;
  min-height: 66rpx;
  border-radius: 18rpx;
  font-size: 22rpx;
}

.tool-button.primary {
  color: #ffffff;
  border-color: #1d4ed8;
  background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%);
}

.tool-button.auction-top.ready {
  background: #f59e0b;
}

.panel,
.resource-box {
  border-radius: 24rpx;
  border-color: #d5e0ee;
  box-shadow: 0 16rpx 34rpx rgba(15, 23, 42, 0.08);
}

.panel-title {
  font-size: 31rpx;
  font-weight: 900;
}

.list-panel {
  min-height: 280rpx;
}

.resource-box {
  min-height: 330rpx;
}

.small-button {
  min-height: 42rpx;
  padding: 8rpx 16rpx;
  font-size: 21rpx;
}

.empty-line {
  font-size: 24rpx;
  color: #475569;
}

.dispatch-button {
  min-width: 112rpx;
  height: 58rpx;
  font-size: 22rpx;
  border-radius: 16rpx;
}

.toolbar {
  grid-template-columns: repeat(3, minmax(0, 1fr));
  padding: 8rpx;
  border-radius: 24rpx;
  background: #eef6ff;
  border: 1rpx solid #dbeafe;
}

.tool-button.daily {
  color: #475569;
  border-color: transparent;
  background: transparent;
  box-shadow: none;
}

.toolbar .tool-button.primary,
.toolbar .tool-button.secondary {
  color: #475569;
  border-color: transparent;
  background: transparent;
  box-shadow: none;
}

.tool-button.daily.active,
.tool-button.primary.active,
.tool-button.secondary.active {
  color: #ffffff;
  border-color: #0f766e;
  background: linear-gradient(135deg, #0f766e 0%, #14b8a6 100%);
  box-shadow: 0 14rpx 30rpx rgba(20, 184, 166, 0.22);
}

.daily-intro,
.daily-preview-head,
.daily-order-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.daily-intro {
  margin-top: 14rpx;
  padding: 18rpx;
  border-radius: 22rpx;
  border: 1rpx solid #ccfbf1;
  background: linear-gradient(135deg, #f0fdfa 0%, #ffffff 100%);
}

.daily-intro-title {
  color: #0f172a;
  font-size: 26rpx;
  font-weight: 950;
}

.daily-intro-text {
  margin-top: 6rpx;
  color: #64748b;
  font-size: 22rpx;
  line-height: 1.45;
}

.daily-tools,
.daily-action-row,
.daily-submit-row {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 10rpx;
}

.daily-tools {
  flex: 0 0 180rpx;
}

.daily-tool,
.danger-mini {
  min-height: 54rpx;
  line-height: 38rpx;
  margin: 0;
}

.daily-textarea {
  min-height: 292rpx;
  border-color: #ccfbf1;
  background: #f8fffe;
}

.daily-textarea.parsed {
  min-height: 76rpx;
  max-height: 96rpx;
  padding: 12rpx;
  font-size: 20rpx;
  line-height: 1.25;
}

.daily-action-row,
.daily-submit-row {
  margin-top: 14rpx;
}

.daily-action,
.daily-submit,
.daily-add-order {
  min-height: 72rpx;
  margin: 0;
  border-radius: 18rpx;
  color: #0f766e;
  border: 1rpx solid #99f6e4;
  background: #ecfdf5;
  font-size: 24rpx;
  font-weight: 950;
}

.daily-action.primary,
.daily-submit.primary {
  color: #ffffff;
