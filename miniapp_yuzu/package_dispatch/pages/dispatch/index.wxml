<view class="page dispatch-page">
  <view class="dispatch-mode-switch">
    <view class="dispatch-mode-option {{workbenchMode === 'daily' ? 'active' : ''}}" data-mode="daily" bindtap="switchWorkbenchMode">日配模式</view>
    <view class="dispatch-mode-option {{workbenchMode === 'batch' ? 'active' : ''}}" data-mode="batch" bindtap="switchWorkbenchMode">批量导入</view>
  </view>

  <block wx:if="{{workbenchMode === 'daily'}}">
    <view class="daily-page-head">
      <view>
        <view class="daily-page-kicker">DAILY DISPATCH</view>
        <view class="daily-page-title">日配</view>
        <view class="daily-page-sub">按司机与车辆核对当日订单</view>
      </view>
      <view class="daily-import-button" bindtap="openDailyImport">导入订单</view>
    </view>

    <view class="daily-date-bar">
      <view class="daily-date-arrow" bindtap="previousDailyDate">‹</view>
      <picker mode="date" value="{{dailyDate}}" bindchange="onDailyDateChange">
        <view class="daily-date-value">{{dailyDate}}</view>
      </picker>
      <view class="daily-date-arrow" bindtap="nextDailyDate">›</view>
      <view class="daily-date-summary">{{dailyRunSummary.vehicles}}司机 · 已发布{{dailyRunSummary.published}} · 待审核{{dailyRunSummary.pending}}</view>
    </view>

    <view class="daily-status-tabs">
      <view wx:for="{{dailyStatusOptions}}" wx:key="value" class="daily-status-tab {{dailyStatusFilter === item.value ? 'active' : ''}}" data-status="{{item.value}}" bindtap="selectDailyStatus">{{item.label}}</view>
    </view>

    <view class="daily-group-list">
      <view wx:for="{{dailyRunGroups}}" wx:key="key" class="daily-run-card {{item.selected ? 'selected' : ''}}">
        <view class="daily-run-head">
          <view class="daily-check {{item.selected ? 'checked' : ''}}" data-key="{{item.key}}" bindtap="toggleDailyGroupSelection">{{item.selected ? '✓' : ''}}</view>
          <view class="daily-run-identity">
            <view class="daily-run-driver">{{item.driver}} <text>{{item.vehicle}}</text></view>
            <view class="daily-run-meta">{{item.orders.length}} 单 · {{item.vehicleFull}}</view>
            <view wx:if="{{item.areaWarningCount}}" class="daily-area-warning">⚠ {{item.areaWarningCount}}单区域待确认</view>
          </view>
          <view class="daily-run-state {{item.status}}">{{item.statusText}}</view>
        </view>
        <view class="daily-run-orders">
          <view wx:for="{{item.visibleOrders}}" wx:key="assignmentId" wx:for-item="order" class="daily-run-order">
            <text class="daily-run-time">{{order.time}}</text>
            <text class="daily-run-route">{{order.route}}</text>
          </view>
          <view wx:if="{{item.hiddenCount}}" class="daily-more">+{{item.hiddenCount}} 单</view>
        </view>
        <view class="daily-run-actions">
          <view class="daily-primary-action" data-key="{{item.key}}" bindtap="openDailyPdf">{{dailyPdfLoadingKey === item.key ? '生成中…' : (item.workflowStatus === 'published' ? '查看PDF' : '审核PDF')}}</view>
        </view>
        <view wx:if="{{item.documentStatusText}}" class="daily-doc-state">{{item.documentStatusText}}</view>
      </view>
      <view wx:if="{{!dailyRunGroups.length}}" class="daily-empty">
        <view class="daily-empty-title">当天暂无已派订单</view>
        <view class="daily-empty-sub">可点击“导入订单”粘贴已配好司机与车辆的日配内容。</view>
      </view>
    </view>

    <view wx:if="{{dailySelectedGroupKeys.length}}" class="daily-release-bar">
      <view><strong>{{dailySelectedGroupKeys.length}}</strong><text>车已选</text></view>
      <view class="daily-release-pdf" bindtap="openDailyPdf">PDF</view>
      <view class="daily-release-button" bindtap="publishSelectedDailyGroups">确认发布</view>
    </view>

    <view wx:if="{{dailyImportOpen}}" class="daily-fullscreen">
      <view class="daily-fullscreen-head">
        <view class="daily-back" bindtap="closeDailyImport">‹ 返回</view>
        <view class="daily-fullscreen-title">导入日配订单</view>
        <view class="daily-fullscreen-spacer"></view>
      </view>
      <scroll-view scroll-y enhanced show-scrollbar="{{false}}" class="daily-fullscreen-body">
        <textarea class="daily-source-editor" maxlength="-1" value="{{dailySourceText}}" bindinput="onDailySourceInput" placeholder="粘贴日期、司机、车牌以及该司机的全部订单" />
        <view class="daily-import-actions">
          <view class="daily-secondary-button" bindtap="parseDailyText">解析</view>
          <view class="daily-secondary-button" bindtap="clearDailySource">清空</view>
        </view>
        <view wx:if="{{dailyMessage}}" class="daily-import-message">{{dailyMessage}}</view>
        <view class="daily-import-warning safe">确认导入后只进入待运行确认，不会通知司机，也不会出现在司机端。</view>
        <view wx:for="{{dailyGroups}}" wx:key="id" class="daily-import-group">
          <view class="daily-import-group-head"><strong>{{item.driverName}}</strong><text>{{item.vehicleCode}} · {{item.orders.length}}单</text></view>
          <view wx:if="{{item.areaWarningCount}}" class="daily-area-warning">⚠ {{item.areaWarningCount}}单区域待确认</view>
          <view wx:for="{{item.orders}}" wx:key="id" wx:for-item="order" class="daily-import-line">
            <text>{{order.displayIndex}} {{order.time}}</text>
            <view><text>{{order.route}}</text><text wx:if="{{order.areaWarning}}" class="daily-area-warning-detail">{{order.areaRoute}} · 营业区域需确认</text></view>
          </view>
        </view>
      </scroll-view>
      <view class="daily-fullscreen-footer">
        <view class="daily-confirm-import {{dailyGroups.length && !dailyImportSubmitting ? '' : 'disabled'}}" bindtap="publishDailyAssignments">{{dailyImportSubmitting ? '正在导入…' : '确认'}}</view>
      </view>
    </view>

    <view wx:if="{{dailyPdfReviewOpen}}" class="daily-fullscreen daily-pdf-review-screen">
      <view class="daily-fullscreen-head">
        <view class="daily-back" bindtap="closeDailyPdfReview">‹ 日配</view>
        <view class="daily-fullscreen-title">{{dailyPdfReviewIndex + 1}} / {{dailyPdfReviewTotal}} 司机</view>
        <view class="daily-review-edit" bindtap="editDailyPdf">修改</view>
      </view>
      <view class="daily-fullscreen-body daily-pdf-review-body">
        <view class="daily-review-title">{{dailyPdfReviewGroup.driver_name || dailyPdfReviewGroup.driver}} · {{dailyPdfReviewGroup.plate_number || dailyPdfReviewGroup.vehicleFull}}</view>
        <view class="daily-review-summary">{{dailyPdfReviewGroup.business_date}} · {{dailyPdfReviewGroup.order_count || dailyPdfReviewGroup.orders.length}}单</view>
        <view class="daily-pdf-file">{{dailyPdfReviewDocument.file_name}}</view>
        <view class="daily-pdf-meta">PDF 草稿 V{{dailyPdfReviewDocument.version}} · {{dailyPdfReviewDocument.page_count}} 页</view>
        <view wx:if="{{dailyPdfValidationIssues.length}}" class="daily-pdf-issues">
          <view class="daily-doc-head">{{dailyPdfValidationIssues.length}} 项待补</view>
          <view wx:for="{{dailyPdfValidationIssues}}" wx:key="*this">{{item}}</view>
        </view>
        <view class="daily-pdf-canvas" bindtap="openGeneratedDailyPdf">
          <view class="daily-pdf-canvas-icon">PDF</view>
          <view class="daily-doc-head">打开完整运行文件</view>
          <view>每个行程一份運送引受書</view>
          <view>最后为全天運行指示書</view>
          <view class="daily-doc-note">打开后上下滑动逐页检查；返回本页可修改或发布。</view>
        </view>
      </view>
      <view class="daily-review-footer daily-pdf-review-footer">
        <view class="daily-review-nav {{dailyPdfReviewIndex <= 0 ? 'disabled' : ''}}" bindtap="previousDailyPdfDriver">上一位</view>
        <view wx:if="{{dailyPdfReviewCanConfirm}}" class="daily-review-confirm" bindtap="confirmDailyPdfReview">确认并发布</view>
        <view wx:else class="daily-review-confirm disabled">{{dailyPdfReviewGroup.workflowStatus === 'published' ? '已发布' : '请先补全'}}</view>
        <view class="daily-review-nav {{dailyPdfReviewIndex + 1 >= dailyPdfReviewTotal ? 'disabled' : ''}}" bindtap="nextDailyPdfDriver">下一位</view>
      </view>
    </view>

    <view wx:if="{{dailyReviewOpen}}" class="daily-fullscreen daily-review-screen">
      <view class="daily-fullscreen-head">
        <view class="daily-back" bindtap="closeDailyReview">‹ 返回</view>
        <view class="daily-review-progress">{{dailyReviewOrderIndex + 1}} / {{dailyReviewGroup.orders.length}}</view>
        <view class="daily-review-edit" bindtap="toggleDailyReviewEdit">{{dailyReviewEdit ? '预览' : '修改'}}</view>
      </view>
      <scroll-view scroll-y class="daily-fullscreen-body daily-review-body">
        <view class="daily-review-title">{{dailyReviewGroup.driver}} · {{dailyReviewGroup.vehicleFull}}</view>
        <view class="daily-review-summary">{{dailyReviewGroup.business_date}} · 已确认 {{dailyReviewConfirmedCount}} / {{dailyReviewGroup.orders.length}}</view>
        <view class="daily-review-order-list">
          <view wx:for="{{dailyReviewGroup.orders}}" wx:key="assignmentId" wx:for-index="reviewIndex" class="daily-review-order-card {{reviewIndex === dailyReviewOrderIndex ? 'active' : ''}}" data-index="{{reviewIndex}}" bindtap="selectDailyReviewOrder">
            <view><strong>第{{reviewIndex + 1}}单</strong><text>{{item.reviewed ? '已确认' : '待确认'}}</text></view>
            <view class="daily-review-order-route">{{item.time}} · {{item.route}}</view>
            <view class="daily-review-order-meta">¥{{item.price || item.recommended_price || '-'}} · {{item.businessArea}} · {{item.order_type || '-'}}</view>
          </view>
        </view>
        <view class="daily-review-order-no">{{dailyReviewOrder.oid || dailyReviewOrder.orderId}}</view>
        <view class="daily-review-fields">
          <view class="daily-review-field"><text>日期</text><picker disabled="{{!dailyReviewEdit}}" mode="date" value="{{dailyReviewForm.order_date}}" bindchange="onDailyReviewDate"><view class="daily-picker-value">{{dailyReviewForm.order_date}}</view></picker></view>
          <view class="daily-review-field"><text>时间</text><picker disabled="{{!dailyReviewEdit}}" mode="time" value="{{dailyReviewForm.start_time}}" bindchange="onDailyReviewTime"><view class="daily-picker-value">{{dailyReviewForm.start_time}}</view></picker></view>
          <view class="daily-review-field"><text>营业区域</text><picker disabled="{{!dailyReviewEdit}}" mode="selector" range="{{dailyBusinessAreas}}" bindchange="onDailyReviewArea"><view class="daily-picker-value">{{dailyReviewForm.business_area}}</view></picker></view>
          <view class="daily-review-field"><text>类型</text><picker disabled="{{!dailyReviewEdit}}" mode="selector" range="{{dailyOrderTypes}}" bindchange="onDailyReviewType"><view class="daily-picker-value">{{dailyReviewForm.order_type}}</view></picker></view>
          <view class="daily-review-field wide"><text>接送地点</text><input disabled="{{!dailyReviewEdit}}" data-field="pickup_location" value="{{dailyReviewForm.pickup_location}}" bindinput="onDailyReviewField" placeholder="上车地点" /><input disabled="{{!dailyReviewEdit}}" data-field="dropoff_location" value="{{dailyReviewForm.dropoff_location}}" bindinput="onDailyReviewField" placeholder="下车地点" /></view>
          <view class="daily-review-field"><text>金额</text><input disabled="{{!dailyReviewEdit}}" data-field="price" value="{{dailyReviewForm.price}}" bindinput="onDailyReviewField" /><text wx:if="{{dailyReviewOrder.recommended_price}}" class="daily-price-reference">参考 ¥{{dailyReviewOrder.recommended_price}} · {{dailyReviewOrder.recommended_price_label}}</text></view>
        </view>
        <view class="daily-doc-preview">
          <view class="daily-doc-head">运行文件预览</view>
          <view>运行引受书：按行程生成，可多页</view>
          <view>运行指示书：本车当日 1 份</view>
          <view class="daily-doc-note">保存后会修改服务器源订单、作废旧草稿，并自动生成新版 PDF。</view>
        </view>
      </scroll-view>
      <view class="daily-review-footer">
        <view class="daily-review-nav {{dailyReviewOrderIndex <= 0 ? 'disabled' : ''}}" bindtap="previousDailyReviewOrder">上一单</view>
        <view class="daily-review-confirm" bindtap="confirmDailyReview">保存并重生成</view>
        <view class="daily-review-nav {{dailyReviewOrderIndex + 1 >= dailyReviewGroup.orders.length ? 'disabled' : ''}}" bindtap="nextDailyReviewOrder">下一单</view>
      </view>
    </view>
  </block>

  <block wx:else>
  <view class="hero quick-hero">
    <view class="preview-copy">
      <view class="hero-eyebrow">DISPATCH WORKBENCH</view>
      <view class="title-with-help">
        <view class="hero-title">导入与派车</view>
        <view class="help-dot hero-help" data-type="hero" bindtap="showHelp">?</view>
      </view>
    </view>
    <view class="hero-count">
      <text>已选</text>
      <strong>{{selectedKeys.length}}</strong>
    </view>
  </view>

  <view wx:if="{{importOpen}}" class="panel import-panel">
    <view class="title-with-help import-title-row">
      <view class="title-left">
        <view class="panel-title">{{importMode === 'daily' ? '日配录入' : (importMode === 'single' ? '单条订单录入' : '微信 / LINE 订单文本')}}</view>
        <view class="help-dot" data-type="import" bindtap="showHelp">?</view>
      </view>
      <view wx:if="{{importMode === 'daily'}}" class="tap-control daily-clear-mini" bindtap="clearDailySource">清空</view>
    </view>

    <block wx:if="{{importMode === 'daily'}}">
      <textarea class="textarea daily-textarea {{dailyGroups.length ? 'parsed' : ''}}" maxlength="-1" value="{{dailySourceText}}" bindinput="onDailySourceInput" />
      <view class="daily-action-row">
        <view class="tap-control daily-action" bindtap="parseDailyText">解析</view>
        <view class="tap-control daily-action primary" bindtap="saveDailyDraft">保存草稿</view>
      </view>
      <view wx:if="{{dailyMessage}}" class="success-text daily-message">{{dailyMessage}}</view>

      <view class="daily-overview-grid">
        <view class="daily-summary-card"><text>已分配司机</text><strong>{{dailyOverview.assignedDrivers}}</strong></view>
        <view class="daily-summary-card"><text>已分配订单</text><strong>{{dailyOverview.assignedOrders}}</strong></view>
        <view class="daily-summary-card success"><text>今日空闲司机</text><strong>{{dailyOverview.idleDrivers}}/{{dailyOverview.driverTotal}}</strong></view>
        <view class="daily-summary-card success">
          <text>今日空闲车辆</text>
          <view class="daily-summary-meta"><view>10座</view><view class="daily-summary-ratio">{{dailyOverview.idleTenSeat}}/{{dailyOverview.tenSeatTotal}}</view></view>
          <view class="daily-summary-meta"><view>Alphard</view><view class="daily-summary-ratio">{{dailyOverview.idleAlphard}}/{{dailyOverview.alphardTotal}}</view></view>
        </view>
      </view>

      <view class="daily-issue-grid">
        <view class="daily-issue-card {{dailyOverview.missingDriverGroups.length ? 'warning' : 'ok'}}">
          <view class="daily-issue-title">未匹配司机</view>
          <view wx:if="{{!dailyOverview.missingDriverGroups.length}}" class="daily-issue-empty">全部已填司机</view>
          <view wx:for="{{dailyOverview.missingDriverGroups}}" wx:key="index" class="daily-issue-line" data-group-index="{{item.index}}" bindtap="focusDailyGroup">
            {{item.label}} · {{item.orderCount}} 单
          </view>
        </view>
        <view class="daily-issue-card {{dailyOverview.missingVehicleGroups.length ? 'warning' : 'ok'}}">
          <view class="daily-issue-title">未匹配车辆</view>
          <view wx:if="{{!dailyOverview.missingVehicleGroups.length}}" class="daily-issue-empty">全部已填车辆</view>
          <view wx:for="{{dailyOverview.missingVehicleGroups}}" wx:key="index" class="daily-issue-line" data-group-index="{{item.index}}" bindtap="focusDailyGroup">
            {{item.label}} · {{item.orderCount}} 单
          </view>
        </view>
      </view>

      <view wx:if="{{dailyOverview.driverNav.length}}" class="daily-driver-nav">
        <view class="daily-driver-nav-title">司机订单定位</view>
        <view class="daily-driver-chip-row">
          <view wx:for="{{dailyOverview.driverNav}}" wx:key="index" class="daily-driver-chip" data-group-index="{{item.index}}" bindtap="focusDailyGroup">
            <text>{{item.name}}</text>
            <strong>{{item.orderCount}} 单</strong>
            <em>{{item.vehicleCode}}</em>
          </view>
        </view>
      </view>

      <view class="daily-preview-head">
        <view>
          <view class="panel-title mini">分配预览</view>
          <view class="muted">可修改司机、车辆、订单内容和状态。</view>
        </view>
        <view class="tap-control daily-tool add-driver" bindtap="addDailyGroup">加司机</view>
      </view>
      <view wx:if="{{!dailyGroups.length}}" class="single-placeholder">暂无解析内容</view>
      <view wx:for="{{dailyGroups}}" wx:key="id" wx:for-index="groupIndex" id="daily-group-{{groupIndex}}" class="daily-driver-group">
        <view class="daily-group-head">
          <view class="daily-driver-meta">
            <input class="input daily-group-input driver-line" value="{{item.driverVehicleLabel}}" data-group-index="{{groupIndex}}" bindinput="onDailyDriverVehicleInput" placeholder="司机-车辆" />
            <view class="daily-order-count">{{item.orders.length}} 单</view>
          </view>
          <view class="tap-control danger-mini" data-group-index="{{groupIndex}}" bindtap="removeDailyGroup">删除</view>
        </view>

        <view class="daily-order-table">
          <view wx:for="{{item.orders}}" wx:key="id" wx:for-item="order" wx:for-index="orderIndex" class="daily-swipe-shell">
            <view class="daily-line-delete" data-group-index="{{groupIndex}}" data-order-index="{{orderIndex}}" bindtap="removeDailyOrder">删除</view>
            <view
              class="daily-order-line {{order.status === '作废' ? 'voided' : ''}} {{dailySwipeGroupIndex == groupIndex && dailySwipeOrderIndex == orderIndex ? 'swipe-open' : ''}}"
              data-group-index="{{groupIndex}}"
              data-order-index="{{orderIndex}}"
              bindtouchstart="onDailyOrderTouchStart"
              bindtouchend="onDailyOrderTouchEnd"
            >
              <view class="daily-order-index">{{order.displayIndex}}</view>
              <input class="daily-cell-input time" value="{{order.time}}" data-group-index="{{groupIndex}}" data-order-index="{{orderIndex}}" data-key="time" bindinput="onDailyOrderInput" />
              <input class="daily-cell-input" value="{{order.type}}" data-group-index="{{groupIndex}}" data-order-index="{{orderIndex}}" data-key="type" bindinput="onDailyOrderInput" />
              <input class="daily-cell-input" value="{{order.vehicleType}}" data-group-index="{{groupIndex}}" data-order-index="{{orderIndex}}" data-key="vehicleType" bindinput="onDailyOrderInput" />
              <input class="daily-cell-input route" value="{{order.route}}" data-group-index="{{groupIndex}}" data-order-index="{{orderIndex}}" data-key="route" bindinput="onDailyOrderInput" />
              <input class="daily-cell-input price" value="{{order.price}}" data-group-index="{{groupIndex}}" data-order-index="{{orderIndex}}" data-key="price" bindinput="onDailyOrderInput" />
              <input class="daily-cell-input status" value="{{order.status}}" data-group-index="{{groupIndex}}" data-order-index="{{orderIndex}}" data-key="status" bindinput="onDailyOrderInput" />
            </view>
          </view>
        </view>
        <view class="tap-control daily-add-order" data-group-index="{{groupIndex}}" bindtap="addDailyOrder">添加订单</view>
      </view>

      <view class="daily-submit-row">
        <view class="tap-control daily-submit" bindtap="saveDailyDraft">保存草稿</view>
        <view class="tap-control daily-submit primary" bindtap="publishDailyAssignments">确认导入</view>
      </view>
    </block>

    <block wx:elif="{{importMode === 'single'}}">
      <textarea
        class="textarea single-textarea"
        maxlength="-1"
        value="{{importText}}"
        bindinput="onImportText"
        placeholder="粘贴一条完整订单，先解析，再展开字段校对。"
      />
      <view class="single-action-row">
        <button class="small-button single-tool-button" bindtap="clearSingleForm">清空</button>
        <button class="small-button single-tool-button primary" loading="{{loading}}" bindtap="submitImport">解析</button>
      </view>

      <view wx:if="{{singleParsed}}" class="single-form-wrap">
        <view class="single-form-tip">
          解析完成后在这里校对字段，再保存草稿或确认入池。
        </view>
        <view class="single-form-grid">
          <view class="field">
            <view class="field-label">开始日期</view>
            <input class="input" data-field="order_date" value="{{singleForm.order_date}}" bindinput="onSingleField" placeholder="2026-06-18" />
          </view>
          <view class="field">
            <view class="field-label">结束日期</view>
            <input class="input" data-field="end_date" value="{{singleForm.end_date}}" bindinput="onSingleField" placeholder="2026-06-18" />
          </view>
          <view class="field">
            <view class="field-label">开始时间</view>
            <input class="input" data-field="start_time" value="{{singleForm.start_time}}" bindinput="onSingleField" placeholder="09:00" />
          </view>
          <view class="field">
            <view class="field-label">结束时间</view>
            <input class="input" data-field="end_time" value="{{singleForm.end_time}}" bindinput="onSingleField" />
          </view>
          <view class="field">
            <view class="field-label">类型</view>
            <input class="input" data-field="order_type" value="{{singleForm.order_type}}" bindinput="onSingleField" placeholder="接机 / 送机 / 包车" />
          </view>
          <view class="field">
            <view class="field-label">车型</view>
            <input class="input" data-field="vehicle_type" value="{{singleForm.vehicle_type}}" bindinput="onSingleField" placeholder="A-3" />
          </view>
          <view class="field field-wide">
            <view class="field-label">起点</view>
            <input class="input" data-field="pickup_location" value="{{singleForm.pickup_location}}" bindinput="onSingleField" placeholder="大阪市内 / 酒店 / 具体地址" />
          </view>
          <view class="field field-wide">
            <view class="field-label">终点</view>
            <input class="input" data-field="dropoff_location" value="{{singleForm.dropoff_location}}" bindinput="onSingleField" placeholder="KIX / KIX-T1 / 京都站" />
          </view>
          <view class="field">
            <view class="field-label">旅行社</view>
            <input class="input" data-field="agency_name" value="{{singleForm.agency_name}}" bindinput="onSingleField" />
          </view>
          <view class="field">
            <view class="field-label">客人姓名</view>
            <input class="input" data-field="guest_name" value="{{singleForm.guest_name}}" bindinput="onSingleField" />
          </view>
          <view class="field">
            <view class="field-label">联系方式</view>
            <input class="input" data-field="guest_contact" value="{{singleForm.guest_contact}}" bindinput="onSingleField" />
          </view>
          <view class="field">
            <view class="field-label">人数</view>
            <input class="input" data-field="passenger_count" value="{{singleForm.passenger_count}}" bindinput="onSingleField" placeholder="3" />
          </view>
          <view class="field">
            <view class="field-label">行李</view>
            <input class="input" data-field="luggage_count" value="{{singleForm.luggage_count}}" bindinput="onSingleField" />
          </view>
          <view class="field">
            <view class="field-label">价格</view>
            <input class="input" data-field="price" value="{{singleForm.price}}" bindinput="onSingleField" placeholder="450" />
          </view>
          <view class="field field-wide">
            <view class="field-label">备注</view>
            <textarea class="mini-textarea" data-field="remark" value="{{singleForm.remark}}" bindinput="onSingleField" placeholder="儿童座椅、语言、附加说明等" />
          </view>
        </view>

        <view class="single-submit-row">
          <button class="small-button single-submit-button" loading="{{loading}}" disabled="{{!singleDraftId || loading}}" bindtap="saveSingleDraft">保存草稿</button>
          <button class="small-button single-submit-button primary" loading="{{loading}}" disabled="{{!singleDraftId || loading}}" bindtap="confirmSingleDraft">确认入池</button>
        </view>
      </view>

      <view wx:elif="{{!loading}}" class="single-placeholder">
        先点击“解析”，解析成功后再展开下方字段校对。
      </view>
    </block>

    <block wx:else>
      <textarea
        class="textarea"
        maxlength="-1"
        value="{{importText}}"
        bindinput="onImportText"
        placeholder="粘贴微信或 LINE 订单文本，一次可批量导入 50-80 条。"
      />
      <button class="button-primary" loading="{{loading}}" bindtap="submitImport">解析并分类</button>
    </block>
  </view>

  <view wx:if="{{conflictText}}" class="conflict">{{conflictText}}</view>
  <view wx:elif="{{message}}" class="success-text">{{message}}</view>

  <view class="panel published-panel">
    <view class="section-head small">
      <view>
        <view class="panel-title">已派订单修改测试</view>
        <view class="muted">点击已发布订单，查看修改履历并保存变更通知司机。</view>
      </view>
      <view class="count-pill">{{publishedRows.length}}</view>
    </view>
    <scroll-view scroll-y class="published-scroll">
      <view wx:for="{{publishedRows}}" wx:key="assignmentId" class="published-row {{publishedEditAssignmentId == item.assignmentId ? 'selected' : ''}}" data-order-id="{{item.orderId}}" data-assignment-id="{{item.assignmentId}}" bindtap="selectPublishedOrder">
        <view class="published-main">
          <view class="published-time">{{item.displayTime}}</view>
          <view class="published-route">{{item.displayRoute}}</view>
          <view class="published-meta">{{item.displayResource}} · {{item.displayPublisher}}</view>
        </view>
        <view class="published-side">
          <view class="published-order-no">{{item.displayOrderNo}}</view>
          <view class="published-status">{{item.statusText}}</view>
        </view>
      </view>
      <view wx:if="{{!publishedRows.length}}" class="empty-line">暂无已派订单</view>
    </scroll-view>

    <view wx:if="{{publishedEditOpen}}" class="published-editor">
      <view class="published-editor-head">
        <view>
          <view class="published-editor-title">修改订单</view>
          <view class="published-editor-sub">{{publishedEditTitle}}</view>
        </view>
        <view class="tap-control daily-tool" bindtap="closePublishedEditor">关闭</view>
      </view>

      <view class="published-form-grid">
        <input class="input published-input" data-field="order_date" value="{{publishedEditForm.order_date}}" bindinput="onPublishedEditField" placeholder="开始日期" />
        <input class="input published-input" data-field="start_time" value="{{publishedEditForm.start_time}}" bindinput="onPublishedEditField" placeholder="开始时间" />
        <input class="input published-input" data-field="end_date" value="{{publishedEditForm.end_date}}" bindinput="onPublishedEditField" placeholder="结束日期" />
        <input class="input published-input" data-field="end_time" value="{{publishedEditForm.end_time}}" bindinput="onPublishedEditField" placeholder="结束时间" />
        <input class="input published-input wide" data-field="pickup_location" value="{{publishedEditForm.pickup_location}}" bindinput="onPublishedEditField" placeholder="起点" />
        <input class="input published-input wide" data-field="dropoff_location" value="{{publishedEditForm.dropoff_location}}" bindinput="onPublishedEditField" placeholder="终点" />
        <input class="input published-input" data-field="order_type" value="{{publishedEditForm.order_type}}" bindinput="onPublishedEditField" placeholder="类型" />
        <input class="input published-input" data-field="vehicle_type" value="{{publishedEditForm.vehicle_type}}" bindinput="onPublishedEditField" placeholder="车型" />
        <input class="input published-input" data-field="price" value="{{publishedEditForm.price}}" bindinput="onPublishedEditField" placeholder="价格" />
        <input class="input published-input wide" data-field="remark" value="{{publishedEditForm.remark}}" bindinput="onPublishedEditField" placeholder="备注" />
      </view>

      <view class="published-actions">
        <view class="tap-control daily-submit" bindtap="refreshPublishedHistory">刷新履历</view>
        <view class="tap-control daily-submit primary" bindtap="savePublishedOrder">保存并通知司机</view>
      </view>

      <view class="history-title">修改履历</view>
      <view wx:if="{{publishedHistoryLoading}}" class="empty-line">履历加载中...</view>
      <view wx:for="{{publishedHistoryRows}}" wx:key="id" class="history-row">
        <view class="history-dot"></view>
        <view class="history-content">
          <view class="history-top">
            <text>{{item.actorText}}</text>
            <text>{{item.timeText}}</text>
          </view>
          <view class="history-summary">{{item.title}}</view>
          <view wx:for="{{item.diffLines}}" wx:for-item="line" wx:key="key" class="history-diff">
            <text>{{line.label}}</text>
            <view>{{line.before}} → {{line.after}}</view>
          </view>
          <view wx:if="{{!item.diffLines.length}}" class="history-empty">无核心字段变化</view>
        </view>
      </view>
      <view wx:if="{{!publishedHistoryLoading && !publishedHistoryRows.length}}" class="empty-line">暂无修改履历</view>
    </view>
  </view>

  <view class="panel charter-panel">
    <view class="section-head" bindtap="toggleCharter">
      <view class="title-with-help">
        <view class="panel-title">包车</view>
        <view class="help-dot" data-type="charter" bindtap="showHelp">?</view>
      </view>
      <view class="count-pill">{{charterRows.length}} 单 · {{charterCollapsed ? '展开' : '收起'}}</view>
    </view>
    <scroll-view wx:if="{{!charterCollapsed}}" scroll-y class="charter-scroll">
      <view wx:for="{{charterRows}}" wx:key="key" class="row-shell">
        <view class="compact-row charter-row {{item.selected ? 'selected' : ''}}" data-key="{{item.key}}" bindtap="handleRowTap">
          <view class="status-dot {{item.kind === 'draft' ? 'warn' : 'ok'}}"></view>
          <view class="compact-main">
            <view class="compact-top">
              <text class="type-chip">{{item.sourceText}}</text>
              <text class="compact-no">{{item.oid}}</text>
              <text class="compact-price">{{item.priceText}}</text>
            </view>
            <view class="compact-line">{{item.timeText}} · {{item.routeText}}</view>
            <view class="compact-meta">{{item.vehicle_type || '车型待确认'}} · {{item.charterDetailText}}</view>
          </view>
        </view>
      </view>
      <view wx:if="{{!charterRows.length}}" class="empty-line">暂无包车订单</view>
    </scroll-view>
  </view>

  <view class="airport-grid">
    <view class="panel list-panel">
      <view class="section-head small">
        <view class="title-with-help">
          <view class="panel-title">接机</view>
          <view class="help-dot" data-type="pickup" bindtap="showHelp">?</view>
        </view>
        <view class="count-pill">{{pickupRows.length}}</view>
      </view>
      <scroll-view scroll-y class="airport-scroll">
        <view wx:for="{{pickupRows}}" wx:key="key" class="row-shell">
          <view class="compact-row airport-row {{item.selected ? 'selected' : ''}}" data-key="{{item.key}}" bindtap="handleRowTap">
            <view class="status-dot {{item.kind === 'draft' ? 'warn' : 'ok'}}"></view>
            <view class="compact-main">
              <view class="compact-top">
                <text class="compact-no">{{item.oid}}</text>
              </view>
              <view class="compact-line">{{item.compactTimeText}}</view>
              <view class="compact-meta">{{item.routeText}}</view>
              <view wx:if="{{item.guestSummaryText}}" class="compact-meta">{{item.guestSummaryText}}</view>
            </view>
          </view>
        </view>
        <view wx:if="{{!pickupRows.length}}" class="empty-line">暂无接机订单</view>
      </scroll-view>
    </view>

    <view class="panel list-panel">
      <view class="section-head small">
        <view class="title-with-help">
          <view class="panel-title">送机</view>
          <view class="help-dot" data-type="dropoff" bindtap="showHelp">?</view>
        </view>
        <view class="count-pill">{{dropoffRows.length}}</view>
      </view>
      <scroll-view scroll-y class="airport-scroll">
        <view wx:for="{{dropoffRows}}" wx:key="key" class="row-shell">
          <view class="compact-row airport-row {{item.selected ? 'selected' : ''}}" data-key="{{item.key}}" bindtap="handleRowTap">
            <view class="status-dot {{item.kind === 'draft' ? 'warn' : 'ok'}}"></view>
            <view class="compact-main">
              <view class="compact-top">
                <text class="compact-no">{{item.oid}}</text>
              </view>
              <view class="compact-line">{{item.compactTimeText}}</view>
              <view class="compact-meta">{{item.routeText}}</view>
              <view wx:if="{{item.guestSummaryText}}" class="compact-meta">{{item.guestSummaryText}}</view>
            </view>
          </view>
        </view>
        <view wx:if="{{!dropoffRows.length}}" class="empty-line">暂无送机订单</view>
      </scroll-view>
    </view>
  </view>

  <view class="resource-grid">
    <view class="panel resource-box">
      <view class="section-head small">
        <view class="title-with-help">
          <view class="panel-title">司机</view>
          <view class="help-dot" data-type="drivers" bindtap="showHelp">?</view>
        </view>
      </view>
      <scroll-view scroll-y class="resource-scroll">
        <view wx:for="{{drivers}}" wx:key="id" data-id="{{item.id}}" bindtap="selectDriver" class="resource-row driver-row {{item.selected ? 'selected' : ''}} {{item.disabled ? 'disabled' : ''}}">
          <view class="status-dot {{item.statusClass}}"></view>
          <text class="resource-name">{{item.displayName || item.name}}</text>
        </view>
      </scroll-view>
    </view>

    <view class="panel resource-box">
      <view class="section-head small">
        <view class="title-with-help">
          <view class="panel-title">车辆</view>
          <view class="help-dot" data-type="vehicles" bindtap="showHelp">?</view>
        </view>
      </view>
      <scroll-view scroll-y class="resource-scroll">
        <view wx:for="{{vehicles}}" wx:key="id" data-id="{{item.id}}" bindtap="selectVehicle" class="resource-row {{item.selected ? 'selected' : ''}} {{item.disabled ? 'disabled' : ''}}">
          <view class="status-dot {{item.statusClass}}"></view>
          <text class="resource-name">{{item.shortPlate || item.plate_number}}</text>
          <text class="resource-sub">{{item.vehicle_type || '-'}}/{{item.seat_count || '-'}}座</text>
        </view>
        <view wx:if="{{!vehicles.length}}" class="empty-line">暂无车辆</view>
      </scroll-view>
    </view>
  </view>

  <view wx:if="{{selectedKeys.length > 0}}" class="dispatch-preview">
    <view class="preview-info">
      <view class="preview-title">已选 {{preview.orderCount}} 单</view>
      <view class="preview-sub {{canAssign ? 'is-ready' : 'is-pending'}}">{{canAssign ? (preview.driverName + ' · ' + preview.vehicleName) : '待选择司机和车辆'}}</view>
    </view>
    <view class="preview-actions">
      <button wx:if="{{canAuction}}" class="dispatch-button hall-button" loading="{{loading}}" disabled="{{loading}}" bindtap="publishSelectedToAuction">放入大厅</button>
      <button class="dispatch-button {{canAssign ? 'ready' : 'disabled'}}" loading="{{loading}}" disabled="{{!canAssign || loading}}" bindtap="assignSelected">派车</button>
    </view>
  </view>

  <view wx:if="{{helpTip}}" class="help-mask" catchtap="hideHelp">
    <view class="help-popover" catchtap="noop">
      <view class="help-popover-head">
        <view class="help-popover-title">{{helpTip.title}}</view>
        <view class="help-close" bindtap="hideHelp">×</view>
      </view>
      <view class="help-popover-body">{{helpTip.content}}</view>
    </view>
  </view>
  </block>
</view>

<custom-tab-bar />
