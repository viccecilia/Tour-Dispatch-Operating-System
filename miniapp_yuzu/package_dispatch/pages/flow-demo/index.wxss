.demo-page { min-height: 100vh; padding: 24rpx 24rpx 88rpx; box-sizing: border-box; background: #f3f7fb; color: #10233f; }
.demo-note { margin-bottom: 16rpx; color: #64748b; font-size: 21rpx; }
.screen-tabs { display: flex; white-space: nowrap; margin: 0 -24rpx 20rpx; padding: 0 24rpx; }
.screen-tab { display: inline-flex; margin-right: 14rpx; padding: 14rpx 24rpx; border-radius: 999rpx; background: #e6edf5; color: #52657b; font-size: 25rpx; font-weight: 800; }
.screen-tab.active { background: #102f50; color: #fff; }
.hero { border-radius: 24rpx; padding: 26rpx; color: #fff; background: linear-gradient(135deg, #102f50, #08796f); box-shadow: 0 16rpx 32rpx rgba(16, 47, 80, .15); }
.notes-head { display: flex; align-items: flex-start; justify-content: space-between; margin: 4rpx 0 18rpx; padding: 8rpx 4rpx 20rpx; border-bottom: 1rpx solid #d9e1e9; }.notes-kicker { color: #64748b; font-size: 22rpx; font-weight: 800; }.notes-title { margin-top: 6rpx; font-size: 40rpx; font-weight: 950; letter-spacing: -1rpx; }.notes-meta { margin-top: 8rpx; color: #718096; font-size: 22rpx; line-height: 1.5; }.notes-status { padding: 9rpx 14rpx; border-radius: 999rpx; color: #a45a09; background: #fff1dc; font-size: 21rpx; font-weight: 900; }.notes-status.fixed { color: #087164; background: #def7f0; }.edit-tip { margin-bottom: 14rpx; padding: 16rpx 18rpx; border-radius: 14rpx; color: #795113; background: #fff7df; font-size: 23rpx; font-weight: 750; }.edit-sheet { margin-bottom: 16rpx; padding: 20rpx; border: 1rpx solid #b9d5f2; border-radius: 18rpx; background: #f3f8ff; }.driver-edit { padding: 9rpx 14rpx; border-radius: 12rpx; color: #1d5e9d; background: #e9f3ff; font-size: 22rpx; font-weight: 850; }
.success-hero { background: linear-gradient(135deg, #075d54, #149381); }.driver-hero { background: linear-gradient(135deg, #1d4e89, #276fb4); }.warning-hero { background: linear-gradient(135deg, #80420d, #c56b16); }
.hero-eyebrow { font-size: 21rpx; font-weight: 900; opacity: .76; }.hero-title { margin-top: 8rpx; font-size: 40rpx; font-weight: 950; }.hero-meta { margin-top: 10rpx; font-size: 23rpx; line-height: 1.45; opacity: .9; }
.sticky-actions { display: flex; gap: 12rpx; margin: 18rpx 0; }.mini-action { flex: 1; padding: 17rpx 8rpx; border: 1rpx solid #d6e1ec; border-radius: 14rpx; background: #fff; text-align: center; font-size: 23rpx; font-weight: 850; }.mini-action.primary { color: #fff; border-color: #0d766c; background: #0d766c; }
.driver-card, .status-card, .task-card, .report-card, .change-card { margin-top: 16rpx; padding: 22rpx; border: 1rpx solid #dbe6f0; border-radius: 20rpx; background: #fff; box-shadow: 0 8rpx 22rpx rgba(19, 53, 85, .05); }
.driver-head, .status-row, .change-line { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }.driver-name, .status-title, .task-title { font-size: 28rpx; font-weight: 950; }.vehicle, .task-meta { display: block; margin-top: 5rpx; color: #64748b; font-size: 22rpx; }.state { padding: 7rpx 14rpx; border-radius: 999rpx; font-size: 21rpx; font-weight: 850; }.state.ok, .ok, .confirmed { color: #087164; }.state.ok { background: #e2f8f2; }.state.warn, .pending { color: #a65a05; }.state.warn { background: #fff1df; }
.order-line { display: flex; gap: 12rpx; align-items: center; padding: 16rpx 0 0; font-size: 22rpx; }.time { width: 72rpx; font-weight: 900; }.type { width: 54rpx; color: #0d766c; }.route { flex: 1; }.flag { color: #64748b; font-size: 20rpx; }
.status-row, .change-line { padding-top: 16rpx; margin-top: 16rpx; border-top: 1rpx solid #edf2f7; font-size: 24rpx; }.status-row text:last-child, .change-line text:last-child { text-align: right; font-weight: 800; }.pdf-row { display: flex; gap: 12rpx; margin-top: 18rpx; }.pdf { flex: 1; padding: 18rpx 10rpx; border-radius: 12rpx; background: #f1f6fb; color: #1f4d76; text-align: center; font-size: 22rpx; font-weight: 850; }
.large-button, .small-button { margin-top: 20rpx; padding: 20rpx; border-radius: 16rpx; background: #0d766c; color: #fff; text-align: center; font-size: 27rpx; font-weight: 950; }.small-button { display: inline-block; padding: 14rpx 24rpx; font-size: 23rpx; }.large-button.warning { background: #bd6410; }.confirmed { margin-top: 20rpx; padding: 18rpx; border-radius: 14rpx; background: #e5f7f1; text-align: center; font-size: 25rpx; font-weight: 900; }
.step-row { display: flex; margin-top: 18rpx; gap: 8rpx; }.step { flex: 1; padding: 12rpx 4rpx; border-radius: 10rpx; background: #eef3f8; color: #718096; text-align: center; font-size: 20rpx; font-weight: 800; }.step.done { background: #d9f4ee; color: #087164; }.hint { margin-top: 18rpx; padding: 18rpx; border-radius: 14rpx; background: #eef6ff; color: #42617f; font-size: 23rpx; line-height: 1.5; }
.notes-bottom-space { height: 130rpx; }.notes-bottom-actions { position: fixed; right: 0; bottom: 0; left: 0; z-index: 10; display: flex; gap: 16rpx; padding: 18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom)); border-top: 1rpx solid #dbe5ef; background: rgba(255,255,255,.98); }.notes-edit, .notes-publish { flex: 1; padding: 21rpx 10rpx; border-radius: 16rpx; text-align: center; font-size: 27rpx; font-weight: 950; }.notes-edit { color: #183b61; background: #eaf1f8; }.notes-publish { color: #fff; background: #0b766b; box-shadow: 0 10rpx 20rpx rgba(11,118,107,.2); }
