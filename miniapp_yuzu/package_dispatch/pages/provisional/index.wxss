@import "../../../app.wxss";

.provisional-page { min-height: 100vh; padding: 24rpx 24rpx 160rpx; background: #f3f7fb; box-sizing: border-box; }
.provisional-hero { padding: 30rpx; border-radius: 28rpx; color: #fff; background: linear-gradient(135deg,#0f4c5c,#138a7e); box-shadow: 0 18rpx 40rpx rgba(15,76,92,.18); }
.eyebrow { font-size: 18rpx; font-weight: 900; letter-spacing: 3rpx; opacity: .76; }
.title { margin-top: 8rpx; font-size: 38rpx; font-weight: 900; }
.subtitle { margin-top: 10rpx; font-size: 23rpx; line-height: 1.55; opacity: .9; }
.summary-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:12rpx; margin-top:18rpx; }
.summary-grid>view { padding:20rpx; border-radius:20rpx; background:#fff; border:1rpx solid #dce7ef; display:flex; flex-direction:column; }
.summary-grid strong { color:#143b4a; font-size:32rpx; }.summary-grid text { color:#718494; font-size:20rpx; }.summary-grid .warn strong{color:#b45309;}
.toolbar { display:flex; align-items:center; gap:16rpx; margin:20rpx 0; }.unsynced{color:#b45309;font-size:22rpx;font-weight:800;}
button { margin:0; border-radius:18rpx; font-size:24rpx; font-weight:800; }
button.primary,.primary { color:#fff; background:#0f8a7b; }.secondary{color:#0f766e;background:#e7f7f4;border:1rpx solid #9bd4cb;}.danger{color:#b91c1c;background:#fff1f2;}.full{width:100%;margin-top:18rpx;}
.message { margin:16rpx 0; padding:16rpx 20rpx; border-radius:16rpx; color:#075985; background:#e0f2fe; font-size:22rpx; }.message.warning{color:#92400e;background:#fff7ed;}
.task-list { display:flex; flex-direction:column; gap:14rpx; margin-top:20rpx; }.task-card{padding:22rpx;border-radius:22rpx;background:#fff;border:1rpx solid #dce7ef;box-shadow:0 8rpx 20rpx rgba(38,63,78,.05);}.task-head{display:flex;justify-content:space-between;gap:14rpx;}.task-head>view:first-child{display:flex;flex-direction:column;}.task-head strong{color:#163e4d;font-size:26rpx;}.task-head text,.meta{color:#7b8f9d;font-size:20rpx;}.route{margin-top:14rpx;color:#203946;font-size:25rpx;font-weight:800;}.meta{margin-top:8rpx;}.status{padding:7rpx 12rpx;border-radius:999rpx;background:#eef4f7;color:#526a78;font-size:19rpx;font-weight:800;align-self:flex-start;}.status-pending_company_confirmation{background:#fff7d6;color:#92400e;}.status-needs_information{background:#fff1f2;color:#be123c;}.status-approved_new_order,.status-approved_linked_order{background:#dcfce7;color:#166534;}.empty{padding:100rpx 20rpx;text-align:center;color:#8699a5;}
.editor{margin-top:20rpx;padding:24rpx;border-radius:24rpx;background:#fff;border:1rpx solid #dce7ef;}.editor-head{display:flex;justify-content:space-between;align-items:flex-start;gap:16rpx;border-bottom:1rpx solid #edf2f5;padding-bottom:18rpx;}.editor-head>view:first-child{display:flex;flex-direction:column;}.editor-head strong{color:#163e4d;font-size:28rpx;}.editor-head text{color:#718493;font-size:21rpx;}.close{color:#0f766e;font-size:23rpx;font-weight:800;}
.form-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16rpx;margin-top:20rpx;}.form-grid label,.review-box label{display:flex;flex-direction:column;gap:7rpx;min-width:0;}.form-grid label>text,.review-box label>text{color:#526a78;font-size:20rpx;font-weight:700;}.form-grid .wide{grid-column:1/-1;}.input,.textarea{width:100%;box-sizing:border-box;border:1rpx solid #cad9e2;border-radius:16rpx;background:#f8fbfd;color:#173945;font-size:23rpx;padding:17rpx;}.textarea{height:128rpx;line-height:1.5;}
.actions{display:grid;grid-template-columns:1fr 1.4fr;gap:12rpx;margin-top:22rpx;}.sticky-actions{position:sticky;bottom:16rpx;padding:14rpx;background:rgba(255,255,255,.95);border-radius:22rpx;box-shadow:0 -8rpx 24rpx rgba(34,67,82,.1);}.readonly-note,.unknown-note{margin-top:18rpx;padding:16rpx;border-radius:14rpx;background:#f1f5f9;color:#64748b;font-size:21rpx;line-height:1.5;}
.history,.review-box,.pricing-box,.fact-sheet{margin-top:22rpx;padding:20rpx;border-radius:20rpx;background:#f8fbfd;border:1rpx solid #dce7ef;}.section-title{color:#17424e;font-size:24rpx;font-weight:900;}.event{display:flex;flex-direction:column;gap:4rpx;padding:14rpx 0;border-bottom:1rpx solid #e6edf1;}.event:last-child{border-bottom:0}.event strong{font-size:21rpx;color:#244956;}.event text{font-size:19rpx;color:#768a96;}.fact-sheet>view{padding:13rpx 0;border-bottom:1rpx solid #e7eef2;display:flex;flex-direction:column;gap:4rpx;}.fact-sheet text{color:#768a96;font-size:19rpx;}.fact-sheet strong{color:#1b3b46;font-size:22rpx;word-break:break-all;}
.review-box{display:flex;flex-direction:column;gap:16rpx;}.review-actions{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12rpx;}.pricing-box{background:#f0fdfa;border-color:#b8e4dc;}
