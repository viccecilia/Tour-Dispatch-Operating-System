@import "../../../app.wxss";

.info-hero {
  background: linear-gradient(135deg, #0f766e 0%, #14b8a6 100%);
  box-shadow: 0 18rpx 42rpx rgba(20, 184, 166, 0.22);
}

.info-tabs {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
  margin-top: 18rpx;
}

.info-tab {
  min-height: 132rpx;
  box-sizing: border-box;
  padding: 18rpx;
  border: 1rpx solid var(--c-border);
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: var(--shadow-card);
}

.info-tab.active {
  border-color: #0f766e;
  background: linear-gradient(180deg, #ecfdf5 0%, #ffffff 100%);
  box-shadow: 0 14rpx 30rpx rgba(15, 118, 110, 0.16);
}

.info-tab text {
  display: block;
  color: var(--c-muted);
  font-size: 22rpx;
  font-weight: 850;
}

.info-tab strong {
  display: block;
  margin-top: 8rpx;
  color: #0f766e;
  font-size: 42rpx;
  font-weight: 950;
  line-height: 1;
}

.info-tab view {
  margin-top: 10rpx;
  color: #64748b;
  font-size: 21rpx;
  font-weight: 750;
  line-height: 1.35;
}

.office-filter-tabs {
  display: flex;
  gap: 10rpx;
  margin-top: 14rpx;
}

.office-filter {
  flex: 1;
  min-height: 58rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  background: #ffffff;
  border: 1rpx solid #dbe7f5;
  color: #475569;
  box-shadow: 0 8rpx 18rpx rgba(15, 23, 42, 0.05);
}

.office-filter.active {
  border-color: #0f766e;
  background: #ecfdf5;
  color: #0f766e;
  box-shadow: inset 0 0 0 1rpx rgba(15, 118, 110, 0.08);
}

.office-filter text {
  font-size: 22rpx;
  font-weight: 900;
}

.driver-filter-tabs {
  display: flex;
  gap: 10rpx;
  margin-top: 10rpx;
}

.driver-filter {
  flex: 1;
  min-height: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  background: #ffffff;
  border: 1rpx solid #dbe7f5;
  color: #475569;
}

.driver-filter.active {
  border-color: #2563eb;
  background: #eff6ff;
  color: #1d4ed8;
  box-shadow: inset 0 0 0 1rpx rgba(37, 99, 235, 0.08);
}

.driver-filter text {
  font-size: 21rpx;
  font-weight: 900;
}

.resource-filter-bar {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
  margin-top: 16rpx;
}

.resource-filter-bar picker {
  min-width: 0;
}

.resource-filter-select {
  min-height: 66rpx;
  box-sizing: border-box;
  display: grid;
  grid-template-columns: auto minmax(0, 1fr) 28rpx;
  align-items: center;
  gap: 12rpx;
  padding: 0 18rpx 0 20rpx;
  border-radius: 20rpx;
  background: linear-gradient(180deg, #ffffff 0%, #f8fbff 100%);
  border: 1rpx solid #dbe7f5;
  box-shadow: 0 8rpx 18rpx rgba(15, 23, 42, 0.04);
}

.resource-filter-select text {
  color: #64748b;
  font-size: 21rpx;
  font-weight: 700;
  line-height: 1;
}

.resource-filter-select strong {
  min-width: 0;
  color: #0f172a;
  font-size: 24rpx;
  font-weight: 850;
  line-height: 1;
  text-align: center;
}

.resource-filter-select view {
  width: 28rpx;
  height: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  background: #eff6ff;
  color: #2563eb;
  font-size: 18rpx;
  font-weight: 900;
}

.info-panel {
  margin-top: 18rpx;
}

.alert-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 12rpx;
  margin-top: 16rpx;
}

.alert-card {
  box-sizing: border-box;
  padding: 18rpx;
  border-radius: 24rpx;
  border: 1rpx solid #dbe7f5;
  background: #ffffff;
  box-shadow: var(--shadow-card);
}

.alert-card.vehicle {
  border-color: #bfdbfe;
  background: linear-gradient(180deg, #eff6ff 0%, #ffffff 100%);
}

.alert-card.inspection {
  border-color: #99f6e4;
  background: linear-gradient(180deg, #ecfdf5 0%, #ffffff 100%);
}

.alert-card.health {
  border-color: #fed7aa;
  background: linear-gradient(180deg, #fff7ed 0%, #ffffff 100%);
}

.alert-title {
  color: #475569;
  font-size: 22rpx;
  font-weight: 900;
}

.alert-number {
  margin-top: 6rpx;
  color: #0f172a;
  font-size: 42rpx;
  font-weight: 950;
  line-height: 1;
}

.alert-list {
  display: grid;
  gap: 8rpx;
  margin-top: 12rpx;
}

.alert-row {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  gap: 4rpx 12rpx;
  align-items: center;
  padding: 10rpx 12rpx;
  border-radius: 14rpx;
  background: rgba(255, 255, 255, 0.78);
  border: 1rpx solid #e2e8f0;
}

.alert-row text {
  min-width: 0;
  color: #0f172a;
  font-size: 22rpx;
  font-weight: 900;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.alert-row strong {
  color: #0f766e;
  font-size: 21rpx;
  font-weight: 950;
}

.alert-row.warning strong {
  color: #d97706;
}

.alert-row.danger strong {
  color: #dc2626;
}

.alert-row view {
  grid-column: 1 / -1;
  color: #64748b;
  font-size: 19rpx;
  font-weight: 750;
}

.alert-empty {
  margin-top: 10rpx;
  color: #64748b;
  font-size: 21rpx;
  font-weight: 800;
}

.info-search {
  height: 82rpx;
  margin-top: 18rpx;
  padding: 0 24rpx;
  border-radius: 22rpx;
  font-size: 26rpx;
  font-weight: 800;
}

.info-list {
  margin-top: 14rpx;
}

.info-row {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #edf2f7;
}

.info-row.driver {
  padding: 18rpx 14rpx;
  margin-bottom: 8rpx;
  border: 1rpx solid transparent;
  border-radius: 18rpx;
}

.info-row.driver.expanded {
  border-color: #93c5fd;
  background: #f8fbff;
  box-shadow: inset 0 0 0 1rpx rgba(37, 99, 235, 0.06);
}

.info-row:last-child {
  border-bottom: 0;
}

.info-row-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.info-row-actions {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  justify-content: flex-end;
  flex-wrap: wrap;
  gap: 8rpx;
}

.status-pill {
  min-width: 86rpx;
  box-sizing: border-box;
  padding: 7rpx 12rpx;
  border-radius: 999rpx;
  background: #ecfdf5;
  color: #047857;
  border: 1rpx solid #99f6e4;
  text-align: center;
  font-size: 20rpx;
  font-weight: 950;
}

.status-pill.maintenance,
.status-pill.resting {
  background: #fff7ed;
  color: #c2410c;
  border-color: #fed7aa;
}

.status-pill.retired {
  background: #fef2f2;
  color: #dc2626;
  border-color: #fecaca;
}

.expand-mark {
  flex: 0 0 auto;
  min-width: 72rpx;
  padding: 6rpx 12rpx;
  border-radius: 999rpx;
  background: #eff6ff;
  color: #1d4ed8;
  text-align: center;
  font-size: 20rpx;
  font-weight: 900;
}

.info-body {
  margin-top: 8rpx;
  color: #475569;
  font-size: 22rpx;
  font-weight: 750;
  line-height: 1.45;
}

.driver-health-edit {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 12rpx;
  padding: 12rpx 14rpx;
  border-radius: 16rpx;
  background: #f8fafc;
  border: 1rpx solid #e2e8f0;
}

.driver-health-edit text {
  display: block;
  color: #64748b;
  font-size: 20rpx;
  font-weight: 800;
}

.driver-health-edit strong {
  display: block;
  margin-top: 2rpx;
  color: #0f172a;
  font-size: 24rpx;
  font-weight: 900;
}

.driver-health-actions {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex: 0 0 auto;
}

.health-edit-button {
  min-width: 132rpx;
  box-sizing: border-box;
  padding: 12rpx 18rpx;
  border-radius: 999rpx;
  background: #0f766e;
  color: #ffffff;
  text-align: center;
  font-size: 22rpx;
  font-weight: 900;
}

.health-upload-button {
  min-width: 132rpx;
  box-sizing: border-box;
  padding: 12rpx 18rpx;
  border-radius: 999rpx;
  background: #e0f2fe;
  color: #075985;
  text-align: center;
  font-size: 22rpx;
  font-weight: 900;
}

.doc-count {
  flex: 0 0 auto;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: #e0f2fe;
  color: #0369a1;
  font-size: 20rpx;
  font-weight: 900;
}

.info-field-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 10rpx;
  margin-top: 14rpx;
}

.info-field {
  min-width: 0;
  box-sizing: border-box;
  border-radius: 16rpx;
  padding: 12rpx;
  background: #f8fafc;
  border: 1rpx solid #e2e8f0;
}

.info-field text {
  display: block;
  color: #64748b;
  font-size: 20rpx;
  font-weight: 800;
}

.info-field strong {
  display: block;
  margin-top: 4rpx;
  color: #0f172a;
  font-size: 22rpx;
  font-weight: 900;
  line-height: 1.35;
  word-break: break-all;
}

.doc-section {
  margin-top: 16rpx;
  border-radius: 18rpx;
  background: #f8fafc;
  border: 1rpx solid #e2e8f0;
  overflow: hidden;
}

.doc-group {
  padding: 14rpx;
  border-bottom: 1rpx solid #e2e8f0;
}

.doc-group:last-child {
  border-bottom: 0;
}

.doc-group-title {
  color: #0f172a;
  font-size: 22rpx;
  font-weight: 900;
}

.doc-group-title text {
  margin-left: 8rpx;
  color: #0f766e;
}

.doc-files {
  margin-top: 10rpx;
}

.doc-file {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  gap: 6rpx 14rpx;
  align-items: center;
  padding: 12rpx 0;
  border-top: 1rpx solid #edf2f7;
}

.doc-file:first-child {
  border-top: 0;
}

.doc-name {
  min-width: 0;
  color: #0f172a;
  font-size: 22rpx;
  font-weight: 850;
  line-height: 1.35;
  word-break: break-all;
}

.doc-meta {
  grid-column: 1;
  color: #64748b;
  font-size: 19rpx;
  font-weight: 750;
}

.doc-action {
  grid-row: 1 / span 2;
  grid-column: 2;
  padding: 10rpx 16rpx;
  border-radius: 14rpx;
  background: #0f766e;
  color: #ffffff;
  font-size: 21rpx;
  font-weight: 900;
}

/* Compact resource ledger layout */
