  border-radius: 14rpx;
}

.health-edit-button,
.health-upload-button {
  min-width: 120rpx;
  padding: 11rpx 16rpx;
  font-size: 21rpx;
  font-weight: 800;
}

.info-field-grid {
  grid-template-columns: 1fr 1fr;
  gap: 10rpx;
}

.info-field {
  padding: 12rpx;
  border-radius: 14rpx;
  background: #f8fbff;
}

.info-field text {
  color: #66758a;
  font-size: 20rpx;
  font-weight: 700;
}

.info-field strong {
  color: #10233f;
  font-size: 23rpx;
  font-weight: 850;
  line-height: 1.35;
}

.alert-card {
  border-radius: 18rpx;
  box-shadow: 0 8rpx 20rpx rgba(16, 35, 63, 0.05);
}

.alert-title {
  color: #10233f;
  font-size: 24rpx;
}

.alert-number {
  font-size: 40rpx;
}

.alert-row {
  padding: 12rpx 14rpx;
  border-radius: 12rpx;
}

.empty-state {
  min-height: 140rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #66758a;
  font-size: 23rpx;
  font-weight: 700;
}

@media (max-width: 340px) {
  .info-tab {
    padding: 16rpx 14rpx;
  }

  .info-tab-value {
    font-size: 40rpx;
  }

  .panel-title {
    font-size: 30rpx;
  }

  .row-title {
    font-size: 28rpx;
  }

  .status-pill,
  .expand-mark,
  .doc-count {
    min-width: 56rpx;
    padding: 0 10rpx;
    font-size: 19rpx;
  }
}

/* Resource summary landing surface */
.info-page .info-hero {
  position: relative;
  min-height: 170rpx;
  padding: 28rpx 30rpx;
  overflow: hidden;
  border-radius: 22rpx;
  background:
    radial-gradient(circle at 90% 14%, rgba(255, 255, 255, 0.28) 0, rgba(255, 255, 255, 0.28) 68rpx, transparent 70rpx),
    linear-gradient(135deg, #06234a 0%, #00a98f 100%);
  box-shadow: 0 22rpx 44rpx rgba(6, 35, 74, 0.2);
}

.info-page .hero-eyebrow {
  color: rgba(255, 255, 255, 0.72);
  font-size: 22rpx;
  font-weight: 900;
  line-height: 1;
}

.info-page .hero-title {
  margin-top: 12rpx;
  color: #ffffff;
  font-size: 46rpx;
  font-weight: 950;
  line-height: 1.08;
}

.info-page .hero-meta {
  max-width: 560rpx;
  margin-top: 12rpx;
  color: rgba(255, 255, 255, 0.92);
  font-size: 24rpx;
  font-weight: 750;
  line-height: 1.45;
}

.info-page .info-tabs {
  margin-top: 18rpx;
  gap: 14rpx;
}

.info-page .info-tab {
  min-height: 128rpx;
  padding: 18rpx 18rpx 16rpx 22rpx;
  border-radius: 20rpx;
  border-color: #e3eaf1;
  background:
    linear-gradient(90deg, rgba(0, 169, 143, 0.1) 0, rgba(0, 169, 143, 0.1) 8rpx, transparent 8rpx),
    #ffffff;
}

.info-page .info-tab.active {
  border-color: #00a98f;
  background:
    linear-gradient(90deg, #00a98f 0, #00a98f 8rpx, transparent 8rpx),
    linear-gradient(180deg, #f0fdfa 0%, #ffffff 100%);
}

.info-page .info-tab-label {
  color: #334155;
  font-size: 23rpx;
  font-weight: 850;
}

.info-page .info-tab-value {
  margin-top: 8rpx;
  color: #008f7e;
  font-size: 44rpx;
  font-weight: 950;
}

.info-page .info-tab-meta {
  color: #66758a;
  font-size: 20rpx;
  font-weight: 750;
}

.info-page .resource-filter-bar {
  margin-top: 16rpx;
}

.info-page .resource-filter-select {
  min-height: 62rpx;
  border-color: #d8e2ee;
  background: #ffffff;
}

.info-page .info-panel {
  margin-top: 18rpx;
  padding: 24rpx 24rpx 22rpx;
  border-radius: 22rpx;
}

.info-page .panel-header-lite {
  padding-bottom: 14rpx;
  border-bottom: 1rpx solid #edf2f7;
}

.info-page .panel-title {
  font-size: 34rpx;
}

.info-page .info-search {
  margin-top: 18rpx;
  background: #f8fbff;
}

/* Polished ledger rows for vehicle / driver resources */
.info-page .info-list {
  margin-top: 16rpx;
}

.info-page .info-row.vehicle,
.info-page .info-row.driver {
  min-height: 118rpx;
  margin: 10rpx 0;
  padding: 18rpx 16rpx;
  border: 1rpx solid #e1e9f2;
  border-radius: 18rpx;
  background: linear-gradient(180deg, #ffffff 0%, #fbfdff 100%);
  box-shadow: 0 8rpx 20rpx rgba(16, 35, 63, 0.045);
}

.info-page .info-row.vehicle.expanded,
.info-page .info-row.driver.expanded {
  border-color: #93c5fd;
  background: linear-gradient(180deg, #f8fbff 0%, #ffffff 100%);
  box-shadow: 0 10rpx 24rpx rgba(52, 120, 246, 0.12);
}

.info-page .info-row-head {
  align-items: flex-start;
}

.info-page .info-row-head > view:first-child {
  min-width: 0;
}

.info-page .row-title {
  color: #10233f;
  font-size: 29rpx;
  font-weight: 950;
  line-height: 1.22;
  letter-spacing: 0;
}

.info-page .info-row.vehicle .row-title {
  font-size: 30rpx;
}

.info-page .info-row .muted {
  margin-top: 7rpx;
  color: #51657d;
  font-size: 21rpx;
  font-weight: 750;
  line-height: 1.35;
}

.info-page .info-body {
  margin-top: 10rpx;
  padding: 10rpx 12rpx;
  border-radius: 12rpx;
  background: #f4f8fc;
  color: #334155;
  font-size: 20rpx;
  font-weight: 750;
  line-height: 1.45;
}

.info-page .info-row-actions {
  flex-direction: column;
  align-items: flex-end;
  gap: 8rpx;
}

.info-page .status-pill,
.info-page .expand-mark,
.info-page .doc-count {
  min-width: 64rpx;
  height: 34rpx;
  padding: 0 13rpx;
  font-size: 19rpx;
}

.info-page .doc-count {
  background: #e0f2fe;
  color: #0f76bc;
}

.info-page .expand-mark {
  background: #eef6ff;
  color: #2563eb;
}

.info-page .driver-health-edit,
.info-page .vehicle-maintenance-edit {
  margin-top: 12rpx;
  border-radius: 16rpx;
  background: #f8fbff;
}

.info-page .health-edit-button,
.info-page .health-upload-button {
  color: #ffffff;
  background: #008f7e;
}

.info-page .row-title-line {
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.info-page .row-title-line picker {
  flex: 0 0 auto;
}

.info-page .status-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 999rpx;
  background: #16a66a;
  box-shadow: 0 0 0 5rpx rgba(22, 166, 106, 0.12);
}

.info-page .status-dot.resting {
  background: #f59e0b;
  box-shadow: 0 0 0 5rpx rgba(245, 158, 11, 0.14);
}

.info-page .status-dot.retired {
  background: #e5484d;
  box-shadow: 0 0 0 5rpx rgba(229, 72, 77, 0.13);
}

.info-page .info-row.driver .info-row-actions {
  min-width: 72rpx;
  align-items: flex-end;
}
