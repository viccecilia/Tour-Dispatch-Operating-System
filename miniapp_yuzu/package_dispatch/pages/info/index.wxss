}

.expand-mark,
.doc-count {
  min-width: 58rpx;
  padding: 6rpx 10rpx;
  font-size: 18rpx;
  font-weight: 850;
}

.info-body {
  margin-top: 6rpx;
  font-size: 20rpx;
  font-weight: 650;
}

.driver-health-edit,
.info-field-grid,
.doc-section {
  margin-top: 10rpx;
}

/* Mobile resource overview polish */
