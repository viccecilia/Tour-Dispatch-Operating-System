@import "../../../app.wxss";

.actual-pending-banner { display:flex; align-items:center; justify-content:space-between; gap:16rpx; color:#92400e; background:#fff7ed; border-color:#fed7aa; }
.actual-pending-banner>view:first-child{display:flex;flex-direction:column;gap:4rpx}.actual-pending-banner strong{font-size:24rpx}.actual-pending-banner text{font-size:20rpx}.actual-pending-banner .retry{font-size:22rpx;font-weight:900;color:#c2410c;}
.actual-editor{margin-top:18rpx;padding:18rpx;border-radius:20rpx;background:#f7fbfd;border:1rpx solid #d5e3ea;}.actual-editor-head{display:flex;align-items:flex-start;justify-content:space-between;gap:12rpx}.actual-editor-head>view:first-child{display:flex;flex-direction:column;gap:4rpx}.actual-editor-head strong{font-size:24rpx;color:#173f4d}.actual-editor-head text{font-size:19rpx;color:#718793}.actual-sync{color:#0f766e;font-size:19rpx;font-weight:800;white-space:nowrap}.actual-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12rpx;margin-top:16rpx}.actual-grid label{display:flex;flex-direction:column;gap:6rpx;min-width:0}.actual-grid label>text{font-size:19rpx;font-weight:800;color:#4f6774}.actual-grid input{width:100%;box-sizing:border-box;padding:14rpx 12rpx;border:1rpx solid #c8d8e1;border-radius:14rpx;background:#fff;font-size:21rpx;color:#173945}.actual-save{margin-top:16rpx;width:100%;color:#fff;background:#0f8a7b;border-radius:16rpx;font-size:23rpx;font-weight:900}.actual-unavailable{margin-top:14rpx;padding:14rpx;border-radius:14rpx;background:#eef2f6;color:#64748b;font-size:20rpx;line-height:1.45}

.task-page {
  padding-bottom: 150rpx;
}

.calendar-panel {
  margin-top: 20rpx;
  padding: 24rpx;
}

.calendar-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-bottom: 14rpx;
}

.calendar-actions {
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  justify-content: flex-end;
}

.month-toggle {
  flex: 0 0 auto;
  width: 108rpx;
  min-width: 108rpx;
  max-width: 108rpx;
  height: 48rpx;
  margin: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  border: 0;
  padding: 0 12rpx;
  border-radius: 999rpx;
  background: var(--c-primary);
  color: #ffffff;
  font-size: 20rpx;
  font-weight: 900;
  line-height: 48rpx;
}

.month-toggle::after {
  border: 0;
}

.calendar-month-title {
  color: #0f172a;
  font-size: 32rpx;
  font-weight: 950;
  line-height: 1.1;
  white-space: nowrap;
}

.month-pick-hint {
  display: none;
}

.week-strip {
  width: 100%;
  white-space: nowrap;
  margin-top: 12rpx;
}

.week-row {
  display: inline-flex;
  flex-wrap: nowrap;
  gap: 8rpx;
  min-width: 100%;
  padding: 2rpx 0 4rpx;
}

.day-pill {
  flex: 0 0 86rpx;
  width: 86rpx;
  min-height: 94rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  box-sizing: border-box;
  padding: 10rpx 6rpx;
  border: 1rpx solid var(--c-border);
  border-radius: 18rpx;
  background: #ffffff;
  color: var(--c-text);
  text-align: center;
  box-shadow: var(--shadow-card);
}

.day-pill.active {
  border-color: #0f766e;
  background: #ecfdf5;
  box-shadow: 0 12rpx 24rpx rgba(15, 118, 110, 0.14);
}

.day-pill.today {
  border-color: #67e8f9;
}

.day-pill.holiday .day-week,
.day-pill.holiday .day-num {
  color: #dc2626;
}

.day-pill.holiday.active .day-week,
.day-pill.holiday.active .day-num {
  color: #991b1b;
}

.day-week {
  color: var(--c-muted);
  font-size: 18rpx;
  font-weight: 850;
}

.day-num {
  margin-top: 4rpx;
  font-size: 30rpx;
  font-weight: 950;
}

.day-count {
  align-self: center;
  min-width: 30rpx;
  height: 30rpx;
  margin-top: 6rpx;
  padding: 0 8rpx;
  border-radius: 999rpx;
  background: #dcfce7;
  color: #15803d;
  font-size: 18rpx;
  font-weight: 900;
  display: flex;
  align-items: center;
  justify-content: center;
}

.month-grid {
  display: grid;
  grid-template-columns: repeat(7, minmax(0, 1fr));
  gap: 8rpx;
  margin-top: 18rpx;
}

.month-week-label {
  height: 34rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--c-muted);
  font-size: 19rpx;
  font-weight: 900;
}

.month-week-label.holiday {
  color: #dc2626;
}

.month-day {
  position: relative;
  min-height: 86rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  border: 1rpx solid var(--c-border);
  border-radius: 18rpx;
  background: #ffffff;
  color: #0f172a;
  font-size: 25rpx;
  font-weight: 950;
  box-shadow: var(--shadow-card);
}

.month-day.empty {
  background: transparent;
  border: 0;
  box-shadow: none;
}

.month-day.has-task {
  border-color: #bbf7d0;
  background: #f0fdf4;
}

.month-day.holiday {
  border-color: #f4cccc;
}

.month-day.holiday .month-day-number {
  color: #dc2626;
}

.month-day.active {
  border-color: #0f766e;
  background: #0f766e;
  color: #ffffff;
  box-shadow: 0 12rpx 24rpx rgba(15, 118, 110, 0.16);
}

.month-day.active .month-day-number {
  color: #ffffff;
}

.month-dot {
  position: absolute;
  right: 8rpx;
  bottom: 8rpx;
  min-width: 30rpx;
  height: 30rpx;
  line-height: 30rpx;
  padding: 0 8rpx;
  border-radius: 999rpx;
  background: #dcfce7;
  color: #15803d;
  font-size: 18rpx;
  font-weight: 950;
}

.month-day.active .month-dot {
  background: rgba(255, 255, 255, 0.22);
  color: #ffffff;
}

.yard-panel {
  border: 2rpx solid #99f6e4;
  background: linear-gradient(180deg, #ffffff 0%, #f0fdfa 100%);
}

.preflight-panel {
  border-color: #5eead4;
}

.return-panel {
  border-color: #99f6e4;
}

.form-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin-top: 20rpx;
}

.form-field {
  min-width: 0;
}

.form-label {
  display: block;
  margin-bottom: 8rpx;
  color: var(--c-muted);
  font-size: 22rpx;
  font-weight: 850;
}

.form-input {
  height: 78rpx;
  box-sizing: border-box;
  padding: 0 20rpx;
  border: 1rpx solid #cdeee8;
  border-radius: 22rpx;
  background: #ffffff;
  color: var(--c-text);
  font-size: 28rpx;
  font-weight: 900;
}

.check-list {
  display: grid;
  grid-template-columns: 1fr;
  gap: 10rpx;
  margin-top: 20rpx;
}

.check-row {
  min-height: 70rpx;
  display: flex;
  align-items: center;
  gap: 14rpx;
  box-sizing: border-box;
  padding: 14rpx 16rpx;
  border: 1rpx solid #cdeee8;
  border-radius: 20rpx;
  background: #ffffff;
  color: var(--c-text);
  font-size: 25rpx;
  font-weight: 850;
}

.check-dot {
  width: 28rpx;
  height: 28rpx;
  border-radius: 999rpx;
  border: 4rpx solid #cbd5e1;
  box-sizing: border-box;
  background: #ffffff;
}

.check-dot.checked {
  border-color: #10b981;
  background: #10b981;
  box-shadow: 0 0 0 8rpx rgba(16, 185, 129, 0.12);
}

.yard-material-list {
  display: grid;
  gap: 10rpx;
  margin-top: 18rpx;
}

.yard-material-row {
  min-height: 78rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  box-sizing: border-box;
  padding: 14rpx 16rpx;
  border: 1rpx solid #cdeee8;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.86);
}

.yard-material-title {
  color: #0f172a;
  font-size: 24rpx;
  font-weight: 950;
}

.yard-material-file {
  max-width: 350rpx;
  margin-top: 4rpx;
  color: #64748b;
  font-size: 20rpx;
  font-weight: 800;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.yard-material-actions {
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.yard-material-upload,
.yard-material-clear {
  min-width: 64rpx;
  height: 42rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  padding: 0 14rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  font-weight: 900;
}

.yard-material-upload {
  background: #ecfdf5;
  color: #0f766e;
}

.yard-material-clear {
  background: #fff1f2;
  color: #e11d48;
}

.task-primary {
  width: 320rpx;
  height: 86rpx;
  line-height: normal;
  margin: 22rpx auto 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 26rpx;
  background: linear-gradient(135deg, #0f766e 0%, #14b8a6 100%);
  color: #ffffff;
  font-size: 29rpx;
  font-weight: 950;
  box-shadow: 0 16rpx 32rpx rgba(20, 184, 166, 0.20);
}

.task-primary.return {
  background: linear-gradient(135deg, #0f766e 0%, #14b8a6 100%);
  box-shadow: 0 16rpx 32rpx rgba(20, 184, 166, 0.20);
}

.task-primary::after {
  border: 0;
}

.daily-report-panel {
  border-color: #bae6fd;
  background: linear-gradient(180deg, #ffffff 0%, #f0f9ff 100%);
}

.daily-report-card {
  margin-top: 16rpx;
}

.form-textarea {
  width: 100%;
  min-height: 132rpx;
  box-sizing: border-box;
  padding: 18rpx;
  border: 1rpx solid #bfdbfe;
  border-radius: 18rpx;
  background: #ffffff;
  color: #0f172a;
  font-size: 25rpx;
  line-height: 1.55;
}

.daily-report-rest {
  margin-top: 14rpx;
}

.daily-report-actions {
  display: flex;
  gap: 14rpx;
  margin-top: 16rpx;
}

.task-secondary,
.task-primary.compact {
  flex: 1;
  width: auto;
  height: 72rpx;
  margin: 0;
  border-radius: 18rpx;
  font-size: 25rpx;
}

.task-secondary {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #ffffff;
  color: #0f766e;
  border: 1rpx solid #99f6e4;
  font-weight: 900;
}

.task-secondary::after {
  border: 0;
}

.task-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-top: 18rpx;
}

.ready-panel {
  border-color: #bae6fd;
  background: linear-gradient(180deg, #ffffff 0%, #f0f9ff 100%);
}

.ready-list {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  margin-top: 16rpx;
}

.ready-card {
  padding: 16rpx 18rpx;
  border: 1rpx solid #dbeafe;
  border-radius: 20rpx;
  background: #ffffff;
}

.ready-time,
.task-time {
  color: #0f172a;
  font-size: 27rpx;
  font-weight: 950;
  line-height: 1.32;
  word-break: break-all;
}

.ready-route,
.task-route-head {
  margin-top: 6rpx;
  color: #0f172a;
  font-size: 25rpx;
  font-weight: 900;
  line-height: 1.4;
  word-break: break-all;
}

.task-order-no {
  display: inline-flex;
  max-width: 100%;
  margin-top: 8rpx;
  padding: 3rpx 10rpx;
  border-radius: 999rpx;
  background: #eef6ff;
  color: #64748b;
  font-size: 19rpx;
  font-weight: 800;
  line-height: 1.35;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.task-card {
  padding: 18rpx;
  border: 1rpx solid var(--c-border);
  border-radius: 24rpx;
  background: #f8fafc;
}

.task-card.expanded {
  border-color: #14b8a6;
  background: linear-gradient(180deg, #f0fdfa 0%, #ffffff 100%);
}

.task-card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.task-main {
  min-width: 0;
  flex: 1;
}

.run-doc-list { margin-top: 16rpx; }
.run-doc-row { display: flex; align-items: center; justify-content: space-between; gap: 18rpx; padding: 18rpx 0; border-top: 1rpx solid #e2e8f0; }
.run-doc-title { color: var(--c-text); font-size: 25rpx; font-weight: 900; }
.run-doc-open { flex: 0 0 auto; padding: 10rpx 18rpx; border-radius: 999rpx; background: #e0f2fe; color: #0369a1; font-size: 22rpx; font-weight: 900; }

.task-detail {
  margin-top: 14rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid #dbeafe;
}

.task-route {
  color: var(--c-text);
  font-size: 25rpx;
  font-weight: 900;
  line-height: 1.4;
  word-break: break-all;
}

.task-collapsed-route {
  margin-top: 8rpx;
  color: var(--c-muted);
  font-size: 23rpx;
  font-weight: 750;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.detail-row {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 8rpx;
  color: var(--c-muted);
  font-size: 22rpx;
  font-weight: 800;
}

.task-status {
  flex: 0 0 auto;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 900;
}

.task-status.active {
  background: #ccfbf1;
  color: #0f766e;
}

.task-status.pending {
  background: #eff6ff;
  color: #1d4ed8;
}

.task-status.done {
  background: #ecfdf5;
  color: #047857;
}

.task-confirm {
  width: 100%;
  height: 66rpx;
  line-height: normal;
  margin-top: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 20rpx;
  border-radius: 20rpx;
  background: #0f766e;
  color: #fff;
  font-size: 25rpx;
  font-weight: 900;
  box-shadow: 0 12rpx 24rpx rgba(20, 184, 166, 0.18);
}

.task-confirm::after {
  border: 0;
}

.yard-mini-panel {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
  padding: 18rpx 22rpx;
  border-color: #ccfbf1;
  background: rgba(255, 255, 255, 0.86);
}

.yard-mini-title {
  flex: 0 0 auto;
  color: #0f766e;
  font-size: 26rpx;
  font-weight: 950;
}

.yard-mini-panel .muted {
  flex: 1;
  text-align: right;
  font-size: 20rpx;
  line-height: 1.35;
}

.yard-mini-panel.return-mini {
  border-color: #bfdbfe;
}

.yard-mini-panel.return-mini .yard-mini-title {
  color: #155e75;
}

/* Driver Task Page UI V2: hero -> calendar -> outbound -> tasks -> inbound -> report. */
.task-page {
  box-sizing: border-box;
  overflow-x: hidden;
  padding-bottom: calc(170rpx + env(safe-area-inset-bottom));
}

.task-hero {
  margin: 20rpx 20rpx 0;
  padding: 30rpx 28rpx 24rpx;
  border-radius: 34rpx;
  color: #fff;
  background: linear-gradient(135deg, #0b6f73, #119d8d);
  box-shadow: 0 18rpx 42rpx rgba(15, 118, 110, .2);
}

.task-hero.pending { background: linear-gradient(135deg, #17546b, #177f81); }
.task-hero.active { background: linear-gradient(135deg, #0d6f80, #0f9a91); }
.task-hero.report { background: linear-gradient(135deg, #0b7377, #0ca790); }
.task-hero.completed { background: linear-gradient(135deg, #08736c, #0d998b); }

.task-hero-top,
.task-hero-bottom,
.yard-summary,
.yard-summary-main {
  display: flex;
  align-items: center;
}

.task-hero-top { justify-content: space-between; gap: 20rpx; }
.task-hero-copy { min-width: 0; flex: 1; }
.task-hero-kicker { font-size: 21rpx; font-weight: 800; opacity: .82; }
.task-hero-title { margin-top: 8rpx; font-size: 42rpx; line-height: 1.2; font-weight: 950; overflow-wrap: anywhere; }
.task-hero-meta { margin-top: 10rpx; font-size: 23rpx; opacity: .9; overflow-wrap: anywhere; }
.task-hero-count { flex: 0 0 132rpx; min-height: 112rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; border: 2rpx solid rgba(255,255,255,.22); border-radius: 24rpx; background: rgba(255,255,255,.12); }
.task-hero-count text { font-size: 20rpx; opacity: .85; }
.task-hero-count strong { margin-top: 4rpx; font-size: 40rpx; line-height: 1; }
.task-hero-bottom { justify-content: space-between; gap: 16rpx; margin-top: 24rpx; padding-top: 20rpx; border-top: 2rpx solid rgba(255,255,255,.2); font-size: 21rpx; }
.task-hero-bottom text { min-width: 0; flex: 1; }
.task-hero-bottom button { flex: 0 0 auto; width: auto; min-width: 126rpx; height: 54rpx; margin: 0; padding: 0 18rpx; border: 2rpx solid rgba(255,255,255,.32); border-radius: 16rpx; color: #fff; background: rgba(255,255,255,.13); font-size: 21rpx; font-weight: 900; line-height: 50rpx; }
.task-hero-bottom button::after { border: 0; }

.calendar-panel { margin-top: 18rpx; }
.yard-panel,
.task-main-panel,
.report-status-panel,
.run-doc-panel,
.message-panel { margin-top: 18rpx; }

.yard-summary { justify-content: space-between; gap: 16rpx; }
.yard-summary-main { min-width: 0; flex: 1; gap: 16rpx; }
.yard-status-mark { flex: 0 0 66rpx; height: 66rpx; display: flex; align-items: center; justify-content: center; border-radius: 20rpx; color: #0f766e; background: #e6f7f3; font-size: 28rpx; font-weight: 950; }
.yard-status-mark.done { color: #047857; background: #dcfce7; }
.yard-summary-status { flex: 0 0 auto; color: #0f766e; font-size: 21rpx; font-weight: 900; white-space: nowrap; }
.yard-expanded { margin-top: 22rpx; padding-top: 20rpx; border-top: 1rpx solid #e2e8f0; }
.yard-complete { padding-top: 22rpx; padding-bottom: 22rpx; }

.yard-record-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12rpx; }
.yard-record-grid > view { min-width: 0; padding: 16rpx; border-radius: 16rpx; background: #f7fafc; }
.yard-record-grid text { display: block; color: #718096; font-size: 19rpx; }
.yard-record-grid strong { display: block; margin-top: 6rpx; color: #173f4d; font-size: 22rpx; overflow-wrap: anywhere; }
.yard-edit-link { width: 100%; height: 58rpx; margin-top: 16rpx; border: 1rpx solid #b7ddd7; border-radius: 16rpx; color: #0f766e; background: #fff; font-size: 21rpx; font-weight: 850; line-height: 56rpx; }
.yard-edit-link::after { border: 0; }
.future-readonly,
.paper-report-removed,
.submitted-report-note,
.daily-pdf-gap,
.daily-report-prefill,
.task-loading { padding: 16rpx; border-radius: 16rpx; font-size: 20rpx; line-height: 1.55; }
.future-readonly { color: #64748b; background: #f1f5f9; }
.paper-report-removed { margin-top: 16rpx; color: #0f766e; background: #ecfdf5; }
.task-loading { color: #64748b; text-align: center; background: #f8fafc; }

.task-main-panel .actual-pending-banner { margin: 18rpx 0 0; padding: 16rpx; border: 1rpx solid #fed7aa; border-radius: 16rpx; }
.task-card { overflow: hidden; }
.task-route-head,
.task-time,
.task-order-no { overflow-wrap: anywhere; }
.actual-grid input { min-width: 0; }

.report-status-panel { border-color: #b7e7df; background: #f7fffd; }
.report-status-panel.locked { border-color: #dbe4eb; background: #fff; }
.report-status-panel.completed { border-color: #a7e0d5; background: #f0fdfa; }
.report-status-kicker { color: #0f766e; font-size: 20rpx; font-weight: 900; }
.report-status-title { margin: 8rpx 0; color: #173f4d; font-size: 32rpx; font-weight: 950; }
.report-status-meta { margin-top: 12rpx; color: #0f766e; font-size: 20rpx; font-weight: 800; overflow-wrap: anywhere; }
.report-open { width: 100%; height: 72rpx; margin-top: 20rpx; border-radius: 18rpx; color: #fff; background: #0f9b8e; font-size: 24rpx; font-weight: 900; line-height: 72rpx; }
.report-open::after { border: 0; }
.report-status-panel .daily-report-card { margin-top: 18rpx; padding: 18rpx; border: 1rpx solid #d8e8e5; border-radius: 20rpx; background: #fff; }
.daily-report-prefill { margin-bottom: 14rpx; color: #476675; background: #f0f7f8; }
.submitted-report-note { margin-top: 14rpx; color: #476675; background: #f1f5f9; }
.daily-pdf-gap { margin-top: 16rpx; color: #64748b; background: rgba(255,255,255,.72); }
.message-panel { color: #92400e; background: #fff7ed; }

@media (max-width: 360px) {
  .task-hero { margin-left: 14rpx; margin-right: 14rpx; padding-left: 22rpx; padding-right: 22rpx; }
  .task-hero-title { font-size: 36rpx; }
  .task-hero-count { flex-basis: 112rpx; }
  .task-hero-bottom { align-items: flex-start; flex-direction: column; }
  .task-hero-bottom button { width: 100%; }
  .actual-grid { gap: 8rpx; }
  .actual-grid input { padding-left: 8rpx; padding-right: 8rpx; font-size: 19rpx; }
  .yard-record-grid { grid-template-columns: 1fr; }
}
