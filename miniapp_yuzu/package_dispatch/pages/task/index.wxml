<view class="page task-page driver-theme">
  <view class="panel yard-panel preflight-panel">
    <view class="panel-header-lite">
      <view>
        <view class="panel-title">点呼出库</view>
        <view class="muted">确认车辆、证件、睡眠和酒精状态后，开始执行今日任务。</view>
      </view>
      <view class="soft-count">{{vehicleStatusText}}</view>
    </view>

    <view class="form-grid">
      <view class="form-field">
        <text class="form-label">睡眠时间</text>
        <input class="form-input" value="{{departForm.sleep_hours}}" data-key="sleep_hours" type="digit" bindinput="onDepartInput" placeholder="例：7.0" />
      </view>
      <view class="form-field">
        <text class="form-label">出库时间</text>
        <input class="form-input" value="{{departForm.depart_time}}" data-key="depart_time" bindinput="onDepartInput" placeholder="HH:mm" />
      </view>
    </view>

    <view class="check-list">
      <view wx:for="{{preflightItems}}" wx:key="key" class="check-row" data-key="{{item.key}}" bindtap="onTogglePreflight">
        <view class="check-dot {{preflightChecked[item.key] ? 'checked' : ''}}"></view>
        <view>{{item.label}}</view>
      </view>
    </view>

    <view class="yard-material-list">
      <view class="yard-material-row">
        <view>
          <view class="yard-material-title">酒精测试结果</view>
          <view class="yard-material-file">{{departMaterials.alcohol.file_name || '出库前拍照上传'}}</view>
        </view>
        <view class="yard-material-actions">
          <view class="yard-material-upload" data-section="depart" data-key="alcohol" bindtap="chooseYardMaterial">{{departMaterials.alcohol.file_name ? '重选' : '上传'}}</view>
          <view wx:if="{{departMaterials.alcohol.file_name}}" class="yard-material-clear" data-section="depart" data-key="alcohol" bindtap="clearYardMaterial">清除</view>
        </view>
      </view>
    </view>

    <button class="task-primary" loading="{{submitting}}" bindtap="submitDepart">{{departSubmitted ? '保存出库修改' : '确认出库'}}</button>
  </view>

  <view class="panel calendar-panel">
    <view class="calendar-head">
      <view>
        <picker mode="date" fields="month" value="{{selectedDate}}" bindchange="onPickMonth">
          <view class="calendar-month-title">{{monthLabel}} <text class="month-pick-hint">选择</text></view>
        </picker>
      </view>
      <view class="calendar-actions">
        <button class="month-toggle" bindtap="toggleMonth">{{showMonth ? '周历' : '月历'}}</button>
      </view>
    </view>

    <scroll-view wx:if="{{!showMonth}}" scroll-x class="week-strip" enable-flex enhanced show-scrollbar="{{false}}" scroll-into-view="{{selectedDayAnchor}}" scroll-with-animation>
      <view class="week-row">
        <view
          wx:for="{{weekDays}}"
          wx:key="date"
          id="{{item.anchor}}"
          class="day-pill {{item.selected ? 'active' : ''}} {{item.today ? 'today' : ''}} {{item.holiday ? 'holiday' : ''}}"
          data-date="{{item.date}}"
          bindtap="onSelectDate"
        >
          <view class="day-week">周{{item.week}}</view>
          <view class="day-num">{{item.day}}</view>
          <view wx:if="{{item.count}}" class="day-count">{{item.count}}</view>
        </view>
      </view>
    </scroll-view>

    <view wx:if="{{showMonth}}" class="month-grid">
      <view wx:for="{{weekLabels}}" wx:key="*this" class="month-week-label {{index === 0 || index === 6 ? 'holiday' : ''}}">周{{item}}</view>
      <view
        wx:for="{{monthDays}}"
        wx:key="date"
        class="month-day {{item.empty ? 'empty' : ''}} {{item.selected ? 'active' : ''}} {{item.count ? 'has-task' : ''}} {{item.holiday ? 'holiday' : ''}}"
        data-date="{{item.date}}"
        bindtap="onSelectDate"
      >
        <text wx:if="{{!item.empty}}" class="month-day-number">{{item.day}}</text>
        <text wx:if="{{!item.empty && item.count}}" class="month-dot">{{item.count}}</text>
      </view>
    </view>
  </view>

  <view wx:if="{{readyAssignments.length}}" class="panel ready-panel">
    <view class="panel-header-lite">
      <view>
        <view class="panel-title">已确认待出库任务</view>
        <view class="muted">司机确认后的任务会先在这里等待出库点呼。</view>
      </view>
      <view class="soft-count">{{readyAssignments.length}} 单</view>
    </view>
    <view class="ready-list">
      <view wx:for="{{readyAssignments}}" wx:key="assignment_id" class="ready-card">
        <view class="ready-time">{{item.timeText}}</view>
        <view class="ready-route">{{item.routeText}}</view>
        <view class="task-order-no">{{item.orderNoText || item.oid || item.order_id || '任务'}}</view>
      </view>
    </view>
  </view>

  <view class="panel">
    <view class="panel-header-lite">
      <view>
        <view class="panel-title">{{selectedLabel}} 任务</view>
        <view class="muted">选中日历日期后，这里显示当天任务。</view>
      </view>
      <view class="soft-count">{{assignments.length}} 单</view>
    </view>

    <view class="task-list">
      <view wx:for="{{assignments}}" wx:key="assignment_id" class="task-card {{item.isExpanded ? 'expanded' : 'collapsed'}}">
        <view class="task-card-head" data-id="{{item.assignment_id || item.id}}" bindtap="toggleTask">
          <view class="task-main">
            <view class="task-time">{{item.timeText}}</view>
            <view class="task-route-head">{{item.routeText}}</view>
            <view class="task-order-no">{{item.orderNoText || item.oid || item.order_id || '任务'}}</view>
          </view>
          <view class="task-status {{item.orderStatusClass}}">{{item.orderStatusText}}</view>
        </view>

        <view wx:if="{{item.isExpanded}}" class="task-detail">
          <view class="task-route">{{item.routeText}}</view>
          <view class="detail-row">
            <text>司机</text>
            <text>{{item.driver_name || '-'}}</text>
          </view>
          <view class="detail-row">
            <text>车辆</text>
            <text>{{item.plate_number || item.vehicle_plate || '-'}}</text>
          </view>
        </view>

        <button
          wx:if="{{item.canConfirm}}"
          class="task-confirm"
          data-id="{{item.assignment_id || item.id}}"
          loading="{{submitting}}"
          bindtap="confirmTask"
        >确认接单</button>
      </view>

      <view wx:if="{{!assignments.length && !loading}}" class="empty-state">
        <view class="empty-title">当天没有任务</view>
        <view class="muted">调度派车后，这里会显示司机自己的任务。</view>
      </view>
    </view>
  </view>

  <view class="panel yard-panel return-panel">
    <view class="panel-header-lite">
      <view>
        <view class="panel-title">点呼入库</view>
        <view class="muted">今日任务完成后，填写休息时间和入库确认。</view>
      </view>
      <view class="soft-count">{{vehicleStatusText}}</view>
    </view>

    <view class="form-grid">
      <view class="form-field">
        <text class="form-label">休息时间</text>
        <input class="form-input" value="{{returnForm.rest_hours}}" data-key="rest_hours" type="digit" bindinput="onReturnInput" placeholder="例：1.5" />
      </view>
      <view class="form-field">
        <text class="form-label">入库时间</text>
        <input class="form-input" value="{{returnForm.return_time}}" data-key="return_time" bindinput="onReturnInput" placeholder="HH:mm" />
      </view>
    </view>

    <view class="check-list">
      <view wx:for="{{returnItems}}" wx:key="key" class="check-row" data-key="{{item.key}}" bindtap="onToggleReturn">
        <view class="check-dot {{returnChecked[item.key] ? 'checked' : ''}}"></view>
        <view>{{item.label}}</view>
      </view>
    </view>

    <view class="yard-material-list">
      <view class="yard-material-row">
        <view>
          <view class="yard-material-title">酒精测试结果</view>
          <view class="yard-material-file">{{returnMaterials.alcohol.file_name || '入库时拍照上传'}}</view>
        </view>
        <view class="yard-material-actions">
          <view class="yard-material-upload" data-section="return" data-key="alcohol" bindtap="chooseYardMaterial">{{returnMaterials.alcohol.file_name ? '重选' : '上传'}}</view>
          <view wx:if="{{returnMaterials.alcohol.file_name}}" class="yard-material-clear" data-section="return" data-key="alcohol" bindtap="clearYardMaterial">清除</view>
        </view>
      </view>
      <view class="yard-material-row">
        <view>
          <view class="yard-material-title">司机日报</view>
          <view class="yard-material-file">{{returnMaterials.daily_report.file_name || '入库日报拍照上传'}}</view>
        </view>
        <view class="yard-material-actions">
          <view class="yard-material-upload" data-section="return" data-key="daily_report" bindtap="chooseYardMaterial">{{returnMaterials.daily_report.file_name ? '重选' : '上传'}}</view>
          <view wx:if="{{returnMaterials.daily_report.file_name}}" class="yard-material-clear" data-section="return" data-key="daily_report" bindtap="clearYardMaterial">清除</view>
        </view>
      </view>
    </view>

    <button class="task-primary return" loading="{{submitting}}" bindtap="submitReturn">{{returnSubmitted ? '保存入库修改' : '确认入库，今日收工'}}</button>
  </view>

  <view wx:if="{{message}}" class="panel muted">{{message}}</view>
  <custom-tab-bar />
</view>
