@import "../../../app.wxss";

.dashboard-hero {
  background: linear-gradient(135deg, #153b92 0%, #246bfe 100%);
  position: relative;
}

.dashboard-hero::after {
  pointer-events: none;
}

.hero-bell {
  position: absolute;
  top: 28rpx;
  right: 28rpx;
  z-index: 8;
  width: 54rpx;
  height: 54rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #2563eb;
  background: rgba(255, 255, 255, 0.92);
  border: 2rpx solid rgba(255, 255, 255, 0.88);
  box-shadow: 0 10rpx 26rpx rgba(15, 23, 42, 0.16), inset 0 1rpx 0 rgba(255, 255, 255, 0.9);
  transition: transform 0.12s ease, opacity 0.12s ease, background 0.12s ease;
}

.hero-bell-pressed {
  transform: scale(0.9);
  opacity: 0.82;
}

.hero-bell.active {
  color: #1d4ed8;
  background: rgba(255, 255, 255, 0.96);
  border-color: rgba(255, 255, 255, 0.95);
  box-shadow: 0 12rpx 28rpx rgba(37, 99, 235, 0.24), inset 0 1rpx 0 rgba(255, 255, 255, 0.95);
}

.hero-bell-symbol {
  position: relative;
  width: 30rpx;
  height: 32rpx;
}

.hero-bell-cap {
  position: absolute;
  left: 11rpx;
  top: 0;
  width: 8rpx;
  height: 7rpx;
  border-radius: 999rpx 999rpx 0 0;
  background: #2563eb;
  border: 2rpx solid rgba(255, 255, 255, 0.92);
  border-bottom: 0;
  box-sizing: border-box;
}

.hero-bell-dome {
  position: absolute;
  left: 4rpx;
  top: 5rpx;
  width: 22rpx;
  height: 21rpx;
  border-radius: 16rpx 16rpx 7rpx 7rpx;
  background: linear-gradient(145deg, #60a5fa 0%, #2563eb 72%, #1d4ed8 100%);
  border: 2rpx solid rgba(255, 255, 255, 0.95);
  box-shadow: 0 6rpx 12rpx rgba(37, 99, 235, 0.28), inset 0 2rpx 0 rgba(255, 255, 255, 0.36);
  box-sizing: border-box;
}

.hero-bell-base {
  position: absolute;
  left: 2rpx;
  top: 22rpx;
  width: 26rpx;
  height: 6rpx;
  border-radius: 999rpx;
  background: #1d4ed8;
  border: 2rpx solid rgba(255, 255, 255, 0.95);
  box-sizing: border-box;
}

.hero-bell-dot {
  position: absolute;
  left: 11rpx;
  bottom: 0;
  width: 8rpx;
  height: 8rpx;
  border-radius: 999rpx;
  background: #1d4ed8;
  border: 2rpx solid rgba(255, 255, 255, 0.95);
  box-sizing: border-box;
}

.hero-bell-count {
  position: absolute;
  top: -12rpx;
  right: -10rpx;
  min-width: 30rpx;
  height: 30rpx;
  padding: 0 8rpx;
  border-radius: 999rpx;
  line-height: 30rpx;
  text-align: center;
  color: #ffffff;
  background: #ef4444;
  font-size: 18rpx;
  font-weight: 950;
}

.dispatch-command-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 12rpx;
  margin-top: 18rpx;
}

.compact-switch-grid {
  align-items: stretch;
}

.command-span-2 {
  grid-column: span 2;
}

.command-orders,
.command-resources {
  grid-column: 1 / span 2;
  grid-row: span 2;
}

.command-idle {
  grid-column: 3 / span 2;
}

.command-small {
  min-height: 104rpx;
}

.command-card {
  min-height: 112rpx;
  box-sizing: border-box;
  border-radius: 12rpx;
  padding: 14rpx;
  background: #ffffff;
  border: 1rpx solid #dbe7f5;
  box-shadow: 0 14rpx 28rpx rgba(15, 23, 42, 0.07);
}

.command-card.wide {
  grid-column: 1 / -1;
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto auto;
  align-items: center;
  column-gap: 16rpx;
  min-height: 118rpx;
}

.idle-summary-lines {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 8rpx;
  margin-top: 10rpx;
}

.resource-command-lines {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 10rpx;
  margin-top: 18rpx;
}

.resource-command-lines view {
  min-width: 0;
}

.resource-command-lines text {
  display: block;
  color: #475569;
  font-size: 20rpx;
  font-weight: 850;
  line-height: 1.15;
}

.resource-command-lines text:first-child {
  color: #0f172a;
  font-size: 38rpx;
  font-weight: 950;
  line-height: 1;
}

.idle-summary-lines view {
  min-width: 0;
  padding: 0;
}

.idle-summary-lines text {
  display: block;
  text-align: center;
  color: #475569;
  font-size: 20rpx;
  font-weight: 850;
  line-height: 1.15;
}

.idle-summary-lines text:first-child {
  color: #0f172a;
  font-size: 30rpx;
  font-weight: 950;
}

.command-card.active .idle-summary-lines text:first-child {
  color: #ffffff;
}

.command-card.active .idle-summary-lines text {
  color: rgba(255, 255, 255, 0.88);
}

.command-card.active .resource-command-lines text:first-child {
  color: #ffffff;
}

.command-card.active .resource-command-lines text {
  color: rgba(255, 255, 255, 0.88);
}

.command-card.active {
  border: 2rpx solid #2563eb;
  background: linear-gradient(180deg, #2563eb 0%, #1d4ed8 100%);
  color: #ffffff;
  box-shadow:
    inset 0 1rpx 0 rgba(255, 255, 255, 0.22),
    0 12rpx 26rpx rgba(37, 99, 235, 0.22);
}

.command-card.info-card {
  border-color: #cbd5e1;
  background: linear-gradient(180deg, #f8fafc 0%, #ffffff 100%);
}

.command-orders.active,
.command-resources.active {
  border-color: #2563eb;
  background: linear-gradient(180deg, #2563eb 0%, #1d4ed8 100%);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.22), 0 12rpx 26rpx rgba(37, 99, 235, 0.22);
}

.command-idle.active {
  border-color: #2563eb;
  background: linear-gradient(180deg, #2563eb 0%, #1d4ed8 100%);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.22), 0 12rpx 26rpx rgba(37, 99, 235, 0.22);
}

.command-small.active {
  border-color: #2563eb;
  background: linear-gradient(180deg, #2563eb 0%, #1d4ed8 100%);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.22), 0 12rpx 26rpx rgba(37, 99, 235, 0.22);
}

.command-label {
  color: #475569;
  font-size: 22rpx;
  font-weight: 900;
  line-height: 1.25;
}

.command-card.active .command-label,
.command-card.active .command-number {
  color: #ffffff;
}

.command-card.active .command-note {
  color: rgba(255, 255, 255, 0.92);
}

.command-number {
  margin-top: 8rpx;
  color: #0f172a;
  font-size: 38rpx;
  font-weight: 950;
  line-height: 1;
}

.command-number.compact-ratio {
  font-size: 30rpx;
  line-height: 1.08;
  white-space: nowrap;
}

.command-note {
  margin-top: 7rpx;
  color: #64748b;
  font-size: 20rpx;
  font-weight: 800;
  line-height: 1.3;
}

.idle-line {
  min-width: 108rpx;
  border-radius: 20rpx;
  padding: 12rpx 14rpx;
  background: #ecfdf5;
  border: 1rpx solid #bbf7d0;
  text-align: center;
}

.idle-line text {
  display: block;
  color: #0f766e;
  font-size: 32rpx;
  font-weight: 950;
  line-height: 1;
}

.idle-line view {
  margin-top: 6rpx;
  color: #64748b;
  font-size: 20rpx;
  font-weight: 850;
}

.idle-type-row {
  grid-column: 1 / -1;
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 12rpx;
}

.idle-type-row text {
  border-radius: 999rpx;
  padding: 7rpx 12rpx;
  color: #0f766e;
  background: #ecfeff;
  border: 1rpx solid #99f6e4;
  font-size: 20rpx;
  font-weight: 900;
}

.driver-theme .dashboard-hero,
.driver-theme .summary-main {
  background: linear-gradient(135deg, #0f766e 0%, #14b8a6 100%);
  box-shadow: 0 18rpx 42rpx rgba(20, 184, 166, 0.22);
}

.login-panel {
  gap: 30rpx;
  padding: 36rpx;
}

.login-help {
  margin-top: 8rpx;
  color: var(--c-muted);
  font-size: 24rpx;
  line-height: 1.45;
}

.login-input {
  display: block;
  height: 132rpx;
  min-height: 132rpx;
  line-height: 132rpx;
  box-sizing: border-box;
  padding: 0 36rpx;
  border: 2rpx solid #dbe7f5;
  border-radius: 32rpx;
  background: #ffffff;
  font-size: 38rpx;
  font-weight: 900;
  box-shadow: 0 8rpx 22rpx rgba(15, 23, 42, 0.04);
}

.login-placeholder {
  color: #9aa8ba;
  font-size: 34rpx;
  font-weight: 750;
}

.login-panel .button-primary {
  width: 100%;
  height: 120rpx;
  line-height: 120rpx;
  border-radius: 32rpx;
  font-size: 36rpx;
}

.ops-summary {
  display: grid;
  grid-template-columns: 1.18fr 0.82fr;
  gap: 16rpx;
  margin-top: 20rpx;
}

.summary-main {
  min-height: 244rpx;
  box-sizing: border-box;
  border-radius: 34rpx;
  padding: 28rpx;
  color: #ffffff;
  background: linear-gradient(145deg, #246bfe 0%, #1748c7 100%);
  box-shadow: 0 18rpx 42rpx rgba(36, 107, 254, 0.22);
}

.summary-main.ops-main {
  background: linear-gradient(135deg, #0f766e 0%, #0ea5a0 52%, #2563eb 100%);
  box-shadow: 0 18rpx 42rpx rgba(15, 118, 110, 0.2);
}

.summary-main.ops-main.warning {
  background: linear-gradient(135deg, #0f766e 0%, #0ea5a0 45%, #f59e0b 100%);
  box-shadow: 0 18rpx 42rpx rgba(245, 158, 11, 0.18);
}

.summary-label,
.summary-note {
  color: rgba(255, 255, 255, 0.82);
  font-size: 24rpx;
  font-weight: 850;
}

.summary-number {
  margin: 14rpx 0;
  font-size: 76rpx;
  font-weight: 950;
  line-height: 1;
}

.summary-number.status-text {
  font-size: 56rpx;
  line-height: 1.08;
}

.summary-side {
  display: grid;
  gap: 16rpx;
}

.driver-summary-side {
  grid-template-columns: 1fr 1fr;
}

.driver-summary-side .summary-wide {
  grid-column: 1 / -1;
}

.summary-chip,
.status-card {
  border-radius: 28rpx;
  padding: 22rpx;
  background: #ffffff;
  border: 1rpx solid var(--c-border);
  box-shadow: var(--shadow-card);
}

.summary-chip.active,
.status-card.active {
  border-color: #2563eb;
  box-shadow: 0 12rpx 26rpx rgba(37, 99, 235, 0.14);
}

.driver-theme .summary-chip.active,
.driver-theme .status-card.active {
  border-color: #14b8a6;
  box-shadow: 0 12rpx 26rpx rgba(20, 184, 166, 0.14);
}

.summary-chip.danger {
  border-color: #fecaca;
  background: #fff1f2;
}

.summary-chip.danger text,
.summary-chip.danger .metric-strong {
  color: #dc2626;
}

.driver-theme .summary-chip.danger.active {
  border-color: #ef4444;
  box-shadow: 0 12rpx 26rpx rgba(239, 68, 68, 0.14);
}

.summary-chip text,
.status-card text {
  display: block;
  color: var(--c-muted);
  font-size: 22rpx;
  font-weight: 800;
}

.summary-chip .metric-strong,
.status-card .metric-strong {
  display: block;
  margin-top: 8rpx;
  color: var(--c-text);
  font-size: 38rpx;
  font-weight: 950;
}

.resource-entry {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-top: 16rpx;
  padding: 22rpx;
  border-radius: 28rpx;
  border: 1rpx solid #99f6e4;
  background: linear-gradient(180deg, #ecfdf5 0%, #ffffff 100%);
  box-shadow: 0 14rpx 30rpx rgba(15, 118, 110, 0.12);
}

.ops-resource-entry {
  align-items: stretch;
  padding: 20rpx;
}

.resource-entry-copy {
  flex: 1 1 auto;
  min-width: 0;
}

.resource-entry-title {
  color: #0f172a;
  font-size: 28rpx;
  font-weight: 950;
  line-height: 1.25;
}

.resource-entry-meta {
  margin-top: 8rpx;
  color: #64748b;
  font-size: 22rpx;
  font-weight: 750;
  line-height: 1.35;
}

.resource-entry-stats {
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 0 4rpx;
}

.resource-entry-stats view {
  min-width: 54rpx;
  text-align: center;
}

.resource-entry-stat-value,
.resource-entry-stat-label {
  display: block;
}

.resource-entry-stat-value {
  color: #0f766e;
  font-size: 28rpx;
  font-weight: 950;
  line-height: 1;
}

.resource-entry-stat-label {
  margin-top: 6rpx;
  color: #64748b;
  font-size: 18rpx;
  font-weight: 850;
  line-height: 1;
}

.resource-entry-action {
  flex: 0 0 auto;
  min-width: 88rpx;
  height: 56rpx;
  line-height: 56rpx;
  text-align: center;
  border-radius: 999rpx;
  background: #0f766e;
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 900;
}

.ops-alert-panel {
  margin-top: 16rpx;
}

.ops-alert-summary {
  display: grid;
  grid-template-columns: repeat(5, minmax(0, 1fr));
  gap: 8rpx;
  margin-top: 14rpx;
  padding: 12rpx;
  border-radius: 20rpx;
  background: #f8fafc;
  border: 1rpx solid #e2e8f0;
}

.ops-alert-summary view {
  min-width: 0;
  text-align: center;
}

.ops-alert-filter {
  min-height: 76rpx;
  box-sizing: border-box;
  padding: 10rpx 4rpx;
  border: 2rpx solid transparent;
  border-radius: 14rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.ops-alert-filter.active {
  border-color: #0f766e;
  background: #ffffff;
  box-shadow: 0 8rpx 18rpx rgba(15, 118, 110, 0.14);
}

.ops-alert-filter-hover {
  background: #eefbf8;
}

.ops-alert-summary text {
  display: block;
  line-height: 1.1;
}

.ops-alert-summary text:first-child {
  color: #0f172a;
  font-size: 30rpx;
  font-weight: 950;
}

.ops-alert-summary text:last-child {
  margin-top: 6rpx;
  color: #64748b;
  font-size: 18rpx;
  font-weight: 850;
}

.ops-alert-filter.active text:first-child,
.ops-alert-filter.active text:last-child {
  color: #0f766e;
}

.soft-count.filter-active {
  color: #0f766e;
  background: #ecfdf5;
  border: 1rpx solid #99f6e4;
}

.ops-alert-scroll {
  height: 420rpx;
  margin-top: 14rpx;
  padding-right: 4rpx;
  box-sizing: border-box;
}

.ops-alert-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 16rpx 4rpx;
  border-bottom: 1rpx solid #e5edf5;
}

.ops-alert-row:last-child {
  border-bottom: 0;
}

.ops-alert-main {
  min-width: 0;
}

.ops-alert-status {
  flex: 0 0 auto;
  color: #0f766e;
  font-size: 21rpx;
  font-weight: 950;
}

.ops-alert-row.warning .ops-alert-status {
  color: #d97706;
}

.ops-alert-row.danger .ops-alert-status {
  color: #dc2626;
}

.status-strip {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12rpx;
  margin-top: 16rpx;
}

.ops-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
  margin-top: 16rpx;
}

.ops-grid-compact {
  grid-template-columns: 1fr 1fr;
  gap: 12rpx;
}

.ops-card {
  min-height: 132rpx;
  box-sizing: border-box;
  border-radius: 28rpx;
  padding: 18rpx;
  background: #ffffff;
  border: 1rpx solid var(--c-border);
  box-shadow: var(--shadow-card);
}

.ops-card-wide {
  grid-column: 1 / -1;
  min-height: 118rpx;
}

.ops-card.active {
  border-color: #0f766e;
  background: linear-gradient(180deg, #ecfdf5 0%, #ffffff 100%);
  box-shadow: 0 14rpx 30rpx rgba(15, 118, 110, 0.16);
}

.ops-card text {
  display: block;
  color: var(--c-muted);
  font-size: 22rpx;
  font-weight: 850;
}

.ops-card .metric-strong {
  display: block;
  margin-top: 8rpx;
  color: #0f766e;
  font-size: 42rpx;
  font-weight: 950;
  line-height: 1;
}

.ops-card view {
  margin-top: 10rpx;
  color: #64748b;
  font-size: 21rpx;
  font-weight: 750;
  line-height: 1.35;
}

.ops-detail-grid {
  margin-top: 18rpx;
}

.ops-detail-panel {
  margin-bottom: 18rpx;
}

.ops-detail-panel.single {
  margin-top: 18rpx;
}

.ops-detail-list {
  margin-top: 14rpx;
}

.ops-detail-row {
  padding: 18rpx 0;
  border-bottom: 1rpx solid #edf2f7;
}

.ops-detail-row:last-child {
  border-bottom: 0;
}

.ops-detail-main {
  display: grid;
  gap: 6rpx;
}

.ops-field-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 10rpx;
  margin-top: 14rpx;
}

.ops-field {
  min-width: 0;
  box-sizing: border-box;
  border-radius: 18rpx;
  padding: 12rpx;
  background: #f8fafc;
  border: 1rpx solid #e2e8f0;
}

.ops-field text {
  display: block;
  color: #64748b;
  font-size: 20rpx;
  font-weight: 800;
}

.ops-field .metric-strong {
  display: block;
  margin-top: 4rpx;
  color: #0f172a;
  font-size: 22rpx;
  font-weight: 900;
  line-height: 1.35;
  word-break: break-all;
}

.compact-list {
  margin-top: 14rpx;
}

.compact-row {
  display: grid;
  grid-template-columns: minmax(0, 1fr);
  gap: 8rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #edf2f7;
}

.compact-row:last-child {
  border-bottom: 0;
}

.compact-body {
  color: #475569;
  font-size: 22rpx;
  font-weight: 750;
  line-height: 1.4;
  word-break: break-all;
}

.ops-home-detail {
  min-height: 360rpx;
}

.dispatch-task-list {
  margin-top: 14rpx;
  display: grid;
  gap: 12rpx;
}

.dispatch-task-card {
  border-radius: 22rpx;
  border: 1rpx solid #dbe7f5;
  background: linear-gradient(180deg, #f8fbff 0%, #ffffff 100%);
  padding: 18rpx;
}

.dispatch-task-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.dispatch-task-time {
  min-width: 0;
  color: #0f172a;
  font-size: 27rpx;
  font-weight: 950;
  line-height: 1.32;
  word-break: break-all;
}

.dispatch-task-status {
  flex: 0 0 auto;
  border-radius: 999rpx;
  padding: 6rpx 14rpx;
  background: #e0f2fe;
  color: #0369a1;
  font-size: 20rpx;
  font-weight: 900;
}

.dispatch-task-route {
  margin-top: 8rpx;
  color: #0f172a;
  font-size: 25rpx;
  font-weight: 900;
  line-height: 1.45;
  word-break: break-all;
}

.dispatch-task-sub {
  margin-top: 8rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
  color: #64748b;
  font-size: 20rpx;
  font-weight: 750;
  line-height: 1.35;
}

.dispatch-task-order {
  flex: 0 1 auto;
  max-width: 58%;
  padding: 3rpx 10rpx;
  border-radius: 999rpx;
  background: #eef6ff;
  color: #64748b;
  font-size: 19rpx;
  font-weight: 800;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.dispatch-task-info,
.dispatch-task-note {
  margin-top: 8rpx;
  color: #475569;
  font-size: 22rpx;
  font-weight: 750;
  line-height: 1.45;
  word-break: break-all;
}

.dispatch-resource-grid {
  margin-top: 14rpx;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12rpx;
}

.dispatch-resource-panel {
  border-radius: 20rpx;
  border: 1rpx solid #e2e8f0;
  background: #f8fafc;
  padding: 16rpx;
}

.dispatch-resource-title {
  color: #0f172a;
  font-size: 24rpx;
  font-weight: 950;
}

.dispatch-resource-row {
  padding: 12rpx 0;
  border-bottom: 1rpx solid #e2e8f0;
}

.dispatch-resource-row:last-child {
  border-bottom: 0;
}

.idle-panel-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12rpx;
}

.home-resource-overview {
  display: grid;
  gap: 14rpx;
}

.home-resource-stats {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12rpx;
}

.home-resource-stat {
  min-height: 118rpx;
  box-sizing: border-box;
  padding: 18rpx;
  border-radius: 20rpx;
  background: #ffffff;
  border: 1rpx solid #dbe7f5;
  box-shadow: 0 8rpx 18rpx rgba(15, 23, 42, 0.04);
}

.home-resource-stat.active {
  border: 2rpx solid #2563eb;
  background: linear-gradient(180deg, #eff6ff 0%, #ffffff 100%);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.8), 0 12rpx 26rpx rgba(37, 99, 235, 0.16);
}

.home-resource-label {
  display: block;
  color: #64748b;
  font-size: 22rpx;
  font-weight: 850;
}

.home-resource-total {
  display: block;
  margin-top: 8rpx;
  color: #0f766e;
  font-size: 40rpx;
  font-weight: 950;
  line-height: 1;
}

.home-resource-stat.active .home-resource-total,
.home-resource-stat.active .home-resource-label {
  color: #1d4ed8;
}

.home-resource-meta {
  margin-top: 8rpx;
  color: #64748b;
  font-size: 20rpx;
  font-weight: 750;
  line-height: 1.35;
}

.resource-office-tabs {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 10rpx;
  padding: 8rpx;
  border-radius: 18rpx;
  background: #f1f7ff;
  border: 1rpx solid #dbe7f5;
}

.resource-office-tab {
  min-height: 52rpx;
  box-sizing: border-box;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #475569;
  font-size: 22rpx;
  font-weight: 900;
}

.resource-office-tab.active {
  color: #1d4ed8;
  background: #ffffff;
  border: 1rpx solid #93c5fd;
  box-shadow: 0 8rpx 18rpx rgba(37, 99, 235, 0.12);
}

.resource-office-tab text {
  line-height: 1;
}

.home-alert-grid {
  display: grid;
  gap: 12rpx;
}

.home-resource-window {
  overflow: hidden;
  border-radius: 20rpx;
  border: 1rpx solid #dbe7f5;
  background: #ffffff;
  box-shadow: 0 12rpx 26rpx rgba(15, 23, 42, 0.06);
}

.home-resource-window-head {
  min-height: 92rpx;
  box-sizing: border-box;
  padding: 16rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  border-bottom: 1rpx solid #edf2f7;
  background: linear-gradient(180deg, #f8fbff 0%, #ffffff 100%);
}

.resource-window-scroll {
  height: 620rpx;
  max-height: 58vh;
  min-height: 360rpx;
  box-sizing: border-box;
  padding: 0 16rpx 10rpx;
}

.home-alert-card {
  box-sizing: border-box;
  padding: 18rpx;
  border-radius: 20rpx;
  border: 1rpx solid #dbe7f5;
  background: #ffffff;
}

.home-alert-card.vehicle {
  border-color: #bfdbfe;
  background: linear-gradient(180deg, #eff6ff 0%, #ffffff 100%);
}

.home-alert-card.inspection {
  border-color: #99f6e4;
  background: linear-gradient(180deg, #ecfdf5 0%, #ffffff 100%);
}

.home-alert-card.health {
  border-color: #fed7aa;
  background: linear-gradient(180deg, #fff7ed 0%, #ffffff 100%);
}

.home-alert-title {
  color: #475569;
  font-size: 22rpx;
  font-weight: 900;
}

.home-alert-number {
  margin-top: 6rpx;
  color: #0f172a;
  font-size: 38rpx;
  font-weight: 950;
  line-height: 1;
}

.home-alert-list {
  display: grid;
  gap: 8rpx;
  margin-top: 12rpx;
}

.home-alert-row {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  gap: 4rpx 12rpx;
  align-items: center;
  padding: 10rpx 12rpx;
  border-radius: 14rpx;
  background: rgba(255, 255, 255, 0.8);
  border: 1rpx solid #e2e8f0;
}

.home-alert-row text {
  min-width: 0;
  color: #0f172a;
  font-size: 22rpx;
  font-weight: 900;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.home-alert-row strong {
  color: #0f766e;
  font-size: 21rpx;
  font-weight: 950;
}

.home-alert-row.warning strong {
  color: #d97706;
}

.home-alert-row.danger strong {
  color: #dc2626;
}

.home-alert-row view {
  grid-column: 1 / -1;
  color: #64748b;
  font-size: 19rpx;
  font-weight: 750;
}

.health-action-row,
.vehicle-action-row {
  cursor: pointer;
}

.health-action-row:active,
.vehicle-action-row:active {
  background: #f8fbff;
}

.health-action-row.expanded,
.vehicle-action-row.expanded {
  border-color: #bfdbfe;
  background: #ffffff;
}

.health-action-row .home-driver-health-edit,
.vehicle-action-row .home-driver-health-edit {
  grid-column: 1 / -1;
  margin-top: 6rpx;
}

.health-action-row .home-driver-health-edit view,
.vehicle-action-row .home-driver-health-edit view {
  grid-column: auto;
}

.health-action-row .home-driver-health-edit text,
.vehicle-action-row .home-driver-health-edit text {
  color: #64748b;
  font-size: 19rpx;
  font-weight: 850;
}

.health-action-row .home-driver-health-edit strong,
.vehicle-action-row .home-driver-health-edit strong {
  color: #0f172a;
  font-size: 23rpx;
}

.home-resource-actions {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 10rpx;
}

.home-resource-folds {
  display: grid;
  gap: 10rpx;
}

.home-resource-fold {
  overflow: hidden;
  border-radius: 18rpx;
  border: 1rpx solid #dbe7f5;
  background: #ffffff;
}

.home-resource-fold-head {
  min-height: 90rpx;
  box-sizing: border-box;
  padding: 16rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.home-resource-fold-head:active {
  background: #f8fbff;
}

.fold-title {
  color: #0f172a;
  font-size: 24rpx;
  font-weight: 950;
  line-height: 1.2;
}

.fold-meta {
  margin-top: 5rpx;
  color: #64748b;
  font-size: 19rpx;
  font-weight: 750;
  line-height: 1.25;
}

.fold-count {
  flex-shrink: 0;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  color: #0f766e;
  background: #ecfdf5;
  font-size: 19rpx;
  font-weight: 950;
  white-space: nowrap;
}

.home-resource-fold-body {
  display: grid;
  gap: 0;
  max-height: 520rpx;
  overflow-y: auto;
  padding: 0 16rpx 12rpx;
  border-top: 1rpx solid #edf2f7;
}

.resource-mini-row {
  min-width: 0;
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  gap: 12rpx;
  align-items: center;
  padding: 13rpx 0;
  border-bottom: 1rpx solid #edf2f7;
}

.resource-mini-row:last-child {
  border-bottom: 0;
}

.resource-driver-row.expanded,
.resource-vehicle-row.expanded {
  padding: 13rpx 10rpx;
  border-radius: 16rpx;
  background: #f8fbff;
  border: 1rpx solid #bfdbfe;
}

.resource-driver-main {
  min-width: 0;
}

.resource-mini-side {
  display: grid;
  gap: 4rpx;
  text-align: right;
  color: #64748b;
  font-size: 18rpx;
  font-weight: 800;
  line-height: 1.2;
}

.resource-mini-row .row-title {
  color: #0f172a;
  font-size: 24rpx;
  font-weight: 950;
  line-height: 1.25;
}

.resource-mini-row .muted {
  color: #64748b;
  font-size: 19rpx;
  line-height: 1.25;
}

.resource-risk {
  justify-self: end;
  display: inline-flex;
  align-items: center;
  min-height: 28rpx;
  padding: 2rpx 9rpx;
  border-radius: 999rpx;
  color: #0f766e;
  background: #ecfdf5;
  font-size: 17rpx;
  font-weight: 950;
  line-height: 1;
}

.resource-risk.warning {
  color: #d97706;
  background: #fff7ed;
}

.resource-risk.danger {
  color: #dc2626;
  background: #fef2f2;
}

.home-driver-health-edit {
  grid-column: 1 / -1;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
  margin-top: 4rpx;
  padding: 12rpx;
  border-radius: 14rpx;
  background: #ffffff;
  border: 1rpx solid #dbeafe;
}

.home-driver-health-edit text {
  display: block;
  color: #64748b;
  font-size: 19rpx;
  font-weight: 850;
}

.home-driver-health-edit strong {
  display: block;
  margin-top: 2rpx;
  color: #0f172a;
  font-size: 23rpx;
  font-weight: 950;
}

.home-driver-health-actions {
  flex: 0 0 auto;
  display: flex;
  gap: 10rpx;
  align-items: center;
}

.vehicle-inspection-edit {
  align-items: stretch;
  flex-direction: column;
}

.vehicle-inspection-date-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12rpx;
}

.vehicle-inspection-date-card {
  border-radius: 14rpx;
  padding: 10rpx 12rpx;
  background: #f8fafc;
  border: 1rpx solid #e2e8f0;
}

.vehicle-inspection-section-title {
  color: #0f172a;
  font-size: 21rpx;
  font-weight: 950;
}

.vehicle-inspection-actions {
  width: 100%;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12rpx;
}

.vehicle-inspection-action-card {
  min-width: 0;
  border-radius: 16rpx;
  padding: 12rpx;
  background: #f8fbff;
  border: 1rpx solid #dbeafe;
}

.vehicle-inspection-action-title {
  color: #0f172a;
  font-size: 21rpx;
  font-weight: 950;
}

.vehicle-inspection-action-buttons {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 8rpx;
  margin-top: 10rpx;
}

.health-edit-button,
.health-upload-button {
  min-width: 0;
  box-sizing: border-box;
  padding: 10rpx 8rpx;
  border-radius: 999rpx;
  text-align: center;
  font-size: 19rpx;
  font-weight: 950;
}

.health-edit-button {
  background: #0f766e;
  color: #ffffff;
}

.health-upload-button {
  background: #e0f2fe;
  color: #075985;
}

.home-driver-health-actions .health-edit-button {
  color: #ffffff;
}

.home-driver-health-actions .health-upload-button {
  color: #075985;
}

.home-resource-more {
  height: 58rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #0f766e;
  background: #ecfdf5;
  font-size: 22rpx;
  font-weight: 950;
}

.home-resource-more:active {
  transform: scale(0.985);
  background: #dff8ed;
}

.home-resource-action {
  min-width: 0;
  box-sizing: border-box;
  padding: 14rpx 12rpx;
  border-radius: 18rpx;
  border: 1rpx solid #dbe7f5;
  background: #ffffff;
  box-shadow: 0 8rpx 18rpx rgba(15, 23, 42, 0.04);
}

.home-resource-action:active {
  transform: scale(0.98);
  background: #f8fbff;
}

.home-resource-action text {
  display: block;
  color: #475569;
  font-size: 20rpx;
  font-weight: 900;
  line-height: 1.2;
}

.home-resource-action strong {
  display: block;
  margin-top: 7rpx;
  color: #0f4ec8;
  font-size: 30rpx;
  font-weight: 950;
  line-height: 1;
}

.home-resource-action view {
  margin-top: 7rpx;
  color: #64748b;
  font-size: 18rpx;
  font-weight: 750;
  line-height: 1.25;
}

.home-resource-action.pdf {
  border-color: #bfdbfe;
  background: linear-gradient(180deg, #eff6ff 0%, #ffffff 100%);
}

.notifications-panel {
  margin-top: 16rpx;
  min-height: 420rpx;
}

.notifications-panel .list {
  min-height: 300rpx;
}

.idle-panel {
  min-width: 0;
  border-radius: 20rpx;
  padding: 14rpx;
  background: #f8fafc;
  border: 1rpx solid #e2e8f0;
}

.idle-scroll {
  margin-top: 8rpx;
  height: 500rpx;
  max-height: 52vh;
  min-height: 260rpx;
}

.idle-panel .dispatch-resource-row {
  min-width: 0;
  padding: 10rpx 0;
}

.idle-panel .row-title,
.idle-panel .muted {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.idle-panel .row-title {
  font-size: 24rpx;
  line-height: 1.25;
}

.idle-panel .muted {
  font-size: 19rpx;
  line-height: 1.25;
}

.compact-empty {
  min-height: 96rpx;
  font-size: 22rpx;
}

.ops-mini-fields {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 8rpx;
  margin-top: 10rpx;
}

.ops-mini-field {
  min-width: 0;
  border-radius: 16rpx;
  padding: 10rpx;
  background: #f8fafc;
  border: 1rpx solid #e2e8f0;
}

.ops-mini-field text {
  display: block;
  color: #64748b;
  font-size: 19rpx;
  font-weight: 800;
}

.ops-mini-field .metric-strong {
  display: block;
  margin-top: 4rpx;
  color: #0f172a;
  font-size: 21rpx;
  font-weight: 900;
  line-height: 1.35;
  word-break: break-all;
}

.status-card.good {
  background: var(--c-success-soft);
  border-color: #bbf7d0;
}

.status-card.warn {
  background: var(--c-warning-soft);
  border-color: #fed7aa;
}

.status-card.notice {
  background: #eff6ff;
  border-color: #bfdbfe;
}

.driver-theme .status-card.notice {
  background: #ecfeff;
  border-color: #99f6e4;
}

.panel-header-lite,
.pressure-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.title-with-help {
  display: flex;
  align-items: center;
  gap: 8rpx;
  min-width: 0;
}

.help-dot {
  flex: 0 0 auto;
  width: 28rpx;
  height: 28rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #2563eb;
  background: #eff6ff;
  border: 1rpx solid #bfdbfe;
  font-size: 20rpx;
  font-weight: 900;
  line-height: 1;
}

.help-dot.small {
  width: 24rpx;
  height: 24rpx;
  font-size: 18rpx;
}

.help-dot:active {
  transform: scale(0.92);
  background: #dbeafe;
}

.soft-count {
  flex: 0 0 auto;
  border-radius: 999rpx;
  padding: 8rpx 14rpx;
  color: #15803d;
  background: #dcfce7;
  font-size: 22rpx;
  font-weight: 900;
}

.pressure-list {
  margin-top: 16rpx;
}

.pressure-row {
  min-height: 82rpx;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #edf2f7;
}

.pressure-row:last-child {
  border-bottom: 0;
}

.pressure-name {
  color: var(--c-text);
  font-size: 27rpx;
  font-weight: 900;
}

.pressure-badge {
  flex: 0 0 auto;
  border-radius: 999rpx;
  padding: 8rpx 12rpx;
  color: #475569;
  background: #f1f5f9;
  font-size: 21rpx;
  font-weight: 900;
}

.pressure-badge.danger {
  color: #b91c1c;
  background: #fee2e2;
}

.pressure-toggle {
  margin-top: 10rpx;
  height: 58rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--c-primary-dark);
  background: var(--c-primary-soft);
  font-size: 23rpx;
  font-weight: 900;
}

.notification-row {
  position: relative;
  display: grid;
  grid-template-columns: 18rpx minmax(0, 1fr) auto;
  gap: 12rpx;
  align-items: center;
  min-height: 92rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #edf2f7;
}

.notification-row:last-child {
  border-bottom: 0;
}

.notification-row.unread .row-title {
  color: var(--c-primary-dark);
}

.notification-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 999rpx;
  background: #3b82f6;
  box-shadow: 0 0 0 7rpx rgba(59, 130, 246, 0.12);
}

.driver-theme .notification-dot {
  background: #14b8a6;
  box-shadow: 0 0 0 7rpx rgba(20, 184, 166, 0.12);
}

.notification-dot.critical,
.notification-dot.high {
  background: #ef4444;
  box-shadow: 0 0 0 7rpx rgba(239, 68, 68, 0.12);
}

.notification-dot.normal {
  background: #f59e0b;
  box-shadow: 0 0 0 7rpx rgba(245, 158, 11, 0.13);
}

.notification-dot.low {
  background: #22c55e;
  box-shadow: 0 0 0 7rpx rgba(34, 197, 94, 0.12);
}

.notification-main {
  min-width: 0;
}

.notification-body {
  margin-top: 6rpx;
  color: #64748b;
  font-size: 22rpx;
  line-height: 1.35;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.notification-action {
  flex: 0 0 auto;
  padding: 7rpx 12rpx;
  border-radius: 999rpx;
  color: var(--c-primary-dark);
  background: var(--c-primary-soft);
  font-size: 21rpx;
  font-weight: 900;
}

/* Visual parity pass: restore stronger hierarchy for dispatch home. */
.dashboard-hero {
  min-height: 170rpx;
  padding: 32rpx;
  border-radius: 24rpx;
}

.dashboard-hero .hero-eyebrow {
  font-size: 22rpx;
  font-weight: 900;
}

.dashboard-hero .hero-title {
  margin-top: 10rpx;
  font-size: 42rpx;
  font-weight: 900;
  line-height: 1.08;
}

.dashboard-hero .hero-meta {
  margin-top: 12rpx;
  font-size: 25rpx;
  font-weight: 800;
}

.ops-card,
.panel {
  border-radius: 24rpx;
  border-color: #d5e0ee;
  box-shadow: 0 16rpx 36rpx rgba(15, 23, 42, 0.08);
}

.summary-main.ops-main {
  min-height: 230rpx;
  padding: 26rpx;
  border-radius: 24rpx;
}

.summary-label {
  font-size: 25rpx;
  font-weight: 900;
}

.summary-number {
  margin-top: 18rpx;
  font-size: 58rpx;
  font-weight: 900;
  line-height: 1;
}

.summary-note {
  margin-top: 18rpx;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1.35;
}

.summary-side {
  gap: 14rpx;
}

.summary-chip {
  min-height: 92rpx;
  padding: 18rpx;
  border-radius: 22rpx;
}

.summary-chip .summary-number,
.summary-side .summary-number {
  margin-top: 8rpx;
  font-size: 36rpx;
}

.panel-title {
  font-size: 30rpx;
  font-weight: 900;
  line-height: 1.2;
}

.muted {
  font-size: 23rpx;
  line-height: 1.45;
}

.pressure-row {
  padding: 18rpx 0;
}

.pressure-name {
  font-size: 27rpx;
  font-weight: 900;
}

.empty-state {
  min-height: 100rpx;
  font-size: 24rpx;
}
