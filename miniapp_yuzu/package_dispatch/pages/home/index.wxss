  min-width: 0;
  padding: 17rpx 20rpx;
  border-top: 1rpx solid #edf2f6;
}

.driver-home-task:active { background: #f2f8fb; }
.driver-home-task.active { border-left: 7rpx solid #14a195; }
.driver-home-task.completed { border-left: 7rpx solid #57ae78; }
.driver-home-task.exception { border-left: 7rpx solid #d84e4e; background: #fff7f7; }
.driver-home-task.adjusted,
.driver-home-task.added { border-left: 7rpx solid #d9962d; background: #fffaf0; }

.driver-home-task-time {
  color: #173d5a;
  font-size: 25rpx;
  font-weight: 900;
  text-align: center;
}

.driver-home-task-route {
  overflow: hidden;
  color: #18364f;
  font-size: 21rpx;
  font-weight: 800;
  line-height: 1.35;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.driver-home-task-meta {
  margin-top: 5rpx;
  overflow: hidden;
  color: #7b8d9d;
  font-size: 16rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.driver-home-task-alert {
  margin-top: 7rpx;
  color: #b4650b;
  font-size: 16rpx;
  font-weight: 800;
  line-height: 1.3;
}

.driver-home-task-status {
  max-width: 112rpx;
  padding: 7rpx 10rpx;
  border-radius: 999rpx;
  color: #216d9e;
  background: #edf7fd;
  font-size: 16rpx;
  font-weight: 800;
  text-align: center;
  white-space: nowrap;
}

.driver-home-task.active .driver-home-task-status { color: #fff; background: #128e82; }
.driver-home-task.completed .driver-home-task-status { color: #176c48; background: #e2f5e9; }
.driver-home-task.exception .driver-home-task-status { color: #a82c31; background: #ffe4e4; }

.driver-home-empty {
  display: flex;
  min-height: 210rpx;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 25rpx;
  border-top: 1rpx solid #edf2f6;
  text-align: center;
}

.driver-home-empty strong { color: #4a6173; font-size: 24rpx; }
.driver-home-empty text { margin-top: 9rpx; color: #8798a5; font-size: 18rpx; }

@media (max-width: 360px) {
  .driver-home-hero { padding: 21rpx; }
  .driver-home-name { font-size: 33rpx; }
  .driver-home-status { min-width: 142rpx; padding: 12rpx 10rpx; }
  .driver-home-shortcuts { gap: 7rpx; }
  .driver-home-shortcut { padding-left: 4rpx; padding-right: 4rpx; }
  .driver-home-shortcut strong { font-size: 17rpx; }
  .driver-home-shortcut text { font-size: 14rpx; }
  .driver-home-task { grid-template-columns: 70rpx minmax(0, 1fr) auto; gap: 9rpx; padding-left: 14rpx; padding-right: 14rpx; }
  .driver-home-task-status { max-width: 96rpx; font-size: 15rpx; }
}
