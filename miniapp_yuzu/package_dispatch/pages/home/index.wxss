.driver-shortcut strong,
.driver-shortcut text {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.driver-shortcut strong {
  color: #1c3c58;
  font-size: 20rpx;
}

.driver-shortcut text {
  margin-top: 5rpx;
  color: #7890a4;
  font-size: 16rpx;
}

.driver-task-entry {
  flex: none;
  padding: 8rpx 14rpx;
  border: 1rpx solid #9cc4e5;
  border-radius: 999rpx;
  color: #1763a6;
  font-size: 19rpx;
  font-weight: 700;
}

.driver-flow-grid {
  display: grid;
  gap: 12rpx;
  padding: 18rpx 22rpx 22rpx;
}

.driver-flow-card {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 15rpx;
  border-radius: 15rpx;
}

.driver-flow-card.pending {
  color: #205f96;
  background: #f2f8fd;
  border: 1rpx solid #b6d3eb;
}

.driver-flow-card.completed {
  color: #176a49;
  background: #eef9f3;
  border: 1rpx solid #a7d9c1;
}

.driver-flow-mark {
  width: 50rpx;
  height: 50rpx;
