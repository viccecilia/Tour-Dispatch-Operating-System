  padding: 20rpx 8rpx;
  background: #fff;
  text-align: center;
}

.driver-shortcut-icon {
  width: 52rpx;
  height: 52rpx;
  display: grid;
  place-items: center;
  margin: 0 auto 10rpx;
  border-radius: 16rpx;
  color: #fff;
  background: #2f7fc1;
  font-size: 23rpx;
  font-weight: 800;
