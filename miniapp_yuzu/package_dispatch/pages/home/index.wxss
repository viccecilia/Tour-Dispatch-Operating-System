}

.resource-risk.danger {
  color: #dc2626;
  background: #fef2f2;
}

.home-driver-health-edit {
  grid-column: 1 / -1;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
  margin-top: 4rpx;
  padding: 12rpx;
  border-radius: 14rpx;
  background: #ffffff;
