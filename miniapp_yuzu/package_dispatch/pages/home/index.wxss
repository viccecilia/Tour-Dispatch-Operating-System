}

.resource-driver-fact.health.danger .resource-driver-fact-label strong,
.resource-driver-fact.health.danger .resource-driver-fact-value {
  color: #dc2626;
}

.resource-mini-row .row-title {
  color: #0f172a;
  font-size: 24rpx;
