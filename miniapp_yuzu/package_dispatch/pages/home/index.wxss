@import "../../../app.wxss";

.driver-provisional-entry,
.provisional-admin-entry {
  display: flex;
  align-items: center;
  gap: 18rpx;
  border: 2rpx solid #b9d9d4;
  background: linear-gradient(135deg, #effcf9 0%, #ffffff 100%);
  box-shadow: 0 12rpx 30rpx rgba(15, 118, 110, 0.08);
}

.driver-provisional-entry {
  margin-top: 20rpx;
  padding: 24rpx;
  border-radius: 24rpx;
}

.driver-provisional-icon {
  width: 66rpx;
  height: 66rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  background: #0f766e;
  font-size: 30rpx;
  font-weight: 900;
}

.driver-provisional-copy {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.driver-provisional-copy strong { color: #134e4a; font-size: 28rpx; }
.driver-provisional-copy text { color: #52716e; font-size: 22rpx; line-height: 1.45; }

.driver-provisional-count,
.provisional-admin-count {
  min-width: 72rpx;
  color: #0f766e;
  text-align: center;
  font-size: 34rpx;
  font-weight: 900;
}

.driver-provisional-count text,
.provisional-admin-count text { display: block; font-size: 18rpx; font-weight: 700; }

.provisional-admin-entry { justify-content: space-between; }

.dashboard-hero {
  background: linear-gradient(135deg, #153b92 0%, #246bfe 100%);
  position: relative;
}

.dashboard-hero::after {
  pointer-events: none;
}

.hero-bell {
  position: absolute;
  top: 28rpx;
  right: 28rpx;
  z-index: 8;
  width: 54rpx;
  height: 54rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #2563eb;
  background: rgba(255, 255, 255, 0.92);
  border: 2rpx solid rgba(255, 255, 255, 0.88);
  box-shadow: 0 10rpx 26rpx rgba(15, 23, 42, 0.16), inset 0 1rpx 0 rgba(255, 255, 255, 0.9);
  transition: transform 0.12s ease, opacity 0.12s ease, background 0.12s ease;
}

.hero-bell-pressed {
  transform: scale(0.9);
  opacity: 0.82;
}

.hero-bell.active {
  color: #1d4ed8;
  background: rgba(255, 255, 255, 0.96);
  border-color: rgba(255, 255, 255, 0.95);
  box-shadow: 0 12rpx 28rpx rgba(37, 99, 235, 0.24), inset 0 1rpx 0 rgba(255, 255, 255, 0.95);
}

.hero-bell-symbol {
  position: relative;
  width: 30rpx;
  height: 32rpx;
}

.hero-bell-cap {
  position: absolute;
  left: 11rpx;
  top: 0;
  width: 8rpx;
  height: 7rpx;
  border-radius: 999rpx 999rpx 0 0;
  background: #2563eb;
  border: 2rpx solid rgba(255, 255, 255, 0.92);
  border-bottom: 0;
  box-sizing: border-box;
}

.hero-bell-dome {
  position: absolute;
  left: 4rpx;
  top: 5rpx;
  width: 22rpx;
  height: 21rpx;
  border-radius: 16rpx 16rpx 7rpx 7rpx;
  background: linear-gradient(145deg, #60a5fa 0%, #2563eb 72%, #1d4ed8 100%);
  border: 2rpx solid rgba(255, 255, 255, 0.95);
  box-shadow: 0 6rpx 12rpx rgba(37, 99, 235, 0.28), inset 0 2rpx 0 rgba(255, 255, 255, 0.36);
  box-sizing: border-box;
}

.hero-bell-base {
  position: absolute;
  left: 2rpx;
  top: 22rpx;
  width: 26rpx;
  height: 6rpx;
  border-radius: 999rpx;
  background: #1d4ed8;
  border: 2rpx solid rgba(255, 255, 255, 0.95);
  box-sizing: border-box;
}

.hero-bell-dot {
  position: absolute;
  left: 11rpx;
  bottom: 0;
  width: 8rpx;
  height: 8rpx;
  border-radius: 999rpx;
  background: #1d4ed8;
  border: 2rpx solid rgba(255, 255, 255, 0.95);
  box-sizing: border-box;
}

.hero-bell-count {
  position: absolute;
  top: -12rpx;
  right: -10rpx;
  min-width: 30rpx;
  height: 30rpx;
  padding: 0 8rpx;
  border-radius: 999rpx;
  line-height: 30rpx;
  text-align: center;
  color: #ffffff;
  background: #ef4444;
  font-size: 18rpx;
  font-weight: 950;
}

.dispatch-command-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 12rpx;
  margin-top: 18rpx;
}

.compact-switch-grid {
  align-items: stretch;
}

.command-span-2 {
  grid-column: span 2;
}

.command-orders,
.command-resources {
  grid-column: 1 / span 2;
  grid-row: span 2;
}

.command-idle {
  grid-column: 3 / span 2;
}

.command-small {
  min-height: 104rpx;
}

.command-card {
  min-height: 112rpx;
  box-sizing: border-box;
  border-radius: 12rpx;
  padding: 14rpx;
  background: #ffffff;
  border: 1rpx solid #dbe7f5;
  box-shadow: 0 14rpx 28rpx rgba(15, 23, 42, 0.07);
}

.command-card.wide {
  grid-column: 1 / -1;
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto auto;
  align-items: center;
  column-gap: 16rpx;
  min-height: 118rpx;
}

.idle-summary-lines {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 8rpx;
  margin-top: 10rpx;
}

.resource-command-lines {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 10rpx;
  margin-top: 18rpx;
}

.resource-command-lines view {
  min-width: 0;
}

.resource-command-lines text {
  display: block;
  color: #475569;
  font-size: 20rpx;
  font-weight: 850;
  line-height: 1.15;
}

.resource-command-lines text:first-child {
  color: #0f172a;
  font-size: 38rpx;
  font-weight: 950;
  line-height: 1;
}

.idle-summary-lines view {
  min-width: 0;
  padding: 0;
}

.idle-summary-lines text {
  display: block;
  text-align: center;
  color: #475569;
  font-size: 20rpx;
  font-weight: 850;
  line-height: 1.15;
}

.idle-summary-lines text:first-child {
  color: #0f172a;
  font-size: 30rpx;
  font-weight: 950;
}

.command-card.active .idle-summary-lines text:first-child {
  color: #ffffff;
}

.command-card.active .idle-summary-lines text {
  color: rgba(255, 255, 255, 0.88);
}

.command-card.active .resource-command-lines text:first-child {
  color: #ffffff;
}

.command-card.active .resource-command-lines text {
  color: rgba(255, 255, 255, 0.88);
}

.command-card.active {
  border: 2rpx solid #2563eb;
  background: linear-gradient(180deg, #2563eb 0%, #1d4ed8 100%);
  color: #ffffff;
  box-shadow:
    inset 0 1rpx 0 rgba(255, 255, 255, 0.22),
    0 12rpx 26rpx rgba(37, 99, 235, 0.22);
}

.command-card.info-card {
  border-color: #cbd5e1;
  background: linear-gradient(180deg, #f8fafc 0%, #ffffff 100%);
}

.command-orders.active,
.command-resources.active {
  border-color: #2563eb;
  background: linear-gradient(180deg, #2563eb 0%, #1d4ed8 100%);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.22), 0 12rpx 26rpx rgba(37, 99, 235, 0.22);
}

.command-idle.active {
  border-color: #2563eb;
  background: linear-gradient(180deg, #2563eb 0%, #1d4ed8 100%);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.22), 0 12rpx 26rpx rgba(37, 99, 235, 0.22);
}

.command-small.active {
  border-color: #2563eb;
  background: linear-gradient(180deg, #2563eb 0%, #1d4ed8 100%);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.22), 0 12rpx 26rpx rgba(37, 99, 235, 0.22);
}

.command-label {
  color: #475569;
  font-size: 22rpx;
  font-weight: 900;
  line-height: 1.25;
}

.command-card.active .command-label,
.command-card.active .command-number {
  color: #ffffff;
}

.command-card.active .command-note {
  color: rgba(255, 255, 255, 0.92);
}

.command-number {
  margin-top: 8rpx;
  color: #0f172a;
  font-size: 38rpx;
  font-weight: 950;
  line-height: 1;
}

.command-number.compact-ratio {
  font-size: 30rpx;
  line-height: 1.08;
  white-space: nowrap;
}

.command-note {
  margin-top: 7rpx;
  color: #64748b;
  font-size: 20rpx;
  font-weight: 800;
  line-height: 1.3;
}

.idle-line {
  min-width: 108rpx;
  border-radius: 20rpx;
  padding: 12rpx 14rpx;
  background: #ecfdf5;
  border: 1rpx solid #bbf7d0;
  text-align: center;
}

.idle-line text {
  display: block;
  color: #0f766e;
  font-size: 32rpx;
  font-weight: 950;
  line-height: 1;
}

.idle-line view {
  margin-top: 6rpx;
  color: #64748b;
  font-size: 20rpx;
  font-weight: 850;
}

.idle-type-row {
  grid-column: 1 / -1;
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 12rpx;
}

.idle-type-row text {
  border-radius: 999rpx;
  padding: 7rpx 12rpx;
  color: #0f766e;
  background: #ecfeff;
  border: 1rpx solid #99f6e4;
  font-size: 20rpx;
  font-weight: 900;
}

.driver-theme .dashboard-hero,
.driver-theme .summary-main {
  background: linear-gradient(135deg, #0f766e 0%, #14b8a6 100%);
  box-shadow: 0 18rpx 42rpx rgba(20, 184, 166, 0.22);
}

.login-panel {
  gap: 30rpx;
  padding: 36rpx;
}

.login-help {
  margin-top: 8rpx;
  color: var(--c-muted);
  font-size: 24rpx;
  line-height: 1.45;
}

.login-input {
  display: block;
  height: 132rpx;
  min-height: 132rpx;
  line-height: 132rpx;
  box-sizing: border-box;
  padding: 0 36rpx;
  border: 2rpx solid #dbe7f5;
  border-radius: 32rpx;
  background: #ffffff;
  font-size: 38rpx;
  font-weight: 900;
  box-shadow: 0 8rpx 22rpx rgba(15, 23, 42, 0.04);
}

.login-placeholder {
  color: #9aa8ba;
  font-size: 34rpx;
  font-weight: 750;
}

.login-panel .button-primary {
  width: 100%;
  height: 120rpx;
  line-height: 120rpx;
  border-radius: 32rpx;
  font-size: 36rpx;
}

.ops-summary {
  display: grid;
  grid-template-columns: 1.18fr 0.82fr;
  gap: 16rpx;
  margin-top: 20rpx;
}

.summary-main {
  min-height: 244rpx;
  box-sizing: border-box;
  border-radius: 34rpx;
  padding: 28rpx;
  color: #ffffff;
  background: linear-gradient(145deg, #246bfe 0%, #1748c7 100%);
  box-shadow: 0 18rpx 42rpx rgba(36, 107, 254, 0.22);
}

.summary-main.ops-main {
  background: linear-gradient(135deg, #0f766e 0%, #0ea5a0 52%, #2563eb 100%);
  box-shadow: 0 18rpx 42rpx rgba(15, 118, 110, 0.2);
}

.summary-main.ops-main.warning {
  background: linear-gradient(135deg, #0f766e 0%, #0ea5a0 45%, #f59e0b 100%);
  box-shadow: 0 18rpx 42rpx rgba(245, 158, 11, 0.18);
}

.summary-label,
.summary-note {
  color: rgba(255, 255, 255, 0.82);
  font-size: 24rpx;
  font-weight: 850;
}

.summary-number {
  margin: 14rpx 0;
  font-size: 76rpx;
  font-weight: 950;
  line-height: 1;
}

.summary-number.status-text {
  font-size: 56rpx;
  line-height: 1.08;
}

.summary-side {
  display: grid;
  gap: 16rpx;
}

.driver-summary-side {
  grid-template-columns: 1fr 1fr;
}

.driver-summary-side .summary-wide {
  grid-column: 1 / -1;
}

.summary-chip,
.status-card {
  border-radius: 28rpx;
  padding: 22rpx;
  background: #ffffff;
  border: 1rpx solid var(--c-border);
  box-shadow: var(--shadow-card);
}

.summary-chip.active,
.status-card.active {
  border-color: #2563eb;
  box-shadow: 0 12rpx 26rpx rgba(37, 99, 235, 0.14);
}

.driver-theme .summary-chip.active,
.driver-theme .status-card.active {
  border-color: #14b8a6;
  box-shadow: 0 12rpx 26rpx rgba(20, 184, 166, 0.14);
}

.summary-chip.danger {
  border-color: #fecaca;
  background: #fff1f2;
}

.summary-chip.danger text,
.summary-chip.danger .metric-strong {
  color: #dc2626;
}

.driver-theme .summary-chip.danger.active {
  border-color: #ef4444;
  box-shadow: 0 12rpx 26rpx rgba(239, 68, 68, 0.14);
}

.summary-chip text,
.status-card text {
  display: block;
  color: var(--c-muted);
  font-size: 22rpx;
  font-weight: 800;
}

.summary-chip .metric-strong,
.status-card .metric-strong {
  display: block;
  margin-top: 8rpx;
  color: var(--c-text);
  font-size: 38rpx;
  font-weight: 950;
}

.ops-alert-panel {
  margin-top: 16rpx;
}

.ops-alert-summary {
  display: grid;
  grid-template-columns: repeat(5, minmax(0, 1fr));
  gap: 8rpx;
  margin-top: 14rpx;
  padding: 12rpx;
  border-radius: 20rpx;
  background: #f8fafc;
  border: 1rpx solid #e2e8f0;
}

.ops-alert-summary view {
  min-width: 0;
  text-align: center;
}

.ops-alert-filter {
  min-height: 76rpx;
  box-sizing: border-box;
  padding: 10rpx 4rpx;
  border: 2rpx solid transparent;
  border-radius: 14rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.ops-alert-filter.active {
  border-color: #0f766e;
  background: #ffffff;
  box-shadow: 0 8rpx 18rpx rgba(15, 118, 110, 0.14);
}

.ops-alert-filter-hover {
  background: #eefbf8;
}

.ops-alert-summary text {
  display: block;
  line-height: 1.1;
}

.ops-alert-summary text:first-child {
  color: #0f172a;
  font-size: 30rpx;
  font-weight: 950;
}

.ops-alert-summary text:last-child {
  margin-top: 6rpx;
  color: #64748b;
  font-size: 18rpx;
  font-weight: 850;
}

.ops-alert-filter.active text:first-child,
.ops-alert-filter.active text:last-child {
  color: #0f766e;
}

.soft-count.filter-active {
  color: #0f766e;
  background: #ecfdf5;
  border: 1rpx solid #99f6e4;
}

.ops-alert-scroll {
  height: 420rpx;
  margin-top: 14rpx;
  padding-right: 4rpx;
  box-sizing: border-box;
}

.ops-alert-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 16rpx 4rpx;
  border-bottom: 1rpx solid #e5edf5;
}

.ops-alert-row:last-child {
  border-bottom: 0;
}

.ops-alert-main {
  min-width: 0;
}

.ops-alert-status {
  flex: 0 0 auto;
  color: #0f766e;
  font-size: 21rpx;
  font-weight: 950;
}

.ops-alert-row.warning .ops-alert-status {
  color: #d97706;
}

.ops-alert-row.danger .ops-alert-status {
  color: #dc2626;
}

.status-strip {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12rpx;
  margin-top: 16rpx;
}

.ops-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
  margin-top: 16rpx;
}

.ops-grid-compact {
  grid-template-columns: 1fr 1fr;
  gap: 12rpx;
}

.ops-card {
  min-height: 132rpx;
  box-sizing: border-box;
  border-radius: 28rpx;
  padding: 18rpx;
  background: #ffffff;
  border: 1rpx solid var(--c-border);
  box-shadow: var(--shadow-card);
}

.ops-card-wide {
  grid-column: 1 / -1;
  min-height: 118rpx;
}

.ops-card.active {
  border-color: #0f766e;
  background: linear-gradient(180deg, #ecfdf5 0%, #ffffff 100%);
  box-shadow: 0 14rpx 30rpx rgba(15, 118, 110, 0.16);
}

.ops-card text {
  display: block;
  color: var(--c-muted);
  font-size: 22rpx;
  font-weight: 850;
}

.ops-card .metric-strong {
  display: block;
  margin-top: 8rpx;
  color: #0f766e;
  font-size: 42rpx;
  font-weight: 950;
  line-height: 1;
}

.ops-card view {
  margin-top: 10rpx;
  color: #64748b;
  font-size: 21rpx;
  font-weight: 750;
  line-height: 1.35;
}

.ops-detail-grid {
  margin-top: 18rpx;
}

.ops-detail-panel {
  margin-bottom: 18rpx;
}

.ops-detail-panel.single {
  margin-top: 18rpx;
}

.ops-detail-list {
  margin-top: 14rpx;
}

.ops-detail-row {
  padding: 18rpx 0;
  border-bottom: 1rpx solid #edf2f7;
}

.ops-detail-row:last-child {
  border-bottom: 0;
}

.ops-detail-main {
  display: grid;
  gap: 6rpx;
}

.ops-field-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 10rpx;
  margin-top: 14rpx;
}

.ops-field {
  min-width: 0;
  box-sizing: border-box;
  border-radius: 18rpx;
  padding: 12rpx;
  background: #f8fafc;
  border: 1rpx solid #e2e8f0;
}

.ops-field text {
  display: block;
  color: #64748b;
  font-size: 20rpx;
  font-weight: 800;
}

.ops-field .metric-strong {
  display: block;
  margin-top: 4rpx;
  color: #0f172a;
  font-size: 22rpx;
  font-weight: 900;
  line-height: 1.35;
  word-break: break-all;
}

.compact-list {
  margin-top: 14rpx;
}

.compact-row {
  display: grid;
  grid-template-columns: minmax(0, 1fr);
  gap: 8rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #edf2f7;
}

.compact-row:last-child {
  border-bottom: 0;
}

.compact-body {
  color: #475569;
  font-size: 22rpx;
  font-weight: 750;
  line-height: 1.4;
  word-break: break-all;
}

.ops-home-detail {
  min-height: 360rpx;
}

.dispatch-task-list {
  margin-top: 14rpx;
  display: grid;
  gap: 12rpx;
}

.dispatch-task-card {
  border-radius: 22rpx;
  border: 1rpx solid #dbe7f5;
  background: linear-gradient(180deg, #f8fbff 0%, #ffffff 100%);
  padding: 18rpx;
}

.dispatch-task-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.dispatch-task-time {
  min-width: 0;
  color: #0f172a;
  font-size: 27rpx;
  font-weight: 950;
  line-height: 1.32;
  word-break: break-all;
}

.dispatch-task-status {
  flex: 0 0 auto;
  border-radius: 999rpx;
  padding: 6rpx 14rpx;
  background: #e0f2fe;
  color: #0369a1;
  font-size: 20rpx;
  font-weight: 900;
}

.dispatch-task-route {
  margin-top: 8rpx;
  color: #0f172a;
  font-size: 25rpx;
  font-weight: 900;
  line-height: 1.45;
  word-break: break-all;
}

.dispatch-task-sub {
  margin-top: 8rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
  color: #64748b;
  font-size: 20rpx;
  font-weight: 750;
  line-height: 1.35;
}

.dispatch-task-order {
  flex: 0 1 auto;
  max-width: 58%;
  padding: 3rpx 10rpx;
  border-radius: 999rpx;
  background: #eef6ff;
  color: #64748b;
  font-size: 19rpx;
  font-weight: 800;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.dispatch-task-info,
.dispatch-task-note {
  margin-top: 8rpx;
  color: #475569;
  font-size: 22rpx;
  font-weight: 750;
  line-height: 1.45;
  word-break: break-all;
}

.dispatch-resource-grid {
  margin-top: 14rpx;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12rpx;
}

.dispatch-resource-panel {
  border-radius: 20rpx;
  border: 1rpx solid #e2e8f0;
  background: #f8fafc;
  padding: 16rpx;
}

.dispatch-resource-title {
  color: #0f172a;
  font-size: 24rpx;
  font-weight: 950;
}

.dispatch-resource-row {
  padding: 12rpx 0;
  border-bottom: 1rpx solid #e2e8f0;
}

.dispatch-resource-row:last-child {
  border-bottom: 0;
}

.idle-panel-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12rpx;
}

.home-resource-overview {
  display: grid;
  gap: 14rpx;
}

.home-resource-stats {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12rpx;
}

