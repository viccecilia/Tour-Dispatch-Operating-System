/* Driver Phase 1: today's workbench shell. All workflow writes remain on the
 * existing task page; these rules only reorganize the home projection. */
.driver-today-shell {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  padding-bottom: 148rpx;
}

.driver-today-head,
.driver-today-section,
.driver-today-metrics,
.driver-today-shortcuts {
  background: #fff;
  border: 1rpx solid #dbe7f2;
  border-radius: 22rpx;
  box-shadow: 0 8rpx 22rpx rgba(17, 48, 79, 0.06);
}

.driver-today-head {
  display: flex;
  align-items: stretch;
  justify-content: space-between;
  gap: 18rpx;
  padding: 24rpx;
}

.driver-today-date {
  color: #194d78;
  font-size: 32rpx;
  font-weight: 800;
}

.driver-today-identity {
  margin-top: 8rpx;
  color: #132f4c;
  font-size: 25rpx;
  font-weight: 700;
}

.driver-today-identity text,
.driver-today-vehicle {
  color: #698095;
  font-size: 21rpx;
  font-weight: 500;
}

.driver-today-vehicle {
  margin-top: 5rpx;
}

.driver-today-state {
  min-width: 190rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  border-radius: 18rpx;
  padding: 16rpx 18rpx;
  text-align: center;
}

.driver-today-state view {
  font-size: 24rpx;
  font-weight: 800;
}

.driver-today-state text {
  margin-top: 6rpx;
  font-size: 19rpx;
}

.driver-today-state.pending {
  color: #1763a6;
  background: #edf6ff;
  border: 1rpx solid #9cc8ed;
}

.driver-today-state.active {
  color: #fff;
  background: #118b83;
}

.driver-today-state.completed {
  color: #13744d;
  background: #e6f8ef;
  border: 1rpx solid #90d9b8;
}

.driver-today-state.exception {
  color: #b3292f;
  background: #fff0f0;
  border: 1rpx solid #efaaaa;
}

.driver-today-state.idle {
  color: #52687b;
  background: #f2f5f8;
}

.driver-today-metrics {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  overflow: hidden;
}

.driver-today-metrics view {
  min-width: 0;
  padding: 18rpx 8rpx;
  border-right: 1rpx solid #e4edf5;
  text-align: center;
}

.driver-today-metrics view:last-child {
  border-right: 0;
}

.driver-today-metrics strong,
.driver-today-metrics text {
  display: block;
}

.driver-today-metrics strong {
  color: #143d63;
  font-size: 32rpx;
}

.driver-today-metrics text {
  margin-top: 4rpx;
  color: #6b8093;
  font-size: 18rpx;
}

.driver-today-metrics .attention {
  background: #fff8e9;
}

.driver-today-metrics .attention strong,
.driver-today-metrics .attention text {
  color: #a96308;
}

.driver-today-section {
  overflow: hidden;
}

.driver-today-section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  padding: 20rpx 22rpx;
  border-bottom: 1rpx solid #e6edf4;
}

.driver-today-section-head strong,
.driver-today-section-head text {
  display: block;
}

.driver-today-section-head strong {
  color: #173b5c;
  font-size: 26rpx;
}

.driver-today-section-head text {
  margin-top: 4rpx;
  color: #75889a;
  font-size: 19rpx;
}

.driver-section-count {
  min-width: 44rpx;
  height: 44rpx;
  display: grid;
  place-items: center;
  border-radius: 999rpx;
  color: #9b5c00;
  background: #ffedbf;
  font-weight: 800;
}

.driver-change-row {
  display: grid;
  grid-template-columns: auto minmax(0, 1fr) auto;
  align-items: center;
  gap: 14rpx;
  padding: 18rpx 22rpx;
  border-bottom: 1rpx solid #edf2f6;
}

.driver-change-row:last-child {
  border-bottom: 0;
}

.driver-change-tag {
  padding: 5rpx 10rpx;
  border-radius: 8rpx;
  color: #9b5c00;
  background: #ffedbf;
  font-size: 18rpx;
  font-weight: 800;
}

.driver-change-row.canceled .driver-change-tag {
  color: #66727d;
  background: #edf0f3;
  text-decoration: line-through;
}

.driver-change-row.exception .driver-change-tag {
  color: #b3212c;
  background: #ffe4e5;
}

.driver-change-main strong,
.driver-change-main text {
  display: block;
}

.driver-change-main strong {
  overflow: hidden;
  color: #203d57;
  font-size: 22rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.driver-change-main text,
.driver-row-arrow {
  color: #788b9d;
  font-size: 18rpx;
}

.driver-change-detail {
  grid-column: 1 / -1;
  padding: 16rpx;
  border-radius: 14rpx;
  color: #3b5268;
  background: #f7fafc;
  font-size: 20rpx;
  line-height: 1.6;
}

.driver-change-detail text {
  display: block;
  margin-top: 10rpx;
  color: #8a6c32;
  font-size: 17rpx;
}

.driver-receipt-button,
.driver-order-open {
  margin: 14rpx 0 0;
  border: 0;
  border-radius: 12rpx;
  color: #fff;
  background: #118b83;
  font-size: 21rpx;
  font-weight: 700;
  line-height: 68rpx;
}

.driver-today-shortcuts {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 1rpx;
  overflow: hidden;
}

.driver-shortcut {
