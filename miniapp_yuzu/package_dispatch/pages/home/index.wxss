}

.resource-mini-row .muted {
  color: #64748b;
  font-size: 19rpx;
  line-height: 1.25;
}

.resource-risk {
  justify-self: end;
  display: inline-flex;
  align-items: center;
  min-height: 28rpx;
  padding: 2rpx 9rpx;
  border-radius: 999rpx;
