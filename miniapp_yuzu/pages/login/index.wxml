<view class="page login-page">
  <view class="hero login-hero">
    <view class="eyebrow">YOZI DISPATCH</view>
    <view class="title-row">
      <view class="title">柚子调度</view>
      <view class="help-icon" bindtap="toggleHelp">?</view>
    </view>
    <view wx:if="{{showHelp}}" class="help-popover">
      这里用于旅行社、车公司、司机和导游登录。平台总后台账号 admin / admin123 请在 Web 总后台登录。
    </view>
  </view>

  <view class="panel login-panel">
    <view class="port-switch">
      <view class="port-pill {{port === 'agency' ? 'active agency-active' : ''}}" data-port="agency" bindtap="switchPort">旅行社</view>
      <view class="port-pill {{port === 'dispatch' ? 'active dispatch-active' : ''}}" data-port="dispatch" bindtap="switchPort">车公司</view>
    </view>

    <view class="field">
      <text class="label">{{meta.accountLabel}}</text>
      <input class="input" value="{{loginCode}}" placeholder="{{meta.placeholder}}" bindinput="onLoginCodeInput" />
    </view>
    <view class="field">
      <text class="label">密码</text>
      <input class="input" password value="{{password}}" placeholder="请输入密码" bindinput="onPasswordInput" />
    </view>

    <button class="button button-green login-button" loading="{{loading}}" disabled="{{loading}}" bindtap="submit">
      {{loading ? '登录中...' : meta.button}}
    </button>
    <view wx:if="{{message}}" class="status error">{{message}}</view>
  </view>
</view>
