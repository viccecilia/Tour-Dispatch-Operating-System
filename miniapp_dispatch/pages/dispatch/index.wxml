<view class="page dispatch-page">
  <view class="hero quick-hero">
    <view class="preview-copy">
      <view class="hero-eyebrow">DISPATCH WORKBENCH</view>
      <view class="title-with-help">
        <view class="hero-title">蟇ｼ蜈･荳取ｴｾ霓ｦ</view>
        <view class="help-dot hero-help" data-type="hero" bindtap="showHelp">?</view>
      </view>
    </view>
    <view class="hero-count">
      <text>蟾ｲ騾・/text>
      <strong>{{selectedKeys.length}}</strong>
    </view>
  </view>

  <view class="toolbar">
    <button class="tool-button primary {{importOpen && importMode === 'batch' ? 'active' : ''}}" data-mode="batch" bindtap="openImport">{{importOpen && importMode === 'batch' ? 'Hide Batch' : 'Batch Import'}}</button>
    <button class="tool-button secondary {{importOpen && importMode === 'single' ? 'active' : ''}}" data-mode="single" bindtap="openImport">{{importOpen && importMode === 'single' ? 'Hide Single' : 'Single Entry'}}</button>
    <button wx:if="{{canAuction}}" class="tool-button auction-top {{selectedKeys.length ? 'ready' : ''}}" loading="{{loading}}" disabled="{{!selectedKeys.length || loading}}" bindtap="publishSelectedToAuction">Hall</button>
  </view>

  <view wx:if="{{importOpen}}" class="panel import-panel">
    <view class="title-with-help">
      <view class="panel-title">{{importMode === 'single' ? 'Single Order Input' : 'WeChat / LINE Text'}}</view>
      <view class="help-dot" data-type="import" bindtap="showHelp">?</view>
    </view>
    <textarea class="textarea" value="{{importText}}" bindinput="onImportText" placeholder="{{importMode === 'single' ? 'Paste one complete order here. It will open in the editable queue below.' : 'Paste batch order text here. You can import 50-80 lines at once.'}}" />
    <button class="button-primary" loading="{{loading}}" bindtap="submitImport">{{importMode === 'single' ? 'Parse One' : 'Parse & Classify'}}</button>
  </view>

  <view wx:if="{{conflictText}}" class="conflict">{{conflictText}}</view>
  <view wx:elif="{{message}}" class="success-text">{{message}}</view>

  <view class="panel charter-panel">
    <view class="section-head" bindtap="toggleCharter">
      <view>
        <view class="title-with-help">
          <view class="panel-title">蛹・ｽｦ</view>
          <view class="help-dot" data-type="charter" bindtap="showHelp">?</view>
        </view>
      </view>
      <view class="count-pill">{{charterRows.length}} 蜊・ﾂｷ {{charterCollapsed ? '螻募ｼ' : '謾ｶ襍ｷ'}}</view>
    </view>
    <scroll-view wx:if="{{!charterCollapsed}}" scroll-y class="charter-scroll">
      <view wx:for="{{charterRows}}" wx:key="key" class="row-shell">
        <view class="compact-row charter-row {{item.selected ? 'selected' : ''}}" data-key="{{item.key}}" bindtap="handleRowTap">
          <view class="status-dot {{item.kind === 'draft' ? 'warn' : 'ok'}}"></view>
          <view class="compact-main">
            <view class="compact-top">
              <text class="type-chip">{{item.sourceText}}</text>
              <text class="compact-no">{{item.oid}}</text>
              <text class="compact-price">{{item.priceText}}</text>
            </view>
            <view class="compact-line">{{item.timeText}} ﾂｷ {{item.routeText}}</view>
            <view class="compact-meta">{{item.vehicle_type || '霓ｦ蝙句ｾ・｡ｮ隶､'}} ﾂｷ {{item.charterDetailText}}</view>
          </view>
        </view>
        <view wx:if="{{editingKey === item.key}}" class="inline-edit" catchtap="noop">
          <input class="input" data-field="order_date" value="{{editing.order_date}}" bindinput="onEditField" placeholder="譌･譛・ />
          <input class="input" data-field="start_time" value="{{editing.start_time}}" bindinput="onEditField" placeholder="蠑蟋・ />
          <input class="input" data-field="end_time" value="{{editing.end_time}}" bindinput="onEditField" placeholder="扈捺據" />
          <input class="input" data-field="pickup_location" value="{{editing.pickup_location}}" bindinput="onEditField" placeholder="襍ｷ轤ｹ" />
          <input class="input" data-field="dropoff_location" value="{{editing.dropoff_location}}" bindinput="onEditField" placeholder="扈育せ" />
          <input class="input" data-field="vehicle_type" value="{{editing.vehicle_type}}" bindinput="onEditField" placeholder="霓ｦ蝙・ />
          <input class="input" data-field="guest_name" value="{{editing.guest_name}}" bindinput="onEditField" placeholder="螳｢莠ｺ" />
          <input class="input" data-field="guest_contact" value="{{editing.guest_contact}}" bindinput="onEditField" placeholder="閨皮ｳｻ譁ｹ蠑・ />
          <input class="input" data-field="price" value="{{editing.price}}" type="number" bindinput="onEditField" placeholder="莉ｷ譬ｼ" />
          <input class="input" data-field="agency_name" value="{{editing.agency_name}}" bindinput="onEditField" placeholder="譌・｡檎､ｾ" />
          <input class="input full" data-field="remark" value="{{editing.remark}}" bindinput="onEditField" placeholder="螟・ｳｨ / 陦檎ｨ狗せ" />
          <view class="edit-actions">
            <button class="small-button" bindtap="cancelEdit">蜿匁ｶ・/button>
            <button class="small-button primary" bindtap="saveEdit">菫晏ｭ・/button>
          </view>
        </view>
      </view>
      <view wx:if="{{!charterRows.length}}" class="empty-line">證よ裏蛹・ｽｦ隶｢蜊・/view>
    </scroll-view>
  </view>

  <view class="airport-grid">
    <view class="panel list-panel">
      <view class="section-head small">
        <view class="title-with-help">
          <view class="panel-title">謗･譛ｺ</view>
          <view class="help-dot" data-type="pickup" bindtap="showHelp">?</view>
        </view>
        <view class="count-pill">{{pickupRows.length}}</view>
      </view>
      <scroll-view scroll-y class="airport-scroll">
        <view wx:for="{{pickupRows}}" wx:key="key" class="row-shell">
          <view class="compact-row airport-row {{item.selected ? 'selected' : ''}}" data-key="{{item.key}}" bindtap="handleRowTap">
            <view class="status-dot {{item.kind === 'draft' ? 'warn' : 'ok'}}"></view>
            <view class="compact-main">
              <view class="compact-top">
                <text class="compact-no">{{item.oid}}</text>
              </view>
              <view class="compact-line">{{item.compactTimeText}}</view>
              <view class="compact-meta">{{item.routeText}}</view>
            </view>
          </view>
          <view wx:if="{{editingKey === item.key}}" class="inline-edit compact-edit" catchtap="noop">
            <input class="input" data-field="order_date" value="{{editing.order_date}}" bindinput="onEditField" placeholder="譌･譛・ />
            <input class="input" data-field="start_time" value="{{editing.start_time}}" bindinput="onEditField" placeholder="譌ｶ髣ｴ" />
            <input class="input" data-field="pickup_location" value="{{editing.pickup_location}}" bindinput="onEditField" placeholder="襍ｷ轤ｹ" />
            <input class="input" data-field="dropoff_location" value="{{editing.dropoff_location}}" bindinput="onEditField" placeholder="扈育せ" />
            <input class="input" data-field="vehicle_type" value="{{editing.vehicle_type}}" bindinput="onEditField" placeholder="霓ｦ蝙・ />
            <input class="input" data-field="price" value="{{editing.price}}" type="number" bindinput="onEditField" placeholder="莉ｷ譬ｼ" />
            <view class="edit-actions">
              <button class="small-button" bindtap="cancelEdit">蜿匁ｶ・/button>
              <button class="small-button primary" bindtap="saveEdit">菫晏ｭ・/button>
            </view>
          </view>
        </view>
        <view wx:if="{{!pickupRows.length}}" class="empty-line">證よ裏謗･譛ｺ</view>
      </scroll-view>
    </view>

    <view class="panel list-panel">
      <view class="section-head small">
        <view class="title-with-help">
          <view class="panel-title">騾∵惻</view>
          <view class="help-dot" data-type="dropoff" bindtap="showHelp">?</view>
        </view>
        <view class="count-pill">{{dropoffRows.length}}</view>
      </view>
      <scroll-view scroll-y class="airport-scroll">
        <view wx:for="{{dropoffRows}}" wx:key="key" class="row-shell">
          <view class="compact-row airport-row {{item.selected ? 'selected' : ''}}" data-key="{{item.key}}" bindtap="handleRowTap">
            <view class="status-dot {{item.kind === 'draft' ? 'warn' : 'ok'}}"></view>
            <view class="compact-main">
              <view class="compact-top">
                <text class="compact-no">{{item.oid}}</text>
              </view>
              <view class="compact-line">{{item.compactTimeText}}</view>
              <view class="compact-meta">{{item.routeText}}</view>
            </view>
          </view>
          <view wx:if="{{editingKey === item.key}}" class="inline-edit compact-edit" catchtap="noop">
            <input class="input" data-field="order_date" value="{{editing.order_date}}" bindinput="onEditField" placeholder="譌･譛・ />
            <input class="input" data-field="start_time" value="{{editing.start_time}}" bindinput="onEditField" placeholder="譌ｶ髣ｴ" />
            <input class="input" data-field="pickup_location" value="{{editing.pickup_location}}" bindinput="onEditField" placeholder="襍ｷ轤ｹ" />
            <input class="input" data-field="dropoff_location" value="{{editing.dropoff_location}}" bindinput="onEditField" placeholder="扈育せ" />
            <input class="input" data-field="vehicle_type" value="{{editing.vehicle_type}}" bindinput="onEditField" placeholder="霓ｦ蝙・ />
            <input class="input" data-field="price" value="{{editing.price}}" type="number" bindinput="onEditField" placeholder="莉ｷ譬ｼ" />
            <view class="edit-actions">
              <button class="small-button" bindtap="cancelEdit">蜿匁ｶ・/button>
              <button class="small-button primary" bindtap="saveEdit">菫晏ｭ・/button>
            </view>
          </view>
        </view>
        <view wx:if="{{!dropoffRows.length}}" class="empty-line">證よ裏騾∵惻</view>
      </scroll-view>
    </view>
  </view>

  <view class="resource-grid">
    <view class="panel resource-box">
      <view class="section-head small">
        <view class="title-with-help">
          <view class="panel-title">蜿ｸ譛ｺ</view>
          <view class="help-dot" data-type="drivers" bindtap="showHelp">?</view>
        </view>
      </view>
      <scroll-view scroll-y class="resource-scroll">
        <view wx:for="{{drivers}}" wx:key="id" data-id="{{item.id}}" bindtap="selectDriver" class="resource-row driver-row {{item.selected ? 'selected' : ''}} {{item.disabled ? 'disabled' : ''}}">
          <view class="status-dot {{item.statusClass}}"></view>
          <text class="resource-name">{{item.displayName || item.name}}</text>
        </view>
      </scroll-view>
    </view>

    <view class="panel resource-box">
      <view class="section-head small">
        <view class="title-with-help">
          <view class="panel-title">霓ｦ霎・/view>
          <view class="help-dot" data-type="vehicles" bindtap="showHelp">?</view>
        </view>
      </view>
      <scroll-view scroll-y class="resource-scroll">
        <view wx:for="{{vehicles}}" wx:key="id" data-id="{{item.id}}" bindtap="selectVehicle" class="resource-row {{item.selected ? 'selected' : ''}} {{item.disabled ? 'disabled' : ''}}">
          <view class="status-dot {{item.statusClass}}"></view>
          <text class="resource-name">{{item.shortPlate || item.plate_number}}</text>
          <text class="resource-sub">{{item.vehicle_type || '-'}}/{{item.seat_count || '-'}}蠎ｧ</text>
        </view>
      </scroll-view>
    </view>
  </view>

  <view wx:if="{{selectedKeys.length > 0}}" class="dispatch-preview">
    <view>
      <view class="preview-title">{{preview.orderCount}} 蜊・竊・{{preview.driverName}} 竊・{{preview.vehicleName}}</view>
      <view class="preview-sub">{{canAssign ? '蜿ｸ譛ｺ蜥瑚ｽｦ霎・ｷｲ騾会ｼ悟庄莉･豢ｾ蜊輔・ : '隸ｷ蝨ｨ荳区婿騾画叫蜿ｸ譛ｺ蜥瑚ｽｦ霎・・}}</view>
    </view>
    <view class="preview-actions">
      <button class="dispatch-button {{canAssign ? 'ready' : 'disabled'}}" loading="{{loading}}" disabled="{{!canAssign || loading}}" bindtap="assignSelected">豢ｾ蜊・/button>
    </view>
  </view>

  <view wx:if="{{helpTip}}" class="help-mask" catchtap="hideHelp">
    <view class="help-popover" catchtap="noop">
      <view class="help-popover-head">
        <view class="help-popover-title">{{helpTip.title}}</view>
        <view class="help-close" bindtap="hideHelp">ﾃ・/view>
      </view>
      <view class="help-popover-body">{{helpTip.content}}</view>
    </view>
  </view>
</view>
